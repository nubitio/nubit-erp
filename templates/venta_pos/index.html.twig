<div class="wrapper">
    <table id="venta_dg"></table>
    <!-- Dialogo -->
    <div id="venta_dlg">
        <div class="easyui-layout" data-options="fit:true">
            <form class="fm" id="venta_fm" method="post" novalidate>
                <div data-options="region: 'north', border: false" style="height:180px; padding:10px 30px">
                    <input type="hidden" id="sid" name="sid" value="{{ session_id }}"/>
                    <input type="hidden" name="operacion_id" id="venta_operacion">
                    <input type="hidden" id="venta_orden_id" name="orden_id">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="fitem">
                                <input id="venta_cliente" name="cliente_id">
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="fitem">
                                <input id="venta_pago" name="tipo_pago">
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="fitem">
                                <input id="venta_glosa" name="glosa">
                            </div>
                        </div>
                    </div>
                </div>
                <div data-options="region: 'center', border: false" style="padding:0 30px">
                    <table class="table table-sm table-bordered header-fixed">
                        <thead class="thead-dark">
                        <tr>
                            <th colspan="3" style="width: 45%">Producto</th>
                            <th style="width: 10%">Cant.</th>
                            <th style="width: 15%">Unitario</th>
                            <th style="width: 10%">Desc.</th>
                            <th style="width: 15%">Total</th>
                            <th style="width: 5%">
                                <a>
                                    <i class="fas fa-plus text-success" style="padding: 3px; cursor: pointer"
                                       onclick="app.venta.add_detalle()"></i>
                                </a>
                            </th>
                        </tr>
                        </thead>
                        <tbody id="venta_tb_detalle" style="height: 110px"></tbody>
                        <tfoot>
                        <tr class="table-secondary">
                            <td class="text-right" style="width: 10%"><b>Cash</b></td>
                            <td class="text-center" style="width: 15%"><input id="venta_cash"></td>
                            <td class="text-right" style="width: 10%"><b>Vuelto</b></td>
                            <td class="text-center" style="width: 15%"><span id="venta_vuelto"></span></td>
                            <td class="text-center" style="width: 10%"><b>Desc.(%)</b></td>
                            <td class="text-center" style="width: 15%"><input id="venta_descuento" name="descuento">
                            </td>
                            <td class="text-right" style="width: 10%"><b>Total</b></td>
                            <td class="text-center" style="width: 15%">S/ <span id="venta_total">0.00</span></td>
                        </tr>
                        </tfoot>
                    </table>
                </div>
            </form>
        </div>
    </div>
    <!-- Cliente -->
    <div id="venta_cliente_dlg">
        <form class="fm" id="venta_cliente_fm" method="post" novalidate>
            <div class="fitem">
                <input id="ven_cliente_ruc" name="ruc">
            </div>
            <div class="fitem">
                <input id="ven_cliente_razon_social" name="razon_social">
            </div>
            <div class="fitem">
                <input id="ven_cliente_domicilio_fiscal" name="domicilio_fiscal">
            </div>
            <div class="fitem">
                <input id="ven_cliente_telefono" name="telefono">
            </div>
            <div class="fitem">
                <input id="ven_cliente_estado" name="estado">
            </div>
        </form>
    </div>
    <!--ticket preview-->
    <div id="venta_ticket"></div>
    <!-- splitter -->
    <div id="splitter_dlg">
        <table class="table table-bordered table-sm" id="splitter_table">
            <thead>
            <tr id="splitter_head"></tr>
            </thead>
            <tbody>
            <tr id="splitter_body"></tr>
            </tbody>
        </table>
    </div>
</div>
<script id="venta_template" type="text/template">
    <tr id="venta_tr_%position%">
        <td style="width: 45%">
            <input id="venta_cbproducto_%position%" name="detalle[producto][]">
        </td>
        <td style="width: 10%">
            <input id="venta_tbcantidad_%position%" name="detalle[cantidad][]" class="cantidad">
        </td>
        <td style="width: 15%">
            <input id="venta_tbprecio_%position%" name="detalle[unitario][]">
        </td>
        <td style="width: 10%">
            <input id="venta_tbdescuento_%position%" name="detalle[descuento][]">
        </td>
        <td style="width: 15%">
            <input id="venta_tbtotal_%position%" name="detalle[total][]" class="venta_subtotal">
        </td>
        <td style="width: 5%">
            <a>
                <i class="fas fa-times text-danger" style="padding: 6px; cursor: pointer"
                   onclick="app.venta.remove_row(%position%)"></i>
            </a>
        </td>
    </tr>
</script>
<script id="splitter_head_template" type="text/template">
    <th id='splitter_cuenta_%account%' class='text-center' style='min-width: 350px'>
        Cuenta %account%
        <span id="splitter_head_toolbar_%account%" class="pull-right">
      <button id="splitter_head_button_%account%" class="btn btn-default btn-sm" type="button"
              onclick="app.venta.remove_account(%account%)">
        <i class="fas fa-times text-danger" style="padding:3px"></i>
      </button>
    </span>
    </th>
</script>
<script id="splitter_body_template" type="text/template">
    <td id='splitter_panel_%account%' class='text-center' style='min-width: 400px'>
        <div class="easyui-layout" data-options="fit:true">
            <form id="split_fm_%account%" method="post" novalidate>
                <div data-options="region: 'north', border: false" style="height:165px; padding:10px 30px">
                    <input type="hidden" id="split_operacion_%account%" name="operacion_id">
                    <div class="fitem">
                        <input id="split_cliente_%account%" name="cliente_id">
                    </div>
                    <div class="fitem">
                        <input id="split_glosa_%account%" name="glosa">
                    </div>
                    <div class="fitem">
                        <input id="split_pago_%account%" name="tipo_pago">
                    </div>
                    <div class="fitem">
                        <input id="split_tarjeta_%account%" name="tipo_tarjeta">
                    </div>
                    <input type="hidden" id="split_orden_%account%" name="orden_id">
                </div>
                <div data-options="region: 'center'" style="padding:2px 0px">
                    <div class="easyui-layout" data-options="fit:true">
                        <div data-options="region: 'north', border: false" style="padding:0px 30px">
                            <table class="table table-bordered table-striped table-sm table-nomargin">
                                <tr>
                                    <th style="width: 90%">Item</th>
                                    <th style="width: 10%" class="text-center">
                                        <a>
                                            <i class="fa fa-cog fa-lg color-blue"></i>
                                        </a>
                                    </th>
                                </tr>
                            </table>
                        </div>
                        <div data-options="region: 'center', border: false" style="padding:0px 30px">
                            <table class="table table-bordered table-striped table-sm table-nomargin">
                                <tbody id="split_tb_detalle_%account%"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div data-options="region: 'south', border: false" style="padding:2px 30px">
                    <div class="text-center">
                        <button type="button" id="split_btn_guardar_%account%" class="btn btn-success btn-sm"
                                onclick="app.venta.guardar(%account%)">Guardar
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </td>
</script>
<script id="splitter_item_template" type="text/template">
    <tr class="text-left" id="item_%counter%">
        <td class="text-center">
            <span id="item_text_cantidad_%counter%" data-account="%account%"
                  data-position="%counter%">%item_cantidad%</span>
            <input type="hidden" id="item_cantidad_%counter%" data-account="%account%" data-position="%counter%"
                   name="detalle[cantidad][]"
                   value="%item_cantidad%">
        </td>
        <td style="width: 70%">
            <span id="item_text_producto_%counter%" data-account="%account%"
                  data-position="%counter%">%item_producto%</span>
            <input type="hidden" id="item_producto_%counter%" data-account="%account%" data-position="%counter%"
                   name="detalle[producto][]"
                   value="%item_producto_id%">
        </td>
        <td class="text-center">
            <b><span id="item_text_total_%counter%" data-account="%account%"
                     data-position="%counter%">%item_total%</span></b><br>
            <input type="hidden" id="item_total_%counter%" data-account="%account%" data-position="%counter%"
                   name="detalle[total][]"
                   value="%item_total%">
            <span id="item_text_unitario_%counter%" data-account="%account%"
                  data-position="%counter%">%item_unitario%</span>
            <input type="hidden" id="item_unitario_%counter%" data-account="%account%" data-position="%counter%"
                   name="detalle[unitario][]"
                   value="%item_unitario%">
        </td>
        <td class="text-center">
            <button type="button" id="item_btn_back_%counter%" class="btn btn-primary btn-sm" data-account="%account%"
                    data-position="%counter%"
                    onclick="app.venta.move_item(0, %account%, %counter%)">
                <i class="fa fa-chevron-left"></i>
            </button>
        </td>
        <td class="text-center">
            <button type="button" id="item_btn_next_%counter%" class="btn btn-primary btn-sm" data-account="%account%"
                    data-position="%counter%"
                    onclick="app.venta.move_item(1, %account%, %counter%)">
                <i class="fa fa-chevron-right"></i>
            </button>
        </td>
    </tr>
</script>
<script src="{{ asset('assets/js/pages/venta_pos/index.js') }}"></script>
{{ printDetectionScript | raw }}
{{ printScript | raw }}
