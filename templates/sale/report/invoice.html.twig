<!DOCTYPE html>
<html lang="es">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.2/css/bootstrap.min.css"
          integrity="sha384-Smlep5jCw/wG7hdkwQ/Z5nLIefveQRIY9nfy6xoR1uRYBtpZgI6339F5dgvm/e9B" crossorigin="anonymous">

    <title>{{ voucher.voucher_series }} - {{ voucher.voucher_number }}</title>
    <style>
        body {
            width: 80mm;
            max-width: 80mm;
            margin: 0 auto;
            background: #333;
        }

        .table {
            font-size: 12px;
        }

        .table-nm {
            margin-bottom: 0;
        }

        .row-bb {
            border-bottom: 1px solid #dee2e6;
        }

        .row-bt {
            border-top: 1px solid #dee2e6;
        }
    </style>
</head>
<body>
<div class="container-fluid p-0">
    <div style="background: #fff">
        <table class="table table-sm table-borderless table-nm">
            <tr>
                <td class="text-center" style="width: 50%">
                    <img src="{{ logo() }}" alt="Logo" style="position: relative; max-height: 100px">
                </td>
            </tr>
            <tr class="row-border">
                <td class="text-center">
                    <b>{{ voucher.company_name }}</b><br>
                    {% if voucher.voucher_type != '00' %}
                        RUC: {{ voucher.company_id }}<br>
                    {% endif %}
                    {{ voucher.company_address }}<br>
                    Tel.: {{ voucher.company_phone }}<br>
                </td>
            </tr>
            <tr class="row-bt row-bb">
                <td class="text-center">
                    {% if voucher.voucher_type == '01' %}
                        <h5>FACTURA ELECTRONICA</h5>
                    {% elseif voucher.voucher_type == '03' %}
                        <h5>BOLETA ELECTRONICA</h5>
                    {% else %}
                        <h5>NOTA DE VENTA</h5>
                    {% endif %}
                    <strong>{{ voucher.voucher_series }} - {{ voucher.voucher_number }}</strong>
                </td>
            </tr>
            <tr class="row-bb">
                <td>
                    Fecha: {{ voucher.voucher_date|date('d/m/Y') }}<br>
                    Moneda: Soles
                </td>
            </tr>
            <tr>
                <td>
                    CLIENTE: {{ voucher.customer_name }}<br>
                    {% if voucher.voucher_type == '01' %}
                        RUC: {{ voucher.customer_doc_number }}<br>
                    {% elseif voucher.voucher_type == '03' %}
                        DNI: {{ voucher.customer_doc_number }}<br>
                    {% endif %}
                    DIRECCION: {{ voucher.customer_address }}<br>
                    {% block extra %}
                        FORMA DE PAGO: CONTADO<br>
                    {% endblock %}
                </td>
            </tr>
        </table>
        <div class="table-responsive-sm">
            <table class="table table-sm table-borderless table-nm">
                <thead>
                <tr class="row-bt row-bb">
                    <th># Descripcion</th>
                    <th class="text-right text-end">S/</th>
                </tr>
                </thead>
                <tbody>
                {% for item in voucher.voucher_items %}
                    <tr>
                        <td class="left">{{ item.quantity|round }} {{ item.product_name }}</td>
                        <td class="text-right text-end">{{ item.total|number_format(2, '.', '') }}</td>
                    </tr>
                {% endfor %}
                <tr class="row-bt">
                    <td></td>
                    <td></td>
                </tr>
                {% if voucher.voucher_discount_percentage > 0 %}
                    <tr>
                        <td class="left">DTO.:</td>
                        <td class="text-right text-end">
                            -{{ voucher.voucher_discount_amount|number_format(2, '.', '') }}</td>
                    </tr>
                {% endif %}
                {% if voucher.voucher_type != '00' %}
                    <tr>
                        <td class="left">OP. GRAVADA:</td>
                        <td class="text-right text-end">{{ voucher.voucher_taxed_amount|number_format(2, '.', '') }}</td>
                    </tr>
                    <tr>
                        <td class="left">OP. INAFECTA:</td>
                        <td class="text-right text-end">0.00</td>
                    </tr>
                    <tr>
                        <td class="left">OP. EXONERADA:</td>
                        <td class="text-right text-end">0.00</td>
                    </tr>
                    <tr>
                        <td class="left">IGV ({{ voucher.voucher_tax_percentage }}%):</td>
                        <td class="text-right text-end">{{ voucher.voucher_total_taxes|number_format(2, '.', '') }}</td>
                    </tr>
                    {% if voucher.voucher_consumption_surcharge_amount > 0 %}
                        <tr>
                            <td class="left">RC ({{ voucher.voucher_consumption_surcharge_percentage }}%):</td>
                            <td class="text-right text-end">
                                {{ voucher.voucher_consumption_surcharge_amount|number_format(2, '.', '') }}
                            </td>
                        </tr>
                    {% endif %}
                {% endif %}
                <tr>
                    <td class="left">
                        <strong>TOTAL:</strong></td>
                    <td class="text-right text-end">
                        <strong>{{ voucher.voucher_sale_amount|number_format(2, '.', '') }}</strong>
                    </td>
                </tr>
                </tbody>
            </table>
        </div>
        <table class="table table-sm table-borderless">
            <tbody>
            <tr class="row-bt row-bb">
                <td class="text-center">
                    <strong>
                        {{ voucher.voucherTotalText }}
                    </strong>
                </td>
            </tr>
            {% if voucher.voucher_type != '00' %}
                <tr>
                    <td class="text-center">
                        <img src="{{ qr|default('') }}" alt="QR" style="position: relative; max-height: 120px"><br>
                        <p>Resumen: {{ voucher.voucher_hash }}</p>
                        <p>Representacion impresa del comprobante electronico, consulte en https://fe.efact.com/</p>
                    </td>
                </tr>
            {% endif %}
            <tr>
                <td class="text-center">
                    <p></p>
                    {{ "now"|date("d/m/Y H:i:s") }}<br>
                    ** Gracias por su preferencia **
                </td>
            </tr>
            </tbody>
        </table>
    </div>
</div>
</body>
</html>
