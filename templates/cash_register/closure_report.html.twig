<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Reporte de cierre de caja</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 24px; color: #111; }
        h1 { font-size: 20px; margin-bottom: 8px; }
        h2 { font-size: 16px; margin: 12px 0 6px; }
        table { width: 100%; border-collapse: collapse; margin-top: 8px; }
        th, td { padding: 6px 8px; border: 1px solid #ccc; font-size: 12px; }
        th { background: #f5f5f5; text-align: left; }
        .right { text-align: right; }
        .muted { color: #666; font-size: 11px; }
        .summary { margin-top: 12px; }
    </style>
</head>
<body>
    <h1>Reporte de cierre de caja</h1>
    <div class="muted">
        <div>Caja: {{ cashRegister.name }}</div>
        <div>Turno: {{ cashShift.id }}</div>
        <div>Abierto: {{ cashShift.openedAt|date('d/m/Y H:i') }}</div>
        <div>Cerrado: {{ cashShift.closedAt ? cashShift.closedAt|date('d/m/Y H:i') : '—' }}</div>
        <div>Cajero: {{ cashShift.openedBy }}</div>
    </div>

    <div class="summary">
        <h2>Resumen</h2>
        <table>
            <tr>
                <th>Saldo inicial</th>
                <th>Ingresos</th>
                <th>Egresos</th>
                <th>Esperado</th>
                <th>Contado</th>
                <th>Diferencia</th>
            </tr>
            <tr>
                <td class="right">{{ openingBalance|number_format(2, '.', ',') }}</td>
                <td class="right">{{ income|number_format(2, '.', ',') }}</td>
                <td class="right">{{ expense|number_format(2, '.', ',') }}</td>
                <td class="right">{{ expectedAmount|number_format(2, '.', ',') }}</td>
                <td class="right">{{ countedAmount|number_format(2, '.', ',') }}</td>
                <td class="right">{{ difference|number_format(2, '.', ',') }}</td>
            </tr>
        </table>
    </div>

    <div class="summary">
        <h2>Movimientos</h2>
        <table>
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Categoría</th>
                    <th>Tipo</th>
                    <th>Descripción</th>
                    <th class="right">Monto</th>
                </tr>
            </thead>
            <tbody>
            {% for movement in movements %}
                <tr>
                    <td>{{ movement.createdAt|date('d/m/Y H:i') }}</td>
                    <td>{{ movement.category.name ?? movement.category }}</td>
                    <td>{{ movement.type == 'income' ? 'Ingreso' : 'Egreso' }}</td>
                    <td>{{ movement.description }}</td>
                    <td class="right">{{ movement.amount|number_format(2, '.', ',') }}</td>
                </tr>
            {% else %}
                <tr><td colspan="5" class="muted">Sin movimientos.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    {% if note %}
        <div class="summary">
            <h2>Notas</h2>
            <div>{{ note }}</div>
        </div>
    {% endif %}
</body>
</html>
