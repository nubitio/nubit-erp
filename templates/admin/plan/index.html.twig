{% extends 'admin/base.html.twig' %}

{% block title %}Plans{% endblock %}
{% block nav_plans %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">Plans</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0">Plans & limits</h1>
            <p class="text-muted mb-0">Define quota rules and defaults used by tenant provisioning.</p>
        </div>
    </div>

    {% set defaultCount = 0 %}
    {% for plan in plans %}
        {% if plan.is_default %}
            {% set defaultCount = defaultCount + 1 %}
        {% endif %}
    {% endfor %}

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total plans</p>
                    <p class="display-6 mb-0">{{ plans|length }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Default plans</p>
                    <p class="display-6 mb-0">{{ defaultCount }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Quick rule</p>
                    <p class="mb-0 fw-semibold">Use <code>-1</code> for unlimited limits.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-4">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-1"><i class="bi bi-plus-circle me-1"></i> Create plan</h2>
                    <p class="text-muted small mb-3">Start from scratch and tune each limit.</p>
                    <form action="{{ path('admin_plan_create') }}" method="post" class="row g-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <div class="col-12">
                            <label class="form-label">Name</label>
                            <input class="form-control" name="name" placeholder="e.g. enterprise" required>
                        </div>
                        <div class="col-12">
                            <div class="btn-group btn-group-sm" role="group" aria-label="Quick presets">
                                <button type="button" class="btn btn-outline-secondary js-apply-preset"
                                        data-target="create" data-preset="unlimited">
                                    Set all unlimited
                                </button>
                                <button type="button" class="btn btn-outline-secondary js-apply-preset"
                                        data-target="create" data-preset="starter">
                                    Starter preset
                                </button>
                            </div>
                        </div>

                        {% for field in ['users','customers','products','invoices','branches','storage_mb'] %}
                            <div class="col-6">
                                <label class="form-label text-capitalize">
                                    {{ field|replace({'_':' '}) }}
                                </label>
                                <input class="form-control js-limit-create" type="number"
                                       name="{{ field }}" value="-1">
                            </div>
                        {% endfor %}
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="1"
                                       name="is_default" id="create_default">
                                <label class="form-check-label" for="create_default">Set as default</label>
                            </div>
                        </div>
                        <div class="col-12 d-grid">
                            <button class="btn btn-primary" type="submit">Create plan</button>
                        </div>
                        <div class="col-12">
                            <div class="form-text">
                                Tip: set only what you need and keep the rest at <code>-1</code>.
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-xl-8">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Existing plans</h2>
                        <span class="text-muted small">
                            Click save inside each plan to persist changes
                        </span>
                    </div>
                    {% if plans is empty %}
                        <div class="border rounded p-3 text-center text-muted bg-light">
                            No plans found.
                        </div>
                    {% else %}
                        {% for plan in plans %}
                            <form action="{{ path('admin_plan_update', {'id': plan.id}) }}" method="post"
                                  class="border rounded p-3 mb-3 {{ plan.is_default ? 'border-primary' : '' }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-semibold">{{ plan.name }}</span>
                                        {% if plan.is_default %}
                                            <span class="badge text-bg-primary">Default</span>
                                        {% endif %}
                                    </div>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <button type="button"
                                                class="btn btn-outline-secondary js-apply-preset"
                                                data-target="plan-{{ plan.id }}" data-preset="unlimited">
                                            Unlimited
                                        </button>
                                        <button type="button"
                                                class="btn btn-outline-secondary js-apply-preset"
                                                data-target="plan-{{ plan.id }}" data-preset="starter">
                                            Starter
                                        </button>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <label class="form-label">Name</label>
                                        <input class="form-control" name="name"
                                               value="{{ plan.name }}" required>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" value="1"
                                                   name="is_default" id="default_{{ plan.id }}"
                                                   {{ plan.is_default ? 'checked' : '' }}>
                                            <label class="form-check-label" for="default_{{ plan.id }}">
                                                Default
                                            </label>
                                        </div>
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end justify-content-end">
                                        <button class="btn btn-outline-primary btn-sm" type="submit">
                                            Save
                                        </button>
                                    </div>

                                    {% for key in ['users','customers','products','invoices','branches','storage_mb'] %}
                                        <div class="col-md-4">
                                            <label class="form-label text-capitalize">
                                                {{ key|replace({'_':' '}) }}
                                            </label>
                                            <input class="form-control js-limit-plan-{{ plan.id }}"
                                                   type="number" name="{{ key }}"
                                                   value="{{ plan.limits[key] ?? -1 }}">
                                        </div>
                                    {% endfor %}

                                    <div class="col-12 d-flex justify-content-end gap-2">
                                        <button class="btn btn-outline-danger btn-sm"
                                                formaction="{{ path('admin_plan_delete', {'id': plan.id}) }}"
                                                formmethod="post"
                                                onclick="return confirm('Delete plan {{ plan.name }}?');">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            </form>
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
(() => {
    const presets = {
        unlimited: {
            users: -1, customers: -1, products: -1,
            invoices: -1, branches: -1, storage_mb: -1
        },
        starter: {
            users: 5, customers: 250, products: 120,
            invoices: 1500, branches: 2, storage_mb: 300
        }
    };

    function applyPreset(target, presetName) {
        const preset = presets[presetName];
        if (!preset) { return; }

        if (target === 'create') {
            document.querySelectorAll('.js-limit-create').forEach((input) => {
                const key = input.getAttribute('name');
                if (key in preset) { input.value = preset[key]; }
            });
            return;
        }

        document.querySelectorAll('.js-limit-' + target).forEach((input) => {
            const key = input.getAttribute('name');
            if (key in preset) { input.value = preset[key]; }
        });
    }

    document.querySelectorAll('.js-apply-preset').forEach((button) => {
        button.addEventListener('click', () => {
            applyPreset(
                button.getAttribute('data-target') || '',
                button.getAttribute('data-preset') || ''
            );
        });
    });
})();
</script>
{% endblock %}
