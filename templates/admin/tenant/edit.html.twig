<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit tenant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-GLhlTQ8iRABdZLl6O3oVMWSktQOp6b7In1Zl3/Jr59b6EGGoI1aFkw7cmDA6j6gD" crossorigin="anonymous">
</head>
<body>
<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <p class="text-uppercase text-muted mb-1 small">Tenant management</p>
            <h1 class="h4 mb-0">Edit tenant</h1>
            <p class="text-muted mb-0">Update the tenant name or database connection.</p>
        </div>
        <a href="{{ url('admin_tenant_index') }}" class="btn btn-link">Back to list</a>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} mt-3" role="alert">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h5 mb-3">Edit {{ tenant.name }}</h2>
                    <form action="{{ url('admin_tenant_update', {'id': tenant.id}) }}" method="post" class="needs-validation" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" name="name" value="{{ tenant.name }}"
                                   placeholder="Tenant name" required>
                        </div>
                        <div class="mb-3">
                            <label for="connection" class="form-label">Connection</label>
                            <input type="text" class="form-control" id="connection" name="connection"
                                   value="{{ tenant.connection }}" placeholder="Database/schema" required>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <a href="{{ url('admin_tenant_index') }}" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary">Save changes</button>
                        </div>
                    </form>

                    <hr class="my-4">

                    <h3 class="h6 mb-2">Plan</h3>
                    <form id="tenant-plan-form" action="{{ url('admin_tenant_plan', {'id': tenant.id}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <div class="d-flex gap-2">
                            <select id="plan" name="plan" class="form-select">
                                {% for plan in plans %}
                                    <option value="{{ plan.name }}" {{ (tenant.plan ?? 'free') == plan.name ? 'selected' : '' }}>
                                        {{ plan.name }}{{ plan.is_default ? ' (default)' : '' }}
                                    </option>
                                {% endfor %}
                            </select>
                            <button class="btn btn-outline-primary" type="submit">Change</button>
                        </div>
                        <div class="form-text">Plan controls quotas and limits for this tenant.</div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h5 mb-3">Domains</h2>
                    <form action="{{ url('admin_tenant_domain_create', {'id': tenant.id}) }}" method="post" class="row g-3 align-items-end mb-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <div class="col-12">
                            <label for="domain" class="form-label">Domain</label>
                            <input type="text" class="form-control" id="domain" name="domain" placeholder="acme.example.com" required>
                            <div class="form-text">Add a custom domain for this tenant.</div>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" value="1" id="is_primary" name="is_primary">
                                <label class="form-check-label" for="is_primary">Set as primary domain</label>
                            </div>
                        </div>
                        <div class="col-12 d-grid">
                            <button class="btn btn-outline-primary" type="submit">Add domain</button>
                        </div>
                    </form>

                    {% if domains is empty %}
                        <div class="border rounded p-3 text-center text-muted bg-light">
                            No domains yet.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th scope="col">Domain</th>
                                    <th scope="col">Primary</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for domain in domains %}
                                    <tr>
                                        <td><code class="bg-light px-2 py-1 rounded">{{ domain.domain }}</code></td>
                                        <td>
                                            {% if domain.is_primary %}
                                                <span class="badge bg-success-subtle text-success">Primary</span>
                                            {% else %}
                                                <span class="badge bg-secondary-subtle text-secondary">Secondary</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if not domain.is_primary %}
                                                <form action="{{ url('admin_tenant_domain_primary', {'tenantId': tenant.id, 'domainId': domain.id}) }}" method="post" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                                    <button type="submit" class="btn btn-outline-secondary btn-sm me-2">
                                                        Set primary
                                                    </button>
                                                </form>
                                            {% endif %}
                                            <form action="{{ url('admin_tenant_domain_delete', {'tenantId': tenant.id, 'domainId': domain.id}) }}" method="post" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Delete domain {{ domain.domain }}?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h2 class="h5 mb-3">Provisioning</h2>
                    <form action="{{ url('admin_tenant_provision', {'id': tenant.id}) }}" method="post" class="row g-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <div class="col-md-4">
                            <label for="admin_user" class="form-label">Admin user</label>
                            <input type="text" class="form-control" id="admin_user" name="admin_user" value="admin" required>
                        </div>
                        <div class="col-md-4">
                            <label for="admin_pass" class="form-label">Admin password</label>
                            <input type="password" class="form-control" id="admin_pass" name="admin_pass" required>
                        </div>
                        <div class="col-md-4">
                            <label for="domain" class="form-label">Domain</label>
                            <input type="text" class="form-control" id="domain" name="domain"
                                   value="{{ primary_domain ?? '' }}" placeholder="acme.example.com">
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Dispatch provisioning</button>
                        </div>
                        <div class="col-12">
                            <div class="form-text">
                                This triggers the GitHub Actions workflow to provision the tenant.
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h2 class="h5 mb-0">Observability</h2>
                        <a href="{{ url('admin_tenant_usage', {'id': tenant.id}) }}" class="btn btn-outline-secondary btn-sm">JSON</a>
                    </div>

                    {% if quota_alerts is not empty %}
                        <div class="alert alert-warning">
                            <strong>Quota alerts:</strong>
                            <ul class="mb-0">
                                {% for alert in quota_alerts %}
                                    <li>{{ alert.resource }} at {{ alert.percent }}%</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <div class="row g-3 mb-3">
                        {% for metric, value in usage_latest %}
                            <div class="col-md-3">
                                <div class="border rounded p-2">
                                    <div class="text-muted small">{{ metric }}</div>
                                    <div class="fw-semibold">{{ value }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {% if quota_summary is not empty %}
                        <div class="table-responsive mb-3">
                            <table class="table table-sm">
                                <thead class="table-light">
                                <tr>
                                    <th>Resource</th>
                                    <th>Current</th>
                                    <th>Limit</th>
                                    <th>%</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for resource, usage in quota_summary %}
                                    {% set limit = usage.limit %}
                                    {% set pct = limit > 0 ? ((usage.current / limit) * 100)|round(2) : null %}
                                    <tr>
                                        <td>{{ resource }}</td>
                                        <td>{{ usage.current }}</td>
                                        <td>{{ limit == -1 ? 'unlimited' : limit }}</td>
                                        <td>{{ pct is null ? '-' : pct ~ '%' }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <h3 class="h6">Recent usage samples (24h)</h3>
                    {% if usage_history is empty %}
                        <div class="text-muted">No usage samples yet.</div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead class="table-light">
                                <tr>
                                    <th>Collected at</th>
                                    <th>Metric</th>
                                    <th>Value</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for row in usage_history|slice(0, 100) %}
                                    <tr>
                                        <td>{{ row.collected_at }}</td>
                                        <td>{{ row.metric_name }}</td>
                                        <td>{{ row.metric_value }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
