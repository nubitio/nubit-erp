{% extends 'admin/base.html.twig' %}

{% block title %}Edit {{ tenant.name }}{% endblock %}
{% block nav_tenants %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_index') }}">Tenants</a></li>
            <li class="breadcrumb-item active">{{ tenant.name }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 mb-0">{{ tenant.name }}</h1>
            <p class="text-muted mb-0">Manage tenant settings, domains, and provisioning.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="{{ path('admin_tenant_notifications', {'id': tenant.id}) }}"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-bell me-1"></i> Notifications
            </a>
            {% if tenant.status is defined and tenant.status == 'suspended' %}
                <span class="badge bg-warning-subtle text-warning fs-6">Suspended</span>
            {% elseif tenant.status is defined and tenant.status == 'active' %}
                <span class="badge bg-success-subtle text-success fs-6">Active</span>
            {% endif %}
        </div>
    </div>

    <ul class="nav nav-tabs" id="tenantTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="general-tab" data-bs-toggle="tab"
                    data-bs-target="#general" type="button" role="tab">
                <i class="bi bi-pencil-square me-1"></i> General
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="domains-tab" data-bs-toggle="tab"
                    data-bs-target="#domains" type="button" role="tab">
                <i class="bi bi-globe me-1"></i> Domains
                {% if domains is not empty %}
                    <span class="badge bg-secondary ms-1">{{ domains|length }}</span>
                {% endif %}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="provisioning-tab" data-bs-toggle="tab"
                    data-bs-target="#provisioning" type="button" role="tab">
                <i class="bi bi-rocket me-1"></i> Provisioning
                {% if provisions is not empty %}
                    <span class="badge bg-secondary ms-1">{{ provisions|length }}</span>
                {% endif %}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="usage-tab" data-bs-toggle="tab"
                    data-bs-target="#usage" type="button" role="tab">
                <i class="bi bi-graph-up me-1"></i> Usage
                {% if quota_alerts is not empty %}
                    <span class="badge bg-warning ms-1">{{ quota_alerts|length }}</span>
                {% endif %}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="subscription-tab" data-bs-toggle="tab"
                    data-bs-target="#subscription" type="button" role="tab">
                <i class="bi bi-credit-card me-1"></i> Subscription
                {% if subscription %}
                    <span class="badge bg-{{ subscription.status == 'active' ? 'success' : (subscription.status == 'past_due' ? 'warning' : 'secondary') }} ms-1">{{ subscription.status }}</span>
                {% endif %}
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="backups-tab" data-bs-toggle="tab"
                    data-bs-target="#backups" type="button" role="tab">
                <i class="bi bi-archive me-1"></i> Backups
                {% if backups is not empty %}
                    <span class="badge bg-secondary ms-1">{{ backups|length }}</span>
                {% endif %}
            </button>
        </li>
    </ul>

    <div class="tab-content pt-4" id="tenantTabContent">
        {# ── GENERAL TAB ── #}
        <div class="tab-pane fade show active" id="general" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Tenant details</h2>
                            <form action="{{ path('admin_tenant_update', {'id': tenant.id}) }}" method="post"
                                  class="needs-validation" novalidate>
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <div class="mb-3">
                                    <label for="name" class="form-label">Name</label>
                                    <input type="text" class="form-control" id="name" name="name"
                                           value="{{ tenant.name }}" placeholder="Tenant name" required>
                                </div>
                                <div class="mb-3">
                                    <label for="connection" class="form-label">Connection</label>
                                    <input type="text" class="form-control" id="connection" name="connection"
                                           value="{{ tenant.connection }}" placeholder="Database/schema" required>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="{{ path('admin_tenant_index') }}"
                                       class="btn btn-outline-secondary">Cancel</a>
                                    <button type="submit" class="btn btn-primary">Save changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Plan</h2>
                            <form id="tenant-plan-form"
                                  action="{{ path('admin_tenant_plan', {'id': tenant.id}) }}" method="post">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <div class="d-flex gap-2">
                                    <select id="plan" name="plan" class="form-select">
                                        {% for plan in plans %}
                                            <option value="{{ plan.name }}"
                                                {{ (tenant.plan ?? 'free') == plan.name ? 'selected' : '' }}>
                                                {{ plan.name }}{{ plan.is_default ? ' (default)' : '' }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                    <button class="btn btn-outline-primary" type="submit">Change</button>
                                </div>
                                <div class="form-text">Plan controls quotas and limits for this tenant.</div>
                            </form>

                            <hr class="my-4">

                            <h2 class="h5 mb-3">Status</h2>
                            {% if tenant.status is defined and tenant.status == 'suspended' %}
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-warning-subtle text-warning">Suspended</span>
                                    <form action="{{ path('admin_tenant_unsuspend', {'id': tenant.id}) }}"
                                          method="post" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                        <button type="submit" class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-play-circle me-1"></i> Unsuspend
                                        </button>
                                    </form>
                                </div>
                            {% else %}
                                <div class="d-flex align-items-center gap-3">
                                    <span class="badge bg-success-subtle text-success">Active</span>
                                    <form action="{{ path('admin_tenant_suspend', {'id': tenant.id}) }}"
                                          method="post" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                        <button type="submit" class="btn btn-outline-warning btn-sm"
                                                onclick="return confirm('Suspend tenant {{ tenant.name }}?');">
                                            <i class="bi bi-pause-circle me-1"></i> Suspend
                                        </button>
                                    </form>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── DOMAINS TAB ── #}
        <div class="tab-pane fade" id="domains" role="tabpanel">
            <div class="row g-4">
                <div class="col-lg-5">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h5 mb-3"><i class="bi bi-plus-circle me-1"></i> Add domain</h2>
                            <form action="{{ path('admin_tenant_domain_create', {'id': tenant.id}) }}"
                                  method="post" class="row g-3 align-items-end">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                <div class="col-12">
                                    <label for="domain" class="form-label">Domain</label>
                                    <input type="text" class="form-control" id="domain" name="domain"
                                           placeholder="acme.example.com" required>
                                    <div class="form-text">Add a custom domain for this tenant.</div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" value="1"
                                               id="is_primary" name="is_primary">
                                        <label class="form-check-label" for="is_primary">
                                            Set as primary domain
                                        </label>
                                    </div>
                                </div>
                                <div class="col-12 d-grid">
                                    <button class="btn btn-outline-primary" type="submit">Add domain</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="card">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Current domains</h2>
                            {% if domains is empty %}
                                <div class="border rounded p-3 text-center text-muted bg-light">
                                    No domains yet.
                                </div>
                            {% else %}
                                <div class="table-responsive">
                                    <table class="table align-middle mb-0">
                                        <thead>
                                        <tr>
                                            <th scope="col">Domain</th>
                                            <th scope="col">Primary</th>
                                            <th scope="col" class="text-end">Actions</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for domain in domains %}
                                            <tr>
                                                <td>
                                                    <code class="bg-light px-2 py-1 rounded">
                                                        {{ domain.domain }}
                                                    </code>
                                                </td>
                                                <td>
                                                    {% if domain.is_primary %}
                                                        <span class="badge bg-success-subtle text-success">
                                                            Primary
                                                        </span>
                                                    {% else %}
                                                        <span class="badge bg-secondary-subtle text-secondary">
                                                            Secondary
                                                        </span>
                                                    {% endif %}
                                                </td>
                                                <td class="text-end">
                                                    {% if not domain.is_primary %}
                                                        <form action="{{ path('admin_tenant_domain_primary', {'tenantId': tenant.id, 'domainId': domain.id}) }}"
                                                              method="post" class="d-inline">
                                                            <input type="hidden" name="_token"
                                                                   value="{{ csrf_token('admin') }}">
                                                            <button type="submit"
                                                                    class="btn btn-outline-secondary btn-sm me-1">
                                                                Set primary
                                                            </button>
                                                        </form>
                                                    {% endif %}
                                                    <form action="{{ path('admin_tenant_domain_delete', {'tenantId': tenant.id, 'domainId': domain.id}) }}"
                                                          method="post" class="d-inline">
                                                        <input type="hidden" name="_token"
                                                               value="{{ csrf_token('admin') }}">
                                                        <button type="submit"
                                                                class="btn btn-outline-danger btn-sm"
                                                                onclick="return confirm('Delete domain {{ domain.domain }}?');">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── PROVISIONING TAB ── #}
        <div class="tab-pane fade" id="provisioning" role="tabpanel">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-rocket me-1"></i> Provisioning</h2>
                    <form action="{{ path('admin_tenant_provision', {'id': tenant.id}) }}" method="post"
                          class="row g-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <div class="col-md-4">
                            <label for="admin_user" class="form-label">Admin user</label>
                            <input type="text" class="form-control" id="admin_user" name="admin_user"
                                   value="admin" required>
                        </div>
                        <div class="col-md-4">
                            <label for="admin_pass" class="form-label">Admin password</label>
                            <input type="password" class="form-control" id="admin_pass" name="admin_pass"
                                   required>
                        </div>
                        <div class="col-md-4">
                            <label for="prov_domain" class="form-label">Domain</label>
                            <input type="text" class="form-control" id="prov_domain" name="domain"
                                   value="{{ primary_domain ?? '' }}" placeholder="acme.example.com">
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-play-fill me-1"></i> Dispatch provisioning
                            </button>
                        </div>
                        <div class="col-12">
                            <div class="form-text">
                                This triggers the GitHub Actions workflow to provision the tenant.
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-clock-history me-1"></i> Provisioning history</h2>
                    {% if provisions is empty %}
                        <div class="border rounded p-3 text-center text-muted bg-light">
                            No provisioning runs yet.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Domain</th>
                                    <th scope="col">Container</th>
                                    <th scope="col">Created</th>
                                    <th scope="col">Started</th>
                                    <th scope="col">Completed</th>
                                    <th scope="col">Error</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for prov in provisions %}
                                    <tr>
                                        <td>{{ prov.id }}</td>
                                        <td>
                                            {% if prov.status == 'completed' %}
                                                <span class="badge bg-success-subtle text-success">Completed</span>
                                            {% elseif prov.status == 'failed' %}
                                                <span class="badge bg-danger-subtle text-danger">Failed</span>
                                            {% elseif prov.status == 'running' %}
                                                <span class="badge bg-info-subtle text-info">Running</span>
                                            {% else %}
                                                <span class="badge bg-warning-subtle text-warning">Dispatched</span>
                                            {% endif %}
                                        </td>
                                        <td><code class="bg-light px-1 rounded">{{ prov.domain }}</code></td>
                                        <td>{{ prov.target_container }}</td>
                                        <td>{{ prov.created_at }}</td>
                                        <td>{{ prov.started_at ?? '-' }}</td>
                                        <td>{{ prov.completed_at ?? '-' }}</td>
                                        <td>
                                            {% if prov.error_message %}
                                                <span class="text-danger" title="{{ prov.error_message }}">
                                                    {{ prov.error_message|length > 60 ? prov.error_message[:60] ~ '...' : prov.error_message }}
                                                </span>
                                            {% else %}
                                                -
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── SUBSCRIPTION TAB ── #}
        <div class="tab-pane fade" id="subscription" role="tabpanel">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-credit-card me-1"></i> Subscription</h2>

                    {% if subscription %}
                        <div class="row g-3 mb-4">
                            <div class="col-md-3">
                                <div class="border rounded p-3">
                                    <div class="text-muted small">Plan</div>
                                    <div class="fw-semibold text-capitalize">{{ subscription.plan }}</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3">
                                    <div class="text-muted small">Status</div>
                                    <div>
                                        {% if subscription.status == 'active' %}
                                            <span class="badge bg-success-subtle text-success">Active</span>
                                        {% elseif subscription.status == 'past_due' %}
                                            <span class="badge bg-warning-subtle text-warning">Past due</span>
                                        {% elseif subscription.status == 'pending' %}
                                            <span class="badge bg-info-subtle text-info">Pending</span>
                                        {% elseif subscription.status == 'cancelled' %}
                                            <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                                        {% elseif subscription.status == 'suspended' %}
                                            <span class="badge bg-warning-subtle text-warning">Suspended</span>
                                        {% else %}
                                            <span class="badge bg-secondary-subtle text-secondary">{{ subscription.status }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3">
                                    <div class="text-muted small">Billing cycle</div>
                                    <div class="fw-semibold">{{ subscription.billing_cycle == 'annual' ? 'Annual' : 'Monthly' }}</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded p-3">
                                    <div class="text-muted small">Gateway</div>
                                    <div class="fw-semibold">{{ subscription.gateway == 'paypal' ? 'PayPal' : (subscription.gateway == 'mercadopago' ? 'MercadoPago' : subscription.gateway) }}</div>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <tbody>
                                    <tr>
                                        <td class="text-muted" style="width:200px;">Subscription ID</td>
                                        <td><code>{{ subscription.id }}</code></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Gateway subscription ID</td>
                                        <td><code>{{ subscription.gateway_subscription_id ?: '-' }}</code></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Gateway customer ID</td>
                                        <td><code>{{ subscription.gateway_customer_id ?: '-' }}</code></td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Account ID</td>
                                        <td>{{ subscription.account_id }}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Current period start</td>
                                        <td>{{ subscription.current_period_start ?: '-' }}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Current period end</td>
                                        <td>{{ subscription.current_period_end ?: '-' }}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Grace period (days)</td>
                                        <td>{{ subscription.grace_period_days ?? 7 }}</td>
                                    </tr>
                                    <tr>
                                        <td class="text-muted">Created</td>
                                        <td>{{ subscription.created_at }}</td>
                                    </tr>
                                    {% if subscription.cancelled_at %}
                                    <tr>
                                        <td class="text-muted">Cancelled at</td>
                                        <td>{{ subscription.cancelled_at }}</td>
                                    </tr>
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="border rounded p-3 text-center text-muted bg-light">
                            No active subscription. This tenant is on the free plan.
                        </div>
                    {% endif %}

                    {% if payment_events is not empty %}
                        <h3 class="h6 mt-4 mb-3">Recent payment events</h3>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Gateway</th>
                                    <th>Event type</th>
                                    <th>Gateway event ID</th>
                                    <th>Processed</th>
                                    <th>Created</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for event in payment_events %}
                                    <tr>
                                        <td>{{ event.id }}</td>
                                        <td>
                                            {% if event.gateway == 'paypal' %}
                                                <span class="badge bg-primary-subtle text-primary">PayPal</span>
                                            {% else %}
                                                <span class="badge bg-info-subtle text-info">MercadoPago</span>
                                            {% endif %}
                                        </td>
                                        <td><code class="bg-light px-1 rounded">{{ event.event_type }}</code></td>
                                        <td><code class="bg-light px-1 rounded" style="font-size:11px;">{{ event.gateway_event_id|length > 30 ? event.gateway_event_id[:30] ~ '...' : event.gateway_event_id }}</code></td>
                                        <td>{{ event.processed_at ?: '-' }}</td>
                                        <td>{{ event.created_at }}</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── BACKUPS TAB ── #}
        <div class="tab-pane fade" id="backups" role="tabpanel">
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-clock-history me-1"></i> Backup schedule</h2>
                    <form action="{{ path('admin_tenant_backup_frequency', {'id': tenant.id}) }}" method="post"
                          class="row g-3 align-items-end">
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <div class="col-md-4">
                            <label for="backup_frequency" class="form-label">Frequency</label>
                            <select id="backup_frequency" name="backup_frequency" class="form-select">
                                <option value="0" {{ (tenant.backup_frequency ?? 0) == 0 ? 'selected' : '' }}>Disabled</option>
                                <option value="6" {{ (tenant.backup_frequency ?? 0) == 6 ? 'selected' : '' }}>Every 6 hours</option>
                                <option value="12" {{ (tenant.backup_frequency ?? 0) == 12 ? 'selected' : '' }}>Every 12 hours</option>
                                <option value="24" {{ (tenant.backup_frequency ?? 0) == 24 ? 'selected' : '' }}>Daily</option>
                                <option value="168" {{ (tenant.backup_frequency ?? 0) == 168 ? 'selected' : '' }}>Weekly</option>
                                <option value="720" {{ (tenant.backup_frequency ?? 0) == 720 ? 'selected' : '' }}>Monthly</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label for="backup_retention_days" class="form-label">Retention</label>
                            <select id="backup_retention_days" name="backup_retention_days" class="form-select">
                                <option value="0" {{ (tenant.backup_retention_days ?? 30) == 0 ? 'selected' : '' }}>Forever</option>
                                <option value="7" {{ (tenant.backup_retention_days ?? 30) == 7 ? 'selected' : '' }}>7 days</option>
                                <option value="14" {{ (tenant.backup_retention_days ?? 30) == 14 ? 'selected' : '' }}>14 days</option>
                                <option value="30" {{ (tenant.backup_retention_days ?? 30) == 30 ? 'selected' : '' }}>30 days</option>
                                <option value="60" {{ (tenant.backup_retention_days ?? 30) == 60 ? 'selected' : '' }}>60 days</option>
                                <option value="90" {{ (tenant.backup_retention_days ?? 30) == 90 ? 'selected' : '' }}>90 days</option>
                                <option value="180" {{ (tenant.backup_retention_days ?? 30) == 180 ? 'selected' : '' }}>180 days</option>
                                <option value="365" {{ (tenant.backup_retention_days ?? 30) == 365 ? 'selected' : '' }}>1 year</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-outline-primary">Save</button>
                        </div>
                    </form>
                </div>
            </div>

            {% if binlog_summary is not empty %}
            <div class="card mb-4">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-journal-code me-1"></i> Binary log backups</h2>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Last backup</div>
                                <div class="fw-semibold">{{ binlog_summary.last_backup_at ?? 'Never' }}</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Total backups</div>
                                <div class="fw-semibold">{{ binlog_summary.total_count }}</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded p-3">
                                <div class="text-muted small">Total size</div>
                                <div class="fw-semibold">
                                    {% if binlog_summary.total_size_bytes >= 1073741824 %}
                                        {{ (binlog_summary.total_size_bytes / 1073741824)|number_format(2) }} GB
                                    {% elseif binlog_summary.total_size_bytes >= 1048576 %}
                                        {{ (binlog_summary.total_size_bytes / 1048576)|number_format(1) }} MB
                                    {% elseif binlog_summary.total_size_bytes >= 1024 %}
                                        {{ (binlog_summary.total_size_bytes / 1024)|number_format(1) }} KB
                                    {% else %}
                                        {{ binlog_summary.total_size_bytes }} B
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-text mt-2">
                        Binary logs are backed up automatically every 15 minutes to enable point-in-time recovery (PITR).
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0"><i class="bi bi-archive me-1"></i> Backups</h2>
                        <form action="{{ path('admin_tenant_backup_create', {'id': tenant.id}) }}" method="post"
                              class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="bi bi-cloud-arrow-up me-1"></i> Backup Now
                            </button>
                        </form>
                    </div>

                    {% if backups is empty %}
                        <div class="border rounded p-3 text-center text-muted bg-light">
                            No backups yet.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                <tr>
                                    <th scope="col">ID</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Filename</th>
                                    <th scope="col">Size</th>
                                    <th scope="col">Storage</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Created</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for backup in backups %}
                                    <tr>
                                        <td>{{ backup.id }}</td>
                                        <td>
                                            <span class="badge bg-info-subtle text-info text-capitalize">{{ backup.backup_type ?? 'full' }}</span>
                                        </td>
                                        <td><code class="bg-light px-1 rounded">{{ backup.filename }}</code></td>
                                        <td>
                                            {% if backup.size_bytes >= 1048576 %}
                                                {{ (backup.size_bytes / 1048576)|number_format(1) }} MB
                                            {% elseif backup.size_bytes >= 1024 %}
                                                {{ (backup.size_bytes / 1024)|number_format(1) }} KB
                                            {% else %}
                                                {{ backup.size_bytes }} B
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if backup.storage_type == 's3' %}
                                                <span class="badge bg-primary-subtle text-primary">S3</span>
                                            {% else %}
                                                <span class="badge bg-secondary-subtle text-secondary">Local</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if backup.status == 'completed' %}
                                                <span class="badge bg-success-subtle text-success">Completed</span>
                                            {% elseif backup.status == 'failed' %}
                                                <span class="badge bg-danger-subtle text-danger"
                                                      title="{{ backup.error_message }}">Failed</span>
                                            {% else %}
                                                <span class="badge bg-warning-subtle text-warning">Pending</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ backup.created_at }}</td>
                                        <td class="text-end">
                                            {% if backup.status == 'completed' %}
                                                <a href="{{ path('admin_tenant_backup_download', {'id': tenant.id, 'backupId': backup.id}) }}"
                                                   class="btn btn-outline-primary btn-sm me-1">
                                                    <i class="bi bi-download me-1"></i> Download
                                                </a>
                                                <form action="{{ path('admin_tenant_backup_restore', {'id': tenant.id, 'backupId': backup.id}) }}"
                                                      method="post" class="d-inline">
                                                    <input type="hidden" name="_token"
                                                           value="{{ csrf_token('admin') }}">
                                                    <button type="submit"
                                                            class="btn btn-outline-warning btn-sm"
                                                            onclick="return confirm('Restore tenant from backup #{{ backup.id }}? This will overwrite the current database.');">
                                                        <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                                    </button>
                                                </form>
                                            {% endif %}
                                            <form action="{{ path('admin_tenant_backup_delete', {'id': tenant.id, 'backupId': backup.id}) }}"
                                                  method="post" class="d-inline">
                                                <input type="hidden" name="_token"
                                                       value="{{ csrf_token('admin') }}">
                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Delete backup #{{ backup.id }}? This cannot be undone.');">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── USAGE TAB ── #}
        <div class="tab-pane fade" id="usage" role="tabpanel">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-graph-up me-1"></i> Usage</h2>

                    {% if quota_alerts is not empty %}
                        <div class="alert alert-warning">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            <strong>Quota alerts:</strong>
                            <ul class="mb-0 mt-1">
                                {% for alert in quota_alerts %}
                                    <li>{{ alert.resource }} at {{ alert.percent }}%</li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <div class="row g-3 mb-4">
                        {% for metric, value in usage_latest %}
                            <div class="col-md-3">
                                <div class="border rounded p-2">
                                    <div class="text-muted small text-capitalize">
                                        {% if metric == 'storage_bytes' %}
                                            DB Storage
                                        {% else %}
                                            {{ metric|replace({'_': ' '}) }}
                                        {% endif %}
                                    </div>
                                    <div class="fw-semibold">
                                        {% if metric == 'storage_bytes' %}
                                            {% if value >= 1073741824 %}
                                                {{ (value / 1073741824)|number_format(2) }} GB
                                            {% elseif value >= 1048576 %}
                                                {{ (value / 1048576)|number_format(1) }} MB
                                            {% elseif value >= 1024 %}
                                                {{ (value / 1024)|number_format(1) }} KB
                                            {% else %}
                                                {{ value }} B
                                            {% endif %}
                                        {% else %}
                                            {{ value|number_format }}
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {% if quota_summary is not empty %}
                        <h3 class="h6 mb-3">Quota usage</h3>
                        <div class="row g-3 mb-4">
                            {% for resource, usage in quota_summary %}
                                {% set limit = usage.limit %}
                                {% set current = usage.current %}
                                {% set is_storage = resource == 'storage_bytes' %}
                                <div class="col-md-6">
                                    <div class="border rounded p-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="fw-semibold text-capitalize">
                                                {% if is_storage %}
                                                    DB Storage
                                                {% else %}
                                                    {{ resource|replace({'_': ' '}) }}
                                                {% endif %}
                                            </span>
                                            {% if is_storage %}
                                                {% macro format_bytes(bytes) %}
                                                    {%- if bytes >= 1073741824 -%}
                                                        {{ (bytes / 1073741824)|number_format(2) }} GB
                                                    {%- elseif bytes >= 1048576 -%}
                                                        {{ (bytes / 1048576)|number_format(1) }} MB
                                                    {%- elseif bytes >= 1024 -%}
                                                        {{ (bytes / 1024)|number_format(1) }} KB
                                                    {%- else -%}
                                                        {{ bytes }} B
                                                    {%- endif -%}
                                                {% endmacro %}
                                                {% if limit == -1 %}
                                                    <span class="text-muted">{{ _self.format_bytes(current) }} / Unlimited</span>
                                                {% else %}
                                                    <span class="text-muted">{{ _self.format_bytes(current) }} / {{ _self.format_bytes(limit) }}</span>
                                                {% endif %}
                                            {% elseif limit == -1 %}
                                                <span class="text-muted">{{ current|number_format }} / Unlimited</span>
                                            {% else %}
                                                <span class="text-muted">{{ current|number_format }} / {{ limit|number_format }}</span>
                                            {% endif %}
                                        </div>
                                        {% if limit == -1 %}
                                            <div class="text-success small">
                                                <i class="bi bi-infinity me-1"></i> Unlimited
                                            </div>
                                        {% else %}
                                            {% set pct = limit > 0
                                                ? ((current / limit) * 100)|round(1)
                                                : 0 %}
                                            {% if pct < 60 %}
                                                {% set bar_class = 'bg-success' %}
                                            {% elseif pct < 80 %}
                                                {% set bar_class = 'bg-warning' %}
                                            {% else %}
                                                {% set bar_class = 'bg-danger' %}
                                            {% endif %}
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar {{ bar_class }}" role="progressbar"
                                                     style="width: {{ min(pct, 100) }}%"
                                                     aria-valuenow="{{ current }}" aria-valuemin="0"
                                                     aria-valuemax="{{ limit }}"></div>
                                            </div>
                                            <div class="small text-muted mt-1">{{ pct }}%</div>
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    <h3 class="h6">Changes in the last 24h</h3>
                    {% if usage_deltas is empty %}
                        <div class="text-muted">No usage data yet.</div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-sm mb-0">
                                <thead>
                                <tr>
                                    <th>Resource</th>
                                    <th class="text-end">24h ago</th>
                                    <th class="text-end">Now</th>
                                    <th class="text-end">Change</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for metric, data in usage_deltas %}
                                    {% set is_storage = metric == 'storage_bytes' %}
                                    <tr>
                                        <td class="text-capitalize">
                                            {% if is_storage %}
                                                DB Storage
                                            {% else %}
                                                {{ metric|replace({'_': ' '}) }}
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if is_storage %}
                                                {{ _self.format_bytes(data.previous) }}
                                            {% else %}
                                                {{ data.previous|number_format }}
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if is_storage %}
                                                {{ _self.format_bytes(data.current) }}
                                            {% else %}
                                                {{ data.current|number_format }}
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if data.delta > 0 %}
                                                <span class="text-success">
                                                    +{% if is_storage %}{{ _self.format_bytes(data.delta) }}{% else %}{{ data.delta|number_format }}{% endif %}
                                                </span>
                                            {% elseif data.delta < 0 %}
                                                <span class="text-danger">
                                                    {% if is_storage %}-{{ _self.format_bytes(data.delta|abs) }}{% else %}{{ data.delta|number_format }}{% endif %}
                                                </span>
                                            {% else %}
                                                <span class="text-muted">0</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script>
(function() {
    var hash = window.location.hash;
    if (hash) {
        var tab = document.querySelector('[data-bs-target="' + hash + '"]');
        if (tab) { new bootstrap.Tab(tab).show(); }
    }
    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(function(el) {
        el.addEventListener('shown.bs.tab', function(e) {
            history.replaceState(null, null, e.target.dataset.bsTarget);
        });
    });
})();
</script>
{% endblock %}
