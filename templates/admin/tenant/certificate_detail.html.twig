{% extends 'admin/base.html.twig' %}

{% block title %}Certificate {{ certificate.ruc }} - {{ tenant.name }}{% endblock %}
{% block nav_tenants %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_index') }}">Tenants</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_edit', {'id': tenant.id}) }}">{{ tenant.name }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_certificates', {'id': tenant.id}) }}">Certificates</a></li>
            <li class="breadcrumb-item active">{{ certificate.ruc }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 mb-0">Certificate {{ certificate.ruc }}</h1>
            <p class="text-muted mb-0">Operational metadata only. PEM material is not exposed.</p>
        </div>
        <a href="{{ path('admin_tenant_certificates', {'id': tenant.id}) }}" class="btn btn-outline-secondary btn-sm">
            Back to certificates
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9"><span class="badge bg-secondary-subtle text-secondary">{{ certificate.status.value }}</span></dd>
                <dt class="col-sm-3">Subject CN</dt>
                <dd class="col-sm-9">{{ certificate.subjectCn ?? '—' }}</dd>
                <dt class="col-sm-3">Issuer CN</dt>
                <dd class="col-sm-9">{{ certificate.issuerCn ?? '—' }}</dd>
                <dt class="col-sm-3">Serial</dt>
                <dd class="col-sm-9"><code>{{ certificate.serialNumber ?? '—' }}</code></dd>
                <dt class="col-sm-3">Fingerprint SHA-256</dt>
                <dd class="col-sm-9"><code>{{ certificate.fingerprintSha256 }}</code></dd>
                <dt class="col-sm-3">Valid from</dt>
                <dd class="col-sm-9">{{ certificate.validFrom|date('Y-m-d H:i') }}</dd>
                <dt class="col-sm-3">Expires at</dt>
                <dd class="col-sm-9">{{ certificate.expiresAt|date('Y-m-d H:i') }}</dd>
                <dt class="col-sm-3">Uploaded by</dt>
                <dd class="col-sm-9">{{ certificate.uploadedBy ?? '—' }} at {{ certificate.uploadedAt|date('Y-m-d H:i') }}</dd>
                <dt class="col-sm-3">Revocation</dt>
                <dd class="col-sm-9">
                    {% if certificate.revokedAt %}
                        {{ certificate.revokedBy ?? '—' }} at {{ certificate.revokedAt|date('Y-m-d H:i') }}<br>
                        <span class="text-muted">{{ certificate.revocationReason ?? 'No reason recorded' }}</span>
                    {% else %}
                        —
                    {% endif %}
                </dd>
                <dt class="col-sm-3">Superseded by</dt>
                <dd class="col-sm-9">{{ certificate.supersededById ?? '—' }}</dd>
                <dt class="col-sm-3">Last alerted</dt>
                <dd class="col-sm-9">{{ certificate.lastAlertedAt ? certificate.lastAlertedAt|date('Y-m-d H:i') : '—' }}</dd>
            </dl>
        </div>
    </div>
{% endblock %}
