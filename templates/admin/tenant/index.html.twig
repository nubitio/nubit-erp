{% extends 'admin/base.html.twig' %}

{% block title %}Tenants{% endblock %}
{% block nav_tenants %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">Tenants</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0">Create and manage tenant connections</h1>
            <p class="text-muted mb-0">Add a tenant with its database/schema name. Use short, memorable names.</p>
        </div>
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2">
            {{ tenants|length }} active {{ tenants|length == 1 ? 'tenant' : 'tenants' }}
        </span>
    </div>

    <div class="row g-4">
        {% if is_granted('ROLE_ADMIN') %}
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 mb-3"><i class="bi bi-plus-circle me-1"></i> Add tenant</h2>
                    <form action="{{ path('admin_tenant_create') }}" method="post" class="needs-validation" novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" name="name" placeholder="e.g. acme"
                                   required>
                            <div class="form-text">This is the tenant identifier used in commands and switching.</div>
                        </div>
                        <div class="mb-3">
                            <label for="connection" class="form-label">Connection</label>
                            <input type="text" class="form-control" id="connection" name="connection"
                                   placeholder="e.g. acme_db" required>
                            <div class="form-text">Database/schema name. It must exist in your DB server.</div>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary">Save tenant</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        {% endif %}
        <div class="{% if is_granted('ROLE_ADMIN') %}col-lg-8{% else %}col-lg-12{% endif %}">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Tenants</h2>
                        <span class="text-muted small">Latest first</span>
                    </div>
                    {% if tenants is empty %}
                        <div class="border rounded p-4 text-center text-muted bg-light">
                            No tenants yet. Create one on the left to get started.
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Status</th>
                                    <th scope="col">Plan</th>
                                    <th scope="col">Domain</th>
                                    <th scope="col" class="text-end">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for tenant in tenants|reverse %}
                                    <tr>
                                        <td class="fw-semibold">{{ tenant.name }}</td>
                                        <td>
                                            {% if tenant.status == 'active' %}
                                                <span class="badge bg-success-subtle text-success">Active</span>
                                            {% elseif tenant.status == 'suspended' %}
                                                <span class="badge bg-warning-subtle text-warning">Suspended</span>
                                            {% else %}
                                                <span class="badge bg-secondary">{{ tenant.status }}</span>
                                            {% endif %}
                                        </td>
                                        <td>{{ tenant.plan ?? 'free' }}</td>
                                        <td>
                                            {% if tenant.primary_domain is defined and tenant.primary_domain %}
                                                <code class="bg-light px-2 py-1 rounded">{{ tenant.primary_domain }}</code>
                                            {% else %}
                                                <span class="text-muted">-</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            {% if is_granted('ROLE_ADMIN') %}
                                            <a href="{{ path('admin_tenant_edit', {'id': tenant.id}) }}"
                                               class="btn btn-outline-secondary btn-sm me-1">
                                                <i class="bi bi-pencil me-1"></i> Edit
                                            </a>
                                            {% endif %}
                                            {% if is_granted('ROLE_SUPER_ADMIN') %}
                                            <form action="{{ path('admin_tenant_delete', {'id': tenant.id}) }}" method="post" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                                        onclick="return confirm('Delete tenant {{ tenant.name }}?');">
                                                    <i class="bi bi-trash me-1"></i> Delete
                                                </button>
                                            </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if deleted_tenants is defined and deleted_tenants is not empty %}
        <div class="mt-4">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0 text-muted">
                            <i class="bi bi-trash me-1"></i> Deleted tenants
                        </h2>
                        <span class="badge bg-secondary">{{ deleted_tenants|length }}</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                            <tr>
                                <th scope="col">Name</th>
                                <th scope="col">Connection</th>
                                <th scope="col">Deleted at</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for tenant in deleted_tenants %}
                                <tr class="table-secondary">
                                    <td class="text-muted">{{ tenant.name }}</td>
                                    <td class="text-muted">
                                        <code class="bg-light px-2 py-1 rounded">{{ tenant.connection }}</code>
                                    </td>
                                    <td class="text-muted">{{ tenant.deleted_at }}</td>
                                    <td class="text-end">
                                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                                        <form action="{{ path('admin_tenant_restore', {'id': tenant.id}) }}"
                                              method="post" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                            <button type="submit" class="btn btn-outline-success btn-sm me-1">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Restore
                                            </button>
                                        </form>
                                        <div class="d-inline js-purge-wrapper">
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm js-purge-toggle"
                                                    data-tenant-name="{{ tenant.name }}">
                                                <i class="bi bi-x-circle me-1"></i> Purge
                                            </button>
                                            <form action="{{ path('admin_tenant_purge', {'id': tenant.id}) }}"
                                                  method="post" class="d-none align-items-center gap-2 js-purge-confirm">
                                                <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                                <div class="input-group input-group-sm" style="width: 240px;">
                                                    <input type="text" class="form-control js-purge-input"
                                                           placeholder="Type '{{ tenant.name }}'" autocomplete="off">
                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm js-purge-submit" disabled>
                                                        Confirm
                                                    </button>
                                                </div>
                                                <button type="button"
                                                        class="btn btn-outline-secondary btn-sm js-purge-cancel">
                                                    Cancel
                                                </button>
                                            </form>
                                        </div>
                                        {% else %}
                                        <span class="text-muted small"><i class="bi bi-lock me-1"></i>Super Admin only</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
<script>
document.querySelectorAll('.js-purge-toggle').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var wrapper = btn.closest('.js-purge-wrapper');
        btn.classList.add('d-none');
        var form = wrapper.querySelector('.js-purge-confirm');
        form.classList.remove('d-none');
        form.classList.add('d-inline-flex');
        form.querySelector('.js-purge-input').focus();
    });
});
document.querySelectorAll('.js-purge-cancel').forEach(function(btn) {
    btn.addEventListener('click', function() {
        var wrapper = btn.closest('.js-purge-wrapper');
        wrapper.querySelector('.js-purge-toggle').classList.remove('d-none');
        var form = wrapper.querySelector('.js-purge-confirm');
        form.classList.add('d-none');
        form.classList.remove('d-inline-flex');
        form.querySelector('.js-purge-input').value = '';
        form.querySelector('.js-purge-submit').disabled = true;
    });
});
document.querySelectorAll('.js-purge-input').forEach(function(input) {
    input.addEventListener('input', function() {
        var wrapper = input.closest('.js-purge-wrapper');
        var expected = wrapper.querySelector('.js-purge-toggle').dataset.tenantName;
        wrapper.querySelector('.js-purge-submit').disabled = (input.value !== expected);
    });
});
</script>
{% endblock %}
