{% extends 'admin/base.html.twig' %}

{% block title %}Notifications · {{ tenant.name }}{% endblock %}
{% block nav_tenants %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_index') }}">Tenants</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_edit', {'id': tenant.id}) }}">{{ tenant.name }}</a></li>
            <li class="breadcrumb-item active">Notifications</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 mb-0">Notifications</h1>
            <p class="text-muted mb-0">Configure channels, recipients, and severity per event.</p>
        </div>
        <a href="{{ path('admin_tenant_edit', {'id': tenant.id}) }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to tenant
        </a>
    </div>

    <div class="alert alert-info">
        <strong>Available channels:</strong> email, bird (template), webhook.
        <br>
        <small>
            Use recipients separated by comma/new line. Optional JSON config per channel:
            `bird` supports keys like `access_key`, `workspace_id`, `channel_id`, `project_id`, `version_id`, `locale`, `parameter_map`.
            `webhook` supports `headers` object.
        </small>
    </div>

    <form method="post" action="{{ path('admin_tenant_notifications_update', {'id': tenant.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">

        {% for event_key, def in event_definitions %}
            <div class="card mb-4">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <div>
                        <strong>{{ def.label }}</strong>
                        <code class="ms-2">{{ event_key }}</code>
                    </div>
                    <span class="badge bg-secondary">{{ def.severity }}</span>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                            <tr>
                                <th style="width: 120px;">Channel</th>
                                <th style="width: 100px;">Enabled</th>
                                <th style="width: 140px;">Severity</th>
                                <th>Recipients</th>
                                <th>Config JSON</th>
                                <th style="width: 120px;">Test</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for channel in channels %}
                                {% set row = matrix[event_key][channel] %}
                                <tr>
                                    <td><code>{{ channel }}</code></td>
                                    <td>
                                        <input type="hidden" name="enabled_{{ event_key }}_{{ channel }}" value="0">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="enabled_{{ event_key }}_{{ channel }}"
                                                   value="1"
                                                {{ row.enabled ? 'checked' : '' }}>
                                        </div>
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm"
                                                name="severity_{{ event_key }}_{{ channel }}">
                                            {% for s in ['critical', 'warning', 'info'] %}
                                                <option value="{{ s }}" {{ row.severity == s ? 'selected' : '' }}>{{ s }}</option>
                                            {% endfor %}
                                        </select>
                                    </td>
                                    <td>
                                        <textarea class="form-control form-control-sm"
                                                  name="recipients_{{ event_key }}_{{ channel }}"
                                                  rows="3"
                                                  placeholder="{% if channel == 'email' %}ops@example.com, finance@example.com{% elseif channel == 'bird' %}+51999999999{% else %}https://hooks.example.com/alert{% endif %}">{{ row.recipients|join(", ") }}</textarea>
                                    </td>
                                    <td>
                                        <textarea class="form-control form-control-sm font-monospace"
                                                  name="config_{{ event_key }}_{{ channel }}"
                                                  rows="3"
                                                  placeholder='{"locale":"es"}'>{{ row.config is empty ? '' : row.config|json_encode(constant('JSON_PRETTY_PRINT')) }}</textarea>
                                    </td>
                                    <td class="text-end">
                                        <button type="submit"
                                                class="btn btn-outline-secondary btn-sm"
                                                formaction="{{ path('admin_tenant_notifications_test', {'id': tenant.id, 'event_key': event_key, 'channel': channel}) }}"
                                                formmethod="post">
                                            Test
                                        </button>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save me-1"></i> Save notification settings
            </button>
        </div>
    </form>
{% endblock %}
