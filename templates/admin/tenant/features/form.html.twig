{% extends 'admin/base.html.twig' %}

{% block title %}{{ mode == 'edit' ? 'Edit' : 'New' }} Feature Override · {{ tenant.name }}{% endblock %}
{% block nav_tenants %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_index') }}">Tenants</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_edit', {'id': tenant.id}) }}">{{ tenant.name }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_features_index', {'id': tenant.id}) }}">Feature Overrides</a></li>
            <li class="breadcrumb-item active">{{ mode == 'edit' ? 'Edit' : 'New Override' }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 mb-0">
                {% if mode == 'edit' %}
                    Edit Override: <code>{{ override.featureKey }}</code>
                {% else %}
                    New Feature Override
                {% endif %}
            </h1>
            <p class="text-muted mb-0">Tenant: <strong>{{ tenant.name }}</strong></p>
        </div>
        <a href="{{ path('admin_tenant_features_index', {'id': tenant.id}) }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to overrides
        </a>
    </div>

    <div class="row">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-body">
                    <form method="post"
                          action="{{ mode == 'edit'
                              ? path('admin_tenant_features_update', {'id': tenant.id, 'key': values.featureKey})
                              : path('admin_tenant_features_create', {'id': tenant.id}) }}"
                          novalidate>
                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">

                        {# Feature Key #}
                        <div class="mb-3">
                            <label for="featureKey" class="form-label fw-semibold">Feature Key</label>
                            {% if mode == 'edit' %}
                                <input type="text" id="featureKey" class="form-control" value="{{ values.featureKey }}" disabled>
                                <input type="hidden" name="featureKey" value="{{ values.featureKey }}">
                                <div class="form-text">Feature key cannot be changed after creation.</div>
                            {% else %}
                                <select id="featureKey" name="featureKey" class="form-select" required>
                                    <option value="">— select a feature key —</option>
                                    {% for key in feature_keys %}
                                        <option value="{{ key }}" {{ values.featureKey == key ? 'selected' : '' }}>{{ key }}</option>
                                    {% endfor %}
                                </select>
                            {% endif %}
                        </div>

                        {# Enabled #}
                        <div class="mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="isEnabled" name="isEnabled"
                                       value="1" {{ values.isEnabled ? 'checked' : '' }}>
                                <label class="form-check-label fw-semibold" for="isEnabled">Enabled</label>
                            </div>
                            <div class="form-text">
                                When checked, this feature is enabled for the tenant regardless of their plan.
                            </div>
                        </div>

                        {# Config JSON #}
                        <div class="mb-3">
                            <label for="configJson" class="form-label fw-semibold">Config JSON <span class="text-muted fw-normal">(optional)</span></label>
                            <textarea id="configJson" name="configJson" class="form-control font-monospace" rows="4"
                                      placeholder='e.g. {"requests_per_hour": 1000}'>{{ values.configJson }}</textarea>
                            <div class="form-text">
                                Valid JSON object or leave blank. Used for numeric/parametric features like
                                <code>api_rate_limit</code>, <code>retention_days</code>, <code>concurrent_sessions</code>.
                            </div>
                        </div>

                        {# Expires At #}
                        <div class="mb-3">
                            <label for="expiresAt" class="form-label fw-semibold">Expires At <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="datetime-local" id="expiresAt" name="expiresAt"
                                   class="form-control" value="{{ values.expiresAt }}">
                            <div class="form-text">
                                Leave blank for a permanent override. After this date/time the override is ignored
                                and the tenant falls back to their plan default.
                            </div>
                        </div>

                        {# Reason #}
                        <div class="mb-4">
                            <label for="reason" class="form-label fw-semibold">Reason <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="text" id="reason" name="reason" class="form-control"
                                   maxlength="255" placeholder="e.g. Trial extension, support ticket #1234"
                                   value="{{ values.reason }}">
                            <div class="form-text">Internal note for audit purposes. Not shown to the tenant.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save me-1"></i>
                                {{ mode == 'edit' ? 'Save Changes' : 'Create Override' }}
                            </button>
                            <a href="{{ path('admin_tenant_features_index', {'id': tenant.id}) }}"
                               class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">
                    <strong><i class="bi bi-info-circle me-1"></i> Feature Key Reference</strong>
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Key</th>
                                <th>Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td><code>excel_export</code></td><td class="text-muted small">Export to Excel</td></tr>
                            <tr><td><code>pdf_bulk_download</code></td><td class="text-muted small">Bulk PDF download</td></tr>
                            <tr><td><code>api_access</code></td><td class="text-muted small">REST API access</td></tr>
                            <tr><td><code>multi_warehouse</code></td><td class="text-muted small">Multiple warehouses</td></tr>
                            <tr><td><code>lot_tracking</code></td><td class="text-muted small">Lot/batch tracking</td></tr>
                            <tr><td><code>custom_branding</code></td><td class="text-muted small">Custom logo/colors</td></tr>
                            <tr><td><code>advanced_reports</code></td><td class="text-muted small">Advanced analytics</td></tr>
                            <tr><td><code>backup_download</code></td><td class="text-muted small">Download backups</td></tr>
                            <tr><td><code>sunat_auto_retry</code></td><td class="text-muted small">Auto-retry SUNAT</td></tr>
                            <tr><td><code>webhooks</code></td><td class="text-muted small">Outbound webhooks</td></tr>
                            <tr><td><code>priority_support</code></td><td class="text-muted small">Priority support SLA</td></tr>
                            <tr><td><code>api_rate_limit</code></td><td class="text-muted small">Config: <code>{"requests_per_hour": N}</code></td></tr>
                            <tr><td><code>retention_days</code></td><td class="text-muted small">Config: <code>{"days": N}</code> (-1 = unlimited)</td></tr>
                            <tr><td><code>concurrent_sessions</code></td><td class="text-muted small">Config: <code>{"max": N}</code></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            {% if mode == 'edit' and override is not null %}
                <div class="card mt-3">
                    <div class="card-header text-danger">
                        <strong><i class="bi bi-trash me-1"></i> Danger Zone</strong>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3">
                            Deleting this override will remove it permanently and invalidate the feature cache.
                            The tenant will fall back to their plan's default for this feature.
                        </p>
                        <form method="post"
                              action="{{ path('admin_tenant_features_delete', {'id': tenant.id, 'key': override.featureKey}) }}"
                              onsubmit="return confirm('Delete override for {{ override.featureKey }}? This cannot be undone.');">
                            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash me-1"></i> Delete Override
                            </button>
                        </form>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
