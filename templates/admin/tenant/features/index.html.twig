{% extends 'admin/base.html.twig' %}

{% block title %}Feature Overrides · {{ tenant.name }}{% endblock %}
{% block nav_tenants %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_index') }}">Tenants</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin_tenant_edit', {'id': tenant.id}) }}">{{ tenant.name }}</a></li>
            <li class="breadcrumb-item active">Feature Overrides</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 mb-0">Feature Overrides</h1>
            <p class="text-muted mb-0">Per-tenant overrides take priority over plan defaults. Expired overrides are ignored.</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('admin_tenant_edit', {'id': tenant.id}) }}" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to tenant
            </a>
            <a href="{{ path('admin_tenant_features_new', {'id': tenant.id}) }}" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Override
            </a>
        </div>
    </div>

    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Resolution order:</strong> Active override → Plan feature → Disabled (fail-closed).
        Overrides with an <em>Expires At</em> date are automatically ignored once they expire.
    </div>

    {% if overrides is empty %}
        <div class="card">
            <div class="card-body text-center py-5" style="background: var(--empty-bg);">
                <i class="bi bi-toggles2 fs-1 text-muted mb-3 d-block"></i>
                <p class="text-muted mb-3">No feature overrides configured for this tenant.</p>
                <a href="{{ path('admin_tenant_features_new', {'id': tenant.id}) }}" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Add first override
                </a>
            </div>
        </div>
    {% else %}
        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Feature Key</th>
                            <th style="width: 80px;">Enabled</th>
                            <th>Config JSON</th>
                            <th>Expires At</th>
                            <th style="width: 110px;">Status</th>
                            <th>Reason</th>
                            <th style="width: 130px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for override in overrides %}
                            {% if override.cleanedAt is not null %}
                                {% set status = 'cleaned' %}
                                {% set statusBadge = '<span class="badge bg-secondary-subtle text-secondary">Cleaned</span>' %}
                            {% elseif override.isExpired %}
                                {% set status = 'expired' %}
                                {% set statusBadge = '<span class="badge bg-warning-subtle text-warning">Expired</span>' %}
                            {% else %}
                                {% set status = 'active' %}
                                {% set statusBadge = '<span class="badge bg-success-subtle text-success">Active</span>' %}
                            {% endif %}
                            <tr class="{{ status == 'expired' or status == 'cleaned' ? 'opacity-75' : '' }}">
                                <td>
                                    <code>{{ override.featureKey }}</code>
                                </td>
                                <td class="text-center">
                                    {% if override.isEnabled %}
                                        <i class="bi bi-check-circle-fill text-success" title="Enabled"></i>
                                    {% else %}
                                        <i class="bi bi-x-circle-fill text-danger" title="Disabled"></i>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if override.configJson is not null %}
                                        <code class="small">{{ override.configJson|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</code>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if override.expiresAt is not null %}
                                        <span title="{{ override.expiresAt|date('Y-m-d H:i:s') }}">
                                            {{ override.expiresAt|date('Y-m-d H:i') }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">Permanent</span>
                                    {% endif %}
                                </td>
                                <td>{{ statusBadge|raw }}</td>
                                <td>
                                    {% if override.reason is not null and override.reason != '' %}
                                        <span class="text-muted small" title="{{ override.reason }}">
                                            {{ override.reason|length > 40 ? override.reason|slice(0, 40) ~ '…' : override.reason }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a href="{{ path('admin_tenant_features_edit', {'id': tenant.id, 'key': override.featureKey}) }}"
                                           class="btn btn-outline-secondary btn-sm"
                                           title="Edit override">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post"
                                              action="{{ path('admin_tenant_features_delete', {'id': tenant.id, 'key': override.featureKey}) }}"
                                              onsubmit="return confirm('Delete override for {{ override.featureKey }}? This cannot be undone.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">
                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm"
                                                    title="Delete override">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
