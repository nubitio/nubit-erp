{% extends 'admin/base.html.twig' %}

{% block title %}Edit Admin User — {{ user.username }}{% endblock %}
{% block nav_admin_users %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_user_index') }}">Admin Users</a></li>
            <li class="breadcrumb-item active">{{ user.username }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h4 mb-0">
                <i class="bi bi-person-gear me-1"></i> {{ user.username }}
            </h1>
            <p class="text-muted mb-0">Edit roles, status, and password for this admin account.</p>
        </div>
        <div>
            {% if user.is_active %}
                <span class="badge bg-success-subtle text-success fs-6">Active</span>
            {% else %}
                <span class="badge bg-secondary fs-6">Inactive</span>
            {% endif %}
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">

            {# ── Tabs ── #}
            <ul class="nav nav-tabs mb-0" id="userEditTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="info-tab" data-bs-toggle="tab"
                            data-bs-target="#tab-info" type="button" role="tab"
                            aria-controls="tab-info" aria-selected="true">
                        <i class="bi bi-person me-1"></i> General
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="password-tab" data-bs-toggle="tab"
                            data-bs-target="#tab-password" type="button" role="tab"
                            aria-controls="tab-password" aria-selected="false">
                        <i class="bi bi-key me-1"></i> Password
                    </button>
                </li>
            </ul>

            <div class="tab-content pt-0" id="userEditTabContent">

                {# ── TAB: General ── #}
                <div class="tab-pane fade show active" id="tab-info" role="tabpanel" aria-labelledby="info-tab">
                    <div class="card" style="border-top-left-radius:0; border-top-right-radius:0;">
                        <div class="card-body">
                            <form action="{{ path('admin_user_edit', {id: user.id}) }}" method="post" novalidate>
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_user') }}">

                                {# ── Username (read-only) ── #}
                                <div class="mb-3">
                                    <label class="form-label">Username</label>
                                    <input type="text" class="form-control" value="{{ user.username }}"
                                           readonly disabled aria-label="Username (read-only)">
                                    <div class="form-text">Username cannot be changed after creation.</div>
                                </div>

                                {# ── Roles ── #}
                                <div class="mb-3">
                                    <label class="form-label d-block">Roles</label>
                                    {% set currentRoles = user.roles %}
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox"
                                               name="roles[]" value="ROLE_CP_VIEWER"
                                               id="edit_role_ROLE_CP_VIEWER"
                                               {% if 'ROLE_CP_VIEWER' in currentRoles %}checked{% endif %}>
                                        <label class="form-check-label" for="edit_role_ROLE_CP_VIEWER">
                                            <span class="fw-semibold">ROLE_CP_VIEWER</span>
                                            <span class="text-muted ms-1 small">— read-only access to audit logs and dashboards</span>
                                        </label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox"
                                               name="roles[]" value="ROLE_ADMIN"
                                               id="edit_role_ROLE_ADMIN"
                                               {% if 'ROLE_ADMIN' in currentRoles %}checked{% endif %}>
                                        <label class="form-check-label" for="edit_role_ROLE_ADMIN">
                                            <span class="fw-semibold">ROLE_ADMIN</span>
                                            <span class="text-muted ms-1 small">— manage tenants, plans, and provisioning</span>
                                        </label>
                                    </div>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox"
                                               name="roles[]" value="ROLE_SUPER_ADMIN"
                                               id="edit_role_ROLE_SUPER_ADMIN"
                                               {% if 'ROLE_SUPER_ADMIN' in currentRoles %}checked{% endif %}>
                                        <label class="form-check-label" for="edit_role_ROLE_SUPER_ADMIN">
                                            <span class="fw-semibold text-danger">ROLE_SUPER_ADMIN</span>
                                            <span class="text-muted ms-1 small">— full access including admin user management</span>
                                        </label>
                                    </div>
                                </div>

                                {# ── Active status ── #}
                                <div class="mb-4">
                                    {% set isSelf = app.user and app.user.userIdentifier == user.username %}
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch"
                                               id="is_active" name="is_active" value="1"
                                               {% if user.is_active %}checked{% endif %}
                                               {% if isSelf %}disabled aria-disabled="true"{% endif %}>
                                        <label class="form-check-label" for="is_active">Active</label>
                                    </div>
                                    {% if isSelf %}
                                        <div class="form-text text-warning">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            You cannot deactivate your own account.
                                        </div>
                                    {% else %}
                                        <div class="form-text">Inactive users cannot log in.</div>
                                    {% endif %}
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check2 me-1"></i> Save Changes
                                    </button>
                                    <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary">Cancel</a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                {# ── TAB: Password ── #}
                <div class="tab-pane fade" id="tab-password" role="tabpanel" aria-labelledby="password-tab">
                    <div class="card" style="border-top-left-radius:0; border-top-right-radius:0;">
                        <div class="card-body">
                            <p class="text-muted small mb-3">
                                <i class="bi bi-info-circle me-1"></i>
                                Setting a new password for <strong>{{ user.username }}</strong> will immediately invalidate the current one.
                            </p>
                            <form action="{{ path('admin_user_reset_password', {id: user.id}) }}" method="post"
                                  novalidate id="reset-pw-form">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_user') }}">

                                {# ── New password ── #}
                                <div class="mb-3">
                                    <label for="new_password" class="form-label">New Password</label>
                                    <input type="password" class="form-control" id="new_password" name="password"
                                           required minlength="12" autocomplete="new-password"
                                           aria-describedby="newPwHelp newPwStrengthText">
                                    <div class="mt-2" id="new-pw-strength-bar" style="display:none;" aria-hidden="true">
                                        <div class="progress">
                                            <div class="progress-bar" id="new-strength-bar" role="progressbar"
                                                 style="width:0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                    <div class="form-text" id="newPwStrengthText"></div>
                                    <div class="form-text" id="newPwHelp">Minimum 12 characters.</div>
                                </div>

                                {# ── Confirm password ── #}
                                <div class="mb-4">
                                    <label for="confirm_new_password" class="form-label">Confirm New Password</label>
                                    <input type="password" class="form-control" id="confirm_new_password"
                                           required minlength="12" autocomplete="new-password"
                                           aria-describedby="confirmNewPwHelp">
                                    <div class="form-text text-danger d-none" id="confirmNewPwHelp">
                                        Passwords do not match.
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-outline-danger"
                                        id="reset-pw-submit">
                                    <i class="bi bi-shield-lock me-1"></i> Change Password
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

            </div>{# /tab-content #}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
<script nonce="{{ csp_nonce() }}">
(function () {
    /* ── Activate "Password" tab if URL hash is #password ── */
    if (window.location.hash === '#password') {
        var pwTab = document.getElementById('password-tab');
        if (pwTab) { pwTab.click(); }
    }

    /* ── Password strength helper ── */
    function scorePassword(pw) {
        var score = 0;
        if (pw.length >= 12) score += 25;
        if (pw.length >= 16) score += 15;
        if (/[A-Z]/.test(pw)) score += 15;
        if (/[0-9]/.test(pw)) score += 15;
        if (/[^A-Za-z0-9]/.test(pw)) score += 20;
        if (pw.length >= 20) score += 10;
        return Math.min(score, 100);
    }

    function strengthLabel(score) {
        if (score < 30) return { label: 'Very weak', cls: 'bg-danger' };
        if (score < 50) return { label: 'Weak',      cls: 'bg-warning' };
        if (score < 70) return { label: 'Fair',       cls: 'bg-info' };
        if (score < 90) return { label: 'Strong',     cls: 'bg-primary' };
        return              { label: 'Very strong', cls: 'bg-success' };
    }

    function wirePasswordStrength(pwdId, barWrapperId, barId, textId, confirmId, confirmHelpId, formId) {
        var pwdInput     = document.getElementById(pwdId);
        var barWrapper   = document.getElementById(barWrapperId);
        var bar          = document.getElementById(barId);
        var text         = document.getElementById(textId);
        var confirmInput = document.getElementById(confirmId);
        var confirmHelp  = document.getElementById(confirmHelpId);
        var form         = formId ? document.getElementById(formId) : null;

        if (!pwdInput) { return; }

        function checkConfirm() {
            if (!confirmInput || !confirmInput.value) {
                if (confirmHelp) { confirmHelp.classList.add('d-none'); }
                if (confirmInput) { confirmInput.setCustomValidity(''); }
                return;
            }
            if (confirmInput.value !== pwdInput.value) {
                if (confirmHelp) { confirmHelp.classList.remove('d-none'); }
                confirmInput.setCustomValidity('Passwords do not match.');
            } else {
                if (confirmHelp) { confirmHelp.classList.add('d-none'); }
                confirmInput.setCustomValidity('');
            }
        }

        pwdInput.addEventListener('input', function () {
            var pw = pwdInput.value;
            if (!pw) {
                barWrapper.style.display = 'none';
                text.textContent = '';
                return;
            }
            barWrapper.style.display = 'block';
            var score = scorePassword(pw);
            var info  = strengthLabel(score);
            bar.style.width = score + '%';
            bar.setAttribute('aria-valuenow', score);
            bar.className   = 'progress-bar ' + info.cls;
            text.textContent = info.label;
            text.className   = 'form-text ' + (score < 50 ? 'text-danger' : 'text-muted');
            checkConfirm();
        });

        if (confirmInput) {
            confirmInput.addEventListener('input', checkConfirm);
        }

        if (form) {
            form.addEventListener('submit', function (e) {
                checkConfirm();
                if (!form.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
            });
        }
    }

    wirePasswordStrength(
        'new_password',
        'new-pw-strength-bar',
        'new-strength-bar',
        'newPwStrengthText',
        'confirm_new_password',
        'confirmNewPwHelp',
        'reset-pw-form'
    );

    /* ── Confirm before password reset ── */
    var resetForm = document.getElementById('reset-pw-form');
    if (resetForm) {
        resetForm.addEventListener('submit', function (e) {
            var username = '{{ user.username|e('js') }}';
            if (!confirm('Reset password for "' + username + '"?\nThis will immediately invalidate the current password.')) {
                e.preventDefault();
            }
        });
    }
})();
</script>
{% endblock %}
