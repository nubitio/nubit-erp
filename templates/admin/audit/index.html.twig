{% extends 'admin/base.html.twig' %}

{% block title %}Audit Log{% endblock %}
{% block nav_audit %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item active">Audit Log</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0">Audit Log</h1>
            <p class="text-muted mb-0">{{ total }} total entries</p>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label for="action" class="form-label">Action</label>
                    <select class="form-select" id="action" name="action">
                        <option value="">All actions</option>
                        {% for act in actions %}
                            <option value="{{ act }}"
                                {{ filters.action == act ? 'selected' : '' }}>
                                {{ act }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="date_from" class="form-label">From</label>
                    <input type="date" class="form-control" id="date_from" name="date_from"
                           value="{{ filters.date_from }}">
                </div>
                <div class="col-md-3">
                    <label for="date_to" class="form-label">To</label>
                    <input type="date" class="form-control" id="date_to" name="date_to"
                           value="{{ filters.date_to }}">
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a href="{{ path('admin_audit_log_index') }}" class="btn btn-outline-secondary">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            {% if logs is empty %}
                <div class="border rounded p-4 text-center text-muted bg-light">
                    No audit log entries found.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>Actor</th>
                            <th>Channel</th>
                            <th>Tenant</th>
                            <th>Metadata</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for log in logs %}
                            <tr>
                                <td class="text-nowrap">{{ log.created_at }}</td>
                                <td><code>{{ log.action }}</code></td>
                                <td>{{ log.actor ?? '-' }}</td>
                                <td>{{ log.channel ?? '-' }}</td>
                                <td>{{ log.tenant_name ?? '-' }}</td>
                                <td>
                                    {% set meta = log.metadata %}
                                    <small class="text-muted text-break"
                                           style="max-width:300px;display:inline-block;">
                                        {{ meta|length > 120 ? meta|slice(0, 120) ~ '...' : meta }}
                                    </small>
                                    {% if meta|length > 2 %}
                                        <button type="button" class="btn btn-link btn-sm p-0 ms-1"
                                                data-bs-toggle="modal" data-bs-target="#metadataModal"
                                                data-metadata="{{ meta|e('html_attr') }}">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if total_pages > 1 %}
                    <nav class="mt-3" aria-label="Audit log pages">
                        <ul class="pagination pagination-sm justify-content-center mb-0">
                            <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
                                <a class="page-link"
                                   href="{{ path('admin_audit_log_index', filters|merge({page: page - 1})) }}">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            {% for p in range(max(1, page - 3), min(total_pages, page + 3)) %}
                                <li class="page-item {{ p == page ? 'active' : '' }}">
                                    <a class="page-link"
                                       href="{{ path('admin_audit_log_index', filters|merge({page: p})) }}">
                                        {{ p }}
                                    </a>
                                </li>
                            {% endfor %}
                            <li class="page-item {{ page >= total_pages ? 'disabled' : '' }}">
                                <a class="page-link"
                                   href="{{ path('admin_audit_log_index', filters|merge({page: page + 1})) }}">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                {% endif %}
            {% endif %}
        </div>
    </div>

    <div class="modal fade" id="metadataModal" tabindex="-1" aria-labelledby="metadataModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="metadataModalLabel">Metadata</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <pre id="metadataContent" class="mb-0 json-highlight"
                         style="white-space:pre-wrap;word-break:break-word;max-height:60vh;overflow-y:auto;background:var(--code-bg);padding:1rem;border-radius:8px;font-size:0.8rem;"></pre>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
<style>
    .json-highlight .json-key { color: #6366f1; }
    .json-highlight .json-string { color: #16a34a; }
    .json-highlight .json-number { color: #d97706; }
    .json-highlight .json-bool { color: #dc2626; }
    .json-highlight .json-null { color: #9ca3af; }
    [data-theme="dark"] .json-highlight .json-key { color: #a5b4fc; }
    [data-theme="dark"] .json-highlight .json-string { color: #86efac; }
    [data-theme="dark"] .json-highlight .json-number { color: #fcd34d; }
    [data-theme="dark"] .json-highlight .json-bool { color: #fca5a5; }
    [data-theme="dark"] .json-highlight .json-null { color: #64748b; }
    [data-theme="dark"] .modal-content {
        background-color: var(--card-bg);
        color: var(--text-primary);
        border-color: var(--border-color);
    }
    [data-theme="dark"] .modal-header {
        border-bottom-color: var(--border-color);
    }
</style>
{% endblock %}

{% block javascripts %}
<script>
function highlightJson(json) {
    var escaped = json.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    return escaped.replace(
        /("(?:\\.|[^"\\])*")\s*:/g,
        '<span class="json-key">$1</span>:'
    ).replace(
        /:\s*("(?:\\.|[^"\\])*")/g,
        function(m, str) { return ': <span class="json-string">' + str + '</span>'; }
    ).replace(
        /:\s*(-?\d+(?:\.\d+)?(?:[eE][+-]?\d+)?)/g,
        ': <span class="json-number">$1</span>'
    ).replace(
        /:\s*(true|false)/g,
        ': <span class="json-bool">$1</span>'
    ).replace(
        /:\s*(null)/g,
        ': <span class="json-null">$1</span>'
    );
}

document.getElementById('metadataModal').addEventListener('show.bs.modal', function(event) {
    var raw = event.relatedTarget.getAttribute('data-metadata');
    try {
        var formatted = JSON.stringify(JSON.parse(raw), null, 2);
        document.getElementById('metadataContent').innerHTML = highlightJson(formatted);
    } catch (e) {
        document.getElementById('metadataContent').textContent = raw;
    }
});
</script>
{% endblock %}
