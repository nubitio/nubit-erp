{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard{% endblock %}
{% block nav_dashboard %}active{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-0">Dashboard</h1>
            <p class="text-muted mb-0">System overview and key metrics.</p>
        </div>
    </div>

    {# ── Tenant Stats ── #}
    <h2 class="h6 text-uppercase text-muted mb-3">Tenants</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total</p>
                    <p class="display-6 mb-0">{{ tenant_stats.total }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Active</p>
                    <p class="display-6 mb-0 text-success">{{ tenant_stats.active }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Suspended</p>
                    <p class="display-6 mb-0 text-warning">{{ tenant_stats.suspended }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <p class="text-muted small mb-1">Deleted</p>
                    <p class="display-6 mb-0 text-danger">{{ tenant_stats.deleted }}</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        {# ── Plan Stats ── #}
        <div class="col-md-6">
            <h2 class="h6 text-uppercase text-muted mb-3">Plans</h2>
            <div class="row g-3">
                <div class="col-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Total plans</p>
                            <p class="display-6 mb-0">{{ plan_stats.total_plans }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Without plan</p>
                            <p class="display-6 mb-0 {{ plan_stats.tenants_without_plan > 0 ? 'text-warning' : '' }}">
                                {{ plan_stats.tenants_without_plan }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── Backup Stats ── #}
        <div class="col-md-6">
            <h2 class="h6 text-uppercase text-muted mb-3">Backups</h2>
            <div class="row g-3">
                <div class="col-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Completed</p>
                            <p class="display-6 mb-0">{{ backup_stats.total_backups }}</p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Failed</p>
                            <p class="display-6 mb-0 {{ backup_stats.failed_count > 0 ? 'text-danger' : '' }}">
                                {{ backup_stats.failed_count }}
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Total size</p>
                            <p class="fw-semibold mb-0">
                                {% if backup_stats.total_size_bytes >= 1073741824 %}
                                    {{ (backup_stats.total_size_bytes / 1073741824)|number_format(2) }} GB
                                {% elseif backup_stats.total_size_bytes >= 1048576 %}
                                    {{ (backup_stats.total_size_bytes / 1048576)|number_format(1) }} MB
                                {% else %}
                                    {{ (backup_stats.total_size_bytes / 1024)|number_format(1) }} KB
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card h-100">
                        <div class="card-body">
                            <p class="text-muted small mb-1">Last backup</p>
                            <p class="fw-semibold mb-0">
                                {{ backup_stats.last_backup_at ?? 'Never' }}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Audit Summary ── #}
    <h2 class="h6 text-uppercase text-muted mb-3">Audit activity (last 24h)</h2>
    <div class="card">
        <div class="card-body">
            {% if audit_summary is empty %}
                <div class="border rounded p-3 text-center text-muted bg-light">
                    No audit activity in the last 24 hours.
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                        <tr>
                            <th>Action</th>
                            <th class="text-end">Count</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for row in audit_summary %}
                            <tr>
                                <td><code class="bg-light px-1 rounded">{{ row.action }}</code></td>
                                <td class="text-end">{{ row.count }}</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
