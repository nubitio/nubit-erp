{% extends 'admin/base.html.twig' %}

{% block title %}Plan Features{% endblock %}
{% block nav_plans %}active{% endblock %}

{% block breadcrumbs %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_plan_index') }}">Plans</a></li>
            <li class="breadcrumb-item active">Feature Matrix</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-0">Plan Feature Matrix</h1>
            <p class="text-muted mb-0">
                Toggle features per plan. Each cell is saved immediately on submit.
                Active tenant overrides always take priority over these defaults.
            </p>
        </div>
        <a href="{{ path('admin_plan_index') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Plans
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-1"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% if plans is empty %}
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-grid-3x3 fs-1 text-muted mb-3 d-block"></i>
                <p class="text-muted mb-3">No plans found. Create a plan first.</p>
                <a href="{{ path('admin_plan_index') }}" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i> Go to Plans
                </a>
            </div>
        </div>
    {% else %}

    <div class="alert alert-info py-2 small">
        <i class="bi bi-info-circle me-1"></i>
        <strong>Config features</strong> (<code>api_rate_limit</code>, <code>retention_days</code>, <code>concurrent_sessions</code>)
        include a JSON config field. Leave it empty to store <code>null</code>.
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0" style="min-width: {{ 220 + plans|length * 220 }}px;">
                <thead class="table-light">
                    <tr>
                        <th style="width: 220px;">Feature</th>
                        {% for plan in plans %}
                            <th class="text-center" style="width: 220px;">
                                <span class="fw-semibold">{{ plan.name }}</span>
                                {% if plan.is_default %}
                                    <span class="badge text-bg-primary ms-1">Default</span>
                                {% endif %}
                            </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                    {% for featureKey in feature_keys %}
                        {% set isConfigFeature = featureKey in config_feature_keys %}
                        <tr>
                            {# Feature label column #}
                            <td class="py-2">
                                <code class="small">{{ featureKey }}</code>
                                {% if isConfigFeature %}
                                    <span class="badge text-bg-secondary ms-1" title="Carries a JSON config payload">config</span>
                                {% endif %}
                            </td>

                            {# One cell per plan #}
                            {% for plan in plans %}
                                {% set planFeature = matrix[featureKey][plan.name] ?? null %}
                                {% set currentEnabled = planFeature ? planFeature.isEnabled() : false %}
                                {% set currentConfig  = planFeature and planFeature.configJson is not null
                                    ? planFeature.configJson|json_encode(constant('JSON_PRETTY_PRINT'))
                                    : '' %}

                                <td class="py-2 px-3 {{ currentEnabled ? 'table-success' : '' }}" style="vertical-align: top;">
                                    <form
                                        method="post"
                                        action="{{ path('admin_plan_features_update', {planName: plan.name, featureKey: featureKey}) }}"
                                        class="d-flex flex-column gap-2"
                                    >
                                        <input type="hidden" name="_token" value="{{ csrf_token('admin') }}">

                                        {# Toggle row #}
                                        <div class="form-check form-switch mb-0">
                                            <input
                                                class="form-check-input"
                                                type="checkbox"
                                                role="switch"
                                                name="is_enabled"
                                                value="1"
                                                id="toggle_{{ plan.name }}_{{ featureKey }}"
                                                {{ currentEnabled ? 'checked' : '' }}
                                            >
                                            <label
                                                class="form-check-label small {{ currentEnabled ? 'fw-semibold text-success' : 'text-muted' }}"
                                                for="toggle_{{ plan.name }}_{{ featureKey }}"
                                            >
                                                {{ currentEnabled ? 'Enabled' : 'Disabled' }}
                                            </label>
                                        </div>

                                        {# Config textarea — only for config features #}
                                        {% if isConfigFeature %}
                                            <textarea
                                                name="config_json"
                                                class="form-control form-control-sm font-monospace"
                                                rows="2"
                                                placeholder='e.g. {"days": 365}'
                                                style="font-size: 0.75rem; resize: vertical;"
                                            >{{ currentConfig }}</textarea>
                                        {% endif %}

                                        <button type="submit" class="btn btn-outline-primary btn-sm w-100">
                                            <i class="bi bi-floppy me-1"></i>Save
                                        </button>
                                    </form>
                                </td>
                            {% endfor %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% endif %}
{% endblock %}
