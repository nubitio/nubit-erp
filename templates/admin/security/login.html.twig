<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>eFact — Mini ERP · Control Plane</title>
    <link rel="stylesheet" href="{{ asset('themes/app-theme-light.css') }}">
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script nonce="{{ csp_nonce() }}">
    (function() {
        var storageKey = 'cp-theme';
        var themePrefix = 'app-theme-';
        var basePath = '/themes/';
        var modes = ['light', 'dark', 'auto'];

        function getMode() {
            var stored = localStorage.getItem(storageKey);
            return modes.indexOf(stored) >= 0 ? stored : 'auto';
        }

        function resolveTheme(mode) {
            if (mode === 'auto') {
                return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            return mode;
        }

        function ensureThemeCss(theme) {
            var id = 'cp-login-theme-css';
            var existing = document.getElementById(id);
            var href = basePath + themePrefix + theme + '.css';
            if (existing) {
                if (existing.getAttribute('href') !== href) {
                    existing.setAttribute('href', href);
                }
                return;
            }
            var link = document.createElement('link');
            link.id = id;
            link.rel = 'stylesheet';
            link.href = href;
            document.head.appendChild(link);
        }

        function applyMode(mode) {
            var theme = resolveTheme(mode);
            document.documentElement.setAttribute('data-theme', theme);
            ensureThemeCss(theme);
            var icon = document.querySelector('#themeToggle i');
            if (icon) {
                icon.className = {
                    light: 'ph ph-sun',
                    dark: 'ph ph-moon-stars',
                    auto: 'ph ph-circle-half'
                }[mode] || 'ph ph-circle-half';
            }
        }

        window.__cpLoginTheme = {
            getMode: getMode,
            applyMode: applyMode,
            cycle: function() {
                var current = getMode();
                var next = modes[(modes.indexOf(current) + 1) % modes.length];
                localStorage.setItem(storageKey, next);
                applyMode(next);
            }
        };

        applyMode(getMode());
    })();
    </script>
    <style>
        body {
            margin: 0;
            font-family: 'Inter', system-ui, sans-serif;
            background: var(--surface-0, #f5f6f8);
            color: var(--text-primary, #111827);
            min-height: 100vh;
            display: grid;
            place-items: center;
            transition: background 0.2s ease, color 0.2s ease;
        }

        .cp-login {
            width: min(420px, 100%);
            padding: 1.5rem;
        }

        .cp-login__brand {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            justify-content: center;
            margin-bottom: 2rem;
            text-decoration: none;
            color: inherit;
        }

        .cp-login__brand-icon {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: var(--accent-color, #1a6fd4);
            color: var(--on-accent-color, #fff);
            display: grid;
            place-items: center;
            font-size: 1.25rem;
        }

        .cp-login__brand-title {
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.02em;
        }

        .cp-login__brand-sub {
            font-size: 0.7rem;
            color: var(--text-secondary, #4a5568);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        .cp-login__card {
            background: var(--surface-1, #fff);
            border: 1px solid var(--border-subtle, #e8ecf4);
            border-radius: 12px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
            overflow: hidden;
        }

        .cp-login__card-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--border-subtle, #e8ecf4);
            font-size: 1rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .cp-login__card-header i {
            color: var(--accent-color, #1a6fd4);
        }

        .cp-login__card-body {
            padding: 1.5rem;
        }

        .cp-login__alert {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            border-radius: 8px;
            border: 1px solid color-mix(in srgb, var(--error-color, #dc2626) 35%, var(--border-color));
            background: color-mix(in srgb, var(--error-color, #dc2626) 8%, var(--surface-1));
            color: var(--error-color, #dc2626);
            font-size: 0.875rem;
        }

        .cp-login__field {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
            margin-bottom: 1rem;
        }

        .cp-login__label {
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--text-secondary, #4a5568);
        }

        .cp-login__input-wrap {
            display: flex;
            align-items: center;
            gap: 0;
            border: 1px solid var(--border-color, #d7deea);
            border-radius: 8px;
            background: var(--surface-1, #fff);
            overflow: hidden;
        }

        .cp-login__input-wrap:focus-within {
            border-color: var(--accent-color, #1a6fd4);
            box-shadow: 0 0 0 3px var(--accent-subtle, rgba(26, 111, 212, 0.12));
        }

        .cp-login__input-icon {
            padding: 0 0.75rem;
            color: var(--text-tertiary, #7c8a9e);
        }

        .cp-login__input {
            flex: 1;
            border: none;
            outline: none;
            padding: 0.625rem 0.75rem 0.625rem 0;
            font: inherit;
            font-size: 0.875rem;
            background: transparent;
            color: var(--text-primary, #111827);
        }

        .cp-login__check {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
            font-size: 0.875rem;
            color: var(--text-secondary, #4a5568);
        }

        .cp-login__submit {
            width: 100%;
            border: none;
            border-radius: 8px;
            padding: 0.65rem 1rem;
            font: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            cursor: pointer;
            background: var(--accent-color, #1a6fd4);
            color: var(--on-accent-color, #fff);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            transition: background 0.15s ease;
        }

        .cp-login__submit:hover {
            background: var(--accent-hover, #1456a8);
        }

        .cp-login__footer {
            margin-top: 1rem;
            text-align: center;
            font-size: 0.75rem;
            color: var(--text-tertiary, #7c8a9e);
        }

        .cp-login__theme-btn {
            position: fixed;
            top: 1rem;
            right: 1rem;
            background: var(--surface-1, #fff);
            border: 1px solid var(--border-color, #d7deea);
            border-radius: 8px;
            color: var(--text-secondary, #4a5568);
            padding: 0.45rem 0.6rem;
            font-size: 1rem;
            cursor: pointer;
            line-height: 1;
        }

        .cp-login__theme-btn:hover {
            color: var(--text-primary, #111827);
            border-color: var(--accent-color, #1a6fd4);
        }
    </style>
</head>
<body>

<button type="button" class="cp-login__theme-btn" id="themeToggle" aria-label="Cambiar tema">
    <i class="ph ph-moon-stars" aria-hidden="true"></i>
</button>

<div class="cp-login">
    <a href="#" class="cp-login__brand" tabindex="-1" aria-hidden="true">
        <span class="cp-login__brand-icon" aria-hidden="true">
            <i class="ph ph-receipt"></i>
        </span>
        <span>
            <span class="cp-login__brand-title">eFact</span>
            <span class="cp-login__brand-sub">Mini ERP · Control Plane</span>
        </span>
    </a>

    <div class="cp-login__card">
        <div class="cp-login__card-header">
            <i class="ph ph-lock" aria-hidden="true"></i>
            Iniciar sesión
        </div>
        <div class="cp-login__card-body">
            {% if error %}
                <div class="cp-login__alert" role="alert">
                    <i class="ph ph-warning-circle" aria-hidden="true"></i>
                    <span>{{ error.messageKey | trans({}, 'security') }}</span>
                </div>
            {% endif %}

            <form method="POST" action="{{ path('admin_login') }}" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <label class="cp-login__field" for="username">
                    <span class="cp-login__label">Usuario</span>
                    <span class="cp-login__input-wrap">
                        <span class="cp-login__input-icon"><i class="ph ph-user" aria-hidden="true"></i></span>
                        <input
                            type="text"
                            id="username"
                            name="username"
                            class="cp-login__input"
                            value="{{ last_username }}"
                            autocomplete="username"
                            autofocus
                            required
                            aria-label="Nombre de usuario"
                        >
                    </span>
                </label>

                <label class="cp-login__field" for="password">
                    <span class="cp-login__label">Contraseña</span>
                    <span class="cp-login__input-wrap">
                        <span class="cp-login__input-icon"><i class="ph ph-key" aria-hidden="true"></i></span>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="cp-login__input"
                            autocomplete="current-password"
                            required
                            aria-label="Contraseña"
                        >
                    </span>
                </label>

                <label class="cp-login__check" for="remember_me">
                    <input type="checkbox" id="remember_me" name="_remember_me" value="1">
                    Recordar sesión (7 días)
                </label>

                <button type="submit" class="cp-login__submit">
                    <i class="ph ph-sign-in" aria-hidden="true"></i>
                    Iniciar sesión
                </button>
            </form>
        </div>
    </div>

    <p class="cp-login__footer">eFact Mini ERP — Acceso restringido</p>
</div>

<script nonce="{{ csp_nonce() }}">
(function() {
    var btn = document.getElementById('themeToggle');
    if (!btn || !window.__cpLoginTheme) return;
    btn.addEventListener('click', function() {
        window.__cpLoginTheme.cycle();
    });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
        if (window.__cpLoginTheme.getMode() === 'auto') {
            window.__cpLoginTheme.applyMode('auto');
        }
    });
})();
</script>
</body>
</html>