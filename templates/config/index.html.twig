{% extends 'layout/base.html.twig' %}
{% block title %}Config{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const config = new window.app.config('wrapper');
            config.render();
        });
    </script>
{% endblock %}