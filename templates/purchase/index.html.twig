{% extends 'layout/base.html.twig' %}
{% block title %}Purchase{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const purchase = new window.app.purchase('wrapper');
            purchase.render();
        });
    </script>
{% endblock %}