{% extends 'layout/base.html.twig' %}
{% block title %}Customer{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const customer = new window.app.customer('wrapper');
            customer.render();
        });
    </script>
{% endblock %}