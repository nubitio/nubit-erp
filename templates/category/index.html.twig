{% extends 'layout/base.html.twig' %}
{% block title %}Category{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const category = new window.app.category('wrapper');
            category.render();
        });
    </script>
{% endblock %}