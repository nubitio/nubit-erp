{% extends 'layout/base.html.twig' %}
{% block title %}Unit{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const unit = new window.app.unit('wrapper');
            unit.render();
        });
    </script>
{% endblock %}