{% extends 'layout/base.html.twig' %}
{% block title %}Inbound{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const inbound = new window.app.inbound('wrapper');
            inbound.render();
        });
    </script>
{% endblock %}