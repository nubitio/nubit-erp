{% extends 'onboarding/base.html.twig' %}

{% block title %}Crear empresa | eFact{% endblock %}
{% block card_class %}onboarding-card--wide{% endblock %}

{% block head %}
    <style>
        .billing-toggle {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 16px;
            background: var(--color-gray-100);
            border: 1px solid var(--color-gray-200);
            border-radius: var(--radius);
            padding: 4px;
        }
        .billing-toggle-btn {
            flex: 1;
            padding: 8px 16px;
            border: none;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            background: transparent;
            color: var(--color-gray-500);
            transition: all .15s;
            text-align: center;
        }
        .billing-toggle-btn--active {
            background: var(--color-surface-elevated);
            color: var(--color-gray-800);
            border: 1px solid var(--color-gray-300);
            box-shadow: 0 1px 2px rgba(0,0,0,.16);
        }
        .billing-savings {
            display: inline-block;
            background: var(--color-success-light);
            color: var(--color-success);
            font-size: 11px;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 4px;
            margin-left: 4px;
        }
        .plan-card-price-monthly, .plan-card-price-annual { display: none; }
        .plan-card-price-monthly.visible, .plan-card-price-annual.visible { display: block; }
        .plan-card-old-price {
            text-decoration: line-through;
            color: var(--color-gray-400);
            font-size: 12px;
        }
        .password-field {
            position: relative;
        }
        .password-field .form-input { padding-right: 42px; }
        .password-visibility-btn {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: var(--color-gray-500);
            cursor: pointer;
            padding: 2px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .password-visibility-btn:hover { color: var(--color-gray-700); }
    </style>
{% endblock %}

{% block steps %}
    <div class="steps">
        <div class="step step--done">
            <div class="step-dot">&#10003;</div>
            <div class="step-label">Cuenta</div>
        </div>
        <div class="step-line"></div>
        <div class="step step--done">
            <div class="step-dot">&#10003;</div>
            <div class="step-label">Verificar</div>
        </div>
        <div class="step-line"></div>
        <div class="step step--active">
            <div class="step-dot">3</div>
            <div class="step-label">Empresa</div>
        </div>
    </div>
{% endblock %}

{% block content %}
    <h1>Configura tu empresa</h1>
    <p class="subtitle">Conectado como <strong>{{ account.email }}</strong></p>

    <form method="post" action="{{ path('onboarding_provision') }}" id="wizard-form">
        <input type="hidden" name="_token" value="{{ csrf_token('onboarding_wizard') }}">
        <input type="hidden" name="billing_cycle" id="billing_cycle" value="monthly">

        <div class="form-group">
            <label class="form-label" for="tenant_name">Nombre de la empresa</label>
            <input type="text" name="tenant_name" id="tenant_name" class="form-input"
                   value="{{ tenant_name|default('') }}" placeholder="Mi Empresa S.A.C." required autofocus>
        </div>

        <div class="form-group">
            <label class="form-label" for="subdomain">Subdominio</label>
            <div class="subdomain-preview">
                <input type="text" name="subdomain" id="subdomain"
                       value="{{ subdomain|default('') }}" placeholder="miempresa" required>
                <span class="subdomain-suffix" id="subdomain-suffix">.efact.app</span>
            </div>
            <p class="form-hint" id="subdomain-feedback">&nbsp;</p>
        </div>

        <div class="form-group">
            <label class="form-label">Plan</label>

            <div class="billing-toggle" id="billing-toggle">
                <button type="button" class="billing-toggle-btn billing-toggle-btn--active" data-cycle="monthly">Mensual</button>
                <button type="button" class="billing-toggle-btn" data-cycle="annual">Anual <span class="billing-savings">2 meses gratis</span></button>
            </div>

            <div class="plan-cards" id="plan-cards">
                <label class="plan-card plan-card--selected">
                    <input type="radio" name="plan" value="free" checked>
                    <div class="plan-card-name">Free</div>
                    <div class="plan-card-price-monthly visible">Gratis</div>
                    <div class="plan-card-price-annual">Gratis</div>
                    <div class="plan-card-price" style="font-size:12px;color:var(--color-gray-500);margin-top:2px;">3 usuarios, 500 facturas/mes</div>
                </label>
                <label class="plan-card">
                    <input type="radio" name="plan" value="basic">
                    <div class="plan-card-name">Basic</div>
                    <div class="plan-card-price-monthly visible">S/ 29.90/mes</div>
                    <div class="plan-card-price-annual"><span class="plan-card-old-price">S/ 358.80</span> S/ 299/a&ntilde;o</div>
                    <div class="plan-card-price" style="font-size:12px;color:var(--color-gray-500);margin-top:2px;">10 usuarios, 5000 facturas/mes</div>
                </label>
                <label class="plan-card">
                    <input type="radio" name="plan" value="pro">
                    <div class="plan-card-name">Pro</div>
                    <div class="plan-card-price-monthly visible">S/ 79.90/mes</div>
                    <div class="plan-card-price-annual"><span class="plan-card-old-price">S/ 958.80</span> S/ 799/a&ntilde;o</div>
                    <div class="plan-card-price" style="font-size:12px;color:var(--color-gray-500);margin-top:2px;">Usuarios ilimitados</div>
                </label>
            </div>
        </div>

        <div class="form-group" id="gateway-group" style="display:none;">
            <label class="form-label">Medio de pago</label>
            <div class="plan-cards" id="gateway-cards">
                <label class="plan-card plan-card--selected">
                    <input type="radio" name="gateway" value="paypal" checked>
                    <div class="plan-card-name">PayPal</div>
                    <div class="plan-card-price">Tarjeta o cuenta PayPal</div>
                </label>
                <label class="plan-card">
                    <input type="radio" name="gateway" value="mercadopago">
                    <div class="plan-card-name">MercadoPago</div>
                    <div class="plan-card-price">Tarjeta, transferencia, efectivo</div>
                </label>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label" for="admin_password">Contrase&ntilde;a del administrador</label>
            <div class="password-field">
                <input type="password" name="admin_password" id="admin_password" class="form-input"
                       placeholder="M&iacute;nimo 8 caracteres" minlength="8" required autocomplete="new-password">
                <button type="button" class="password-visibility-btn" id="toggle-admin-password" aria-label="Mostrar contrase&ntilde;a">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
            <p class="form-hint">Esta ser&aacute; la contrase&ntilde;a del usuario <strong>admin</strong> dentro de tu instancia.</p>
        </div>

        <div class="form-group">
            <label class="form-label" for="admin_password_confirm">Confirmar contrase&ntilde;a</label>
            <div class="password-field">
                <input type="password" name="admin_password_confirm" id="admin_password_confirm" class="form-input"
                       placeholder="Repite la contrase&ntilde;a admin" minlength="8" required autocomplete="new-password">
            </div>
            <p class="form-hint" id="admin-password-hint"></p>
        </div>

        <button type="submit" class="btn btn--primary" id="submit-btn" disabled>
            <span class="spinner"></span>
            <span class="btn-text">Crear mi empresa</span>
        </button>
    </form>

    <p class="text-center mt-24">
        <a href="{{ path('onboarding_account_dashboard') }}" class="link">&larr; Volver al dashboard</a>
    </p>

    <script>
        (function () {
            var tenantName = document.getElementById('tenant_name');
            var subdomain = document.getElementById('subdomain');
            var feedback = document.getElementById('subdomain-feedback');
            var submitBtn = document.getElementById('submit-btn');
            var adminPassword = document.getElementById('admin_password');
            var adminPasswordConfirm = document.getElementById('admin_password_confirm');
            var adminPasswordHint = document.getElementById('admin-password-hint');
            var toggleAdminPassword = document.getElementById('toggle-admin-password');
            var debounceTimer = null;
            var lastChecked = '';
            var subdomainValid = false;
            var passwordValid = false;

            function slugify(value) {
                return value.toLowerCase()
                    .replace(/[^a-z0-9]+/g, '-')
                    .replace(/^-+|-+$/g, '')
                    .slice(0, 63);
            }

            function updateSubmitState() {
                submitBtn.disabled = !subdomainValid || !passwordValid;
            }

            function validateAdminPassword() {
                var password = adminPassword.value;
                var confirm = adminPasswordConfirm.value;

                if (password.length < 8 || confirm.length < 8) {
                    passwordValid = false;
                    adminPasswordConfirm.setCustomValidity('La contraseña debe tener al menos 8 caracteres.');
                    adminPasswordHint.textContent = password.length === 0 && confirm.length === 0
                        ? ''
                        : 'La contraseña debe tener al menos 8 caracteres.';
                    adminPasswordHint.className = 'form-hint form-hint--error';
                    updateSubmitState();
                    return;
                }

                if (password !== confirm) {
                    passwordValid = false;
                    adminPasswordConfirm.setCustomValidity('Las contraseñas no coinciden');
                    adminPasswordHint.textContent = 'Las contraseñas no coinciden';
                    adminPasswordHint.className = 'form-hint form-hint--error';
                    updateSubmitState();
                    return;
                }

                passwordValid = true;
                adminPasswordConfirm.setCustomValidity('');
                adminPasswordHint.textContent = 'Las contraseñas coinciden';
                adminPasswordHint.className = 'form-hint form-hint--success';
                updateSubmitState();
            }

            tenantName.addEventListener('blur', function () {
                if (!subdomain.value.trim() && tenantName.value.trim()) {
                    subdomain.value = slugify(tenantName.value.trim());
                    checkSubdomain();
                }
            });

            subdomain.addEventListener('input', function () {
                this.value = this.value.toLowerCase().replace(/[^a-z0-9-]/g, '');
                subdomainValid = false;
                updateSubmitState();
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(checkSubdomain, 400);
            });

            async function checkSubdomain() {
                var value = subdomain.value.trim().toLowerCase();
                if (!value || value === lastChecked) {
                    if (!value) {
                        feedback.innerHTML = '&nbsp;';
                        subdomainValid = false;
                        updateSubmitState();
                    }
                    return;
                }

                lastChecked = value;
                feedback.textContent = 'Verificando disponibilidad...';
                feedback.className = 'form-hint';
                subdomainValid = false;
                updateSubmitState();

                try {
                    var response = await fetch('{{ path('onboarding_check_subdomain') }}?subdomain=' + encodeURIComponent(value));
                    var data = await response.json();

                    if (data.normalized !== subdomain.value.trim().toLowerCase()) return;

                    if (data.available) {
                        feedback.textContent = 'Disponible: ' + data.domain;
                        feedback.className = 'form-hint form-hint--success';
                        subdomainValid = true;
                    } else {
                        feedback.textContent = data.reason || 'No disponible';
                        feedback.className = 'form-hint form-hint--error';
                        subdomainValid = false;
                    }
                } catch (_e) {
                    feedback.textContent = 'No se pudo verificar. Intenta de nuevo.';
                    feedback.className = 'form-hint form-hint--error';
                    subdomainValid = false;
                }

                updateSubmitState();
            }

            /* Billing cycle toggle */
            var billingToggle = document.getElementById('billing-toggle');
            var billingCycleInput = document.getElementById('billing_cycle');
            var currentCycle = 'monthly';

            billingToggle.querySelectorAll('.billing-toggle-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    currentCycle = btn.getAttribute('data-cycle');
                    billingCycleInput.value = currentCycle;

                    billingToggle.querySelectorAll('.billing-toggle-btn').forEach(function (b) {
                        b.classList.remove('billing-toggle-btn--active');
                    });
                    btn.classList.add('billing-toggle-btn--active');

                    document.querySelectorAll('.plan-card-price-monthly').forEach(function (el) {
                        el.classList.toggle('visible', currentCycle === 'monthly');
                    });
                    document.querySelectorAll('.plan-card-price-annual').forEach(function (el) {
                        el.classList.toggle('visible', currentCycle === 'annual');
                    });
                });
            });

            /* Plan card selection */
            var gatewayGroup = document.getElementById('gateway-group');
            var planCards = document.getElementById('plan-cards');
            var submitBtnText = submitBtn.querySelector('.btn-text');

            function updateGatewayVisibility() {
                var selected = planCards.querySelector('input[name="plan"]:checked');
                var isPaid = selected && selected.value !== 'free';
                gatewayGroup.style.display = isPaid ? 'block' : 'none';
                submitBtnText.textContent = isPaid ? 'Continuar al pago' : 'Crear mi empresa';
            }

            document.querySelectorAll('#plan-cards .plan-card').forEach(function (card) {
                card.addEventListener('click', function () {
                    planCards.querySelectorAll('.plan-card').forEach(function (c) { c.classList.remove('plan-card--selected'); });
                    card.classList.add('plan-card--selected');
                    card.querySelector('input[type="radio"]').checked = true;
                    updateGatewayVisibility();
                });
            });

            document.querySelectorAll('#gateway-cards .plan-card').forEach(function (card) {
                card.addEventListener('click', function () {
                    document.getElementById('gateway-cards').querySelectorAll('.plan-card').forEach(function (c) { c.classList.remove('plan-card--selected'); });
                    card.classList.add('plan-card--selected');
                    card.querySelector('input[type="radio"]').checked = true;
                });
            });

            /* Loading state on submit */
            document.getElementById('wizard-form').addEventListener('submit', function (event) {
                validateAdminPassword();
                if (!this.checkValidity()) {
                    event.preventDefault();
                    this.reportValidity();
                    return;
                }
                submitBtn.classList.add('btn--loading');
                submitBtn.disabled = true;
            });

            adminPassword.addEventListener('input', validateAdminPassword);
            adminPasswordConfirm.addEventListener('input', validateAdminPassword);
            toggleAdminPassword.addEventListener('click', function () {
                var isVisible = adminPassword.type === 'text';
                var type = isVisible ? 'password' : 'text';
                adminPassword.type = type;
                adminPasswordConfirm.type = type;
                var icon = this.querySelector('i');
                if (icon) {
                    icon.className = isVisible ? 'bi bi-eye' : 'bi bi-eye-slash';
                }
                this.setAttribute('aria-label', isVisible ? 'Mostrar contrase&ntilde;a' : 'Ocultar contrase&ntilde;a');
            });

            /* Initial check if subdomain pre-filled */
            if (subdomain.value.trim()) { checkSubdomain(); }
            validateAdminPassword();
        })();
    </script>
{% endblock %}
