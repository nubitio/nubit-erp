{% extends 'onboarding/base.html.twig' %}

{% block title %}Dashboard | eFact{% endblock %}
{% block card_class %}onboarding-card--dashboard{% endblock %}

{% block header_action %}
    <form method="post" action="{{ path('onboarding_account_logout') }}" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('onboarding_account_logout') }}">
        <button type="submit" class="btn btn--ghost">Cerrar sesi&oacute;n</button>
    </form>
{% endblock %}

{% block steps %}{% endblock %}

{% block content %}
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px;">
        <div>
            <h1>Mis empresas</h1>
            <p class="subtitle" style="margin-bottom:0;">{{ account.email }}</p>
        </div>
        <a href="{{ path('onboarding_wizard') }}" class="btn btn--primary" style="width:auto;">
            + Nueva empresa
        </a>
    </div>

    {% if provisions is not empty %}
    <div class="dashboard-section">
        <h2>Provisioning en curso</h2>
        <div class="table-wrapper">
            <table id="provision-table">
                <thead>
                    <tr>
                        <th>Empresa</th>
                        <th>Plan</th>
                        <th>Estado</th>
                        <th>Instancia</th>
                        <th>Error</th>
                    </tr>
                </thead>
                <tbody id="provision-body">
                    {% for item in provisions %}
                        <tr>
                            <td>{{ item.tenant_name }}</td>
                            <td><span class="badge badge--{{ item.plan ?: 'free' }}">{{ item.plan ?: 'free' }}</span></td>
                            <td><span class="badge badge--{{ item.status }}">{{ item.status }}</span></td>
                            <td>
                                {% if item.status == 'completed' and item.tenant_url %}
                                    <a href="{{ item.tenant_url }}" target="_blank" rel="noopener" class="link">Abrir</a>
                                {% elseif item.status in ['dispatched', 'running'] %}
                                    <span style="color:var(--color-gray-400);">Procesando...</span>
                                {% else %}
                                    &mdash;
                                {% endif %}
                            </td>
                            <td>
                                {% if item.error_message %}
                                    <span style="color:var(--color-error);font-size:13px;">{{ item.error_message|length > 80 ? item.error_message|slice(0, 80) ~ '...' : item.error_message }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    <div class="dashboard-section">
        <h2>Empresas activas</h2>
        {% if tenants is empty %}
            <div class="empty-state">
                <p>A&uacute;n no tienes empresas creadas.</p>
                <p class="mt-4"><a href="{{ path('onboarding_wizard') }}" class="link">Crea tu primera empresa</a></p>
            </div>
        {% else %}
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Empresa</th>
                            <th>Dominio</th>
                            <th>Plan</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tenant in tenants %}
                            <tr>
                                <td style="font-weight:600;">{{ tenant.name }}</td>
                                <td>
                                    {% if tenant.primary_domain %}
                                        <code style="font-size:13px;background:var(--color-gray-100);padding:2px 6px;border-radius:4px;">{{ tenant.primary_domain }}</code>
                                    {% else %}
                                        &mdash;
                                    {% endif %}
                                </td>
                                <td><span class="badge badge--{{ tenant.plan ?: 'free' }}">{{ tenant.plan ?: 'free' }}</span></td>
                                <td><span class="badge badge--{{ tenant.status }}">{{ tenant.status }}</span></td>
                                <td>
                                    {% if tenant.primary_domain %}
                                        <a href="https://{{ tenant.primary_domain }}" target="_blank" rel="noopener" class="btn btn--secondary" style="padding:4px 12px;font-size:13px;">
                                            Abrir
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <script>
        (function () {
            var provisionBody = document.getElementById('provision-body');
            if (!provisionBody) return;

            var hasActive = {{ provisions|filter(p => p.status in ['dispatched', 'running'])|length > 0 ? 'true' : 'false' }};
            if (!hasActive) return;

            function badgeClass(value) {
                var map = { active: 'active', suspended: 'suspended', dispatched: 'dispatched', running: 'running', completed: 'completed', failed: 'failed', free: 'free', basic: 'basic', pro: 'pro' };
                return 'badge badge--' + (map[value] || 'free');
            }

            function escapeHtml(str) {
                var div = document.createElement('div');
                div.appendChild(document.createTextNode(str));
                return div.innerHTML;
            }

            function rowHtml(item) {
                var plan = item.plan || 'free';
                var status = item.status || 'dispatched';
                var error = item.error_message || '';
                var url = item.tenant_url || '';
                var instanceCell;

                if (status === 'completed' && url) {
                    instanceCell = '<a href="' + escapeHtml(url) + '" target="_blank" rel="noopener" class="link">Abrir</a>';
                } else if (status === 'dispatched' || status === 'running') {
                    instanceCell = '<span style="color:var(--color-gray-400);">Procesando...</span>';
                } else {
                    instanceCell = '&mdash;';
                }

                var errorCell = error
                    ? '<span style="color:var(--color-error);font-size:13px;">' + escapeHtml(error.slice(0, 80)) + '</span>'
                    : '';

                return '<tr>'
                    + '<td>' + escapeHtml(item.tenant_name || '') + '</td>'
                    + '<td><span class="' + badgeClass(plan) + '">' + escapeHtml(plan) + '</span></td>'
                    + '<td><span class="' + badgeClass(status) + '">' + escapeHtml(status) + '</span></td>'
                    + '<td>' + instanceCell + '</td>'
                    + '<td>' + errorCell + '</td>'
                    + '</tr>';
            }

            async function refresh() {
                try {
                    var response = await fetch('{{ path('onboarding_account_dashboard_provisions') }}', {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!response.ok) return;
                    var data = await response.json();
                    var items = Array.isArray(data.items) ? data.items : [];

                    if (items.length > 0) {
                        provisionBody.innerHTML = items.map(rowHtml).join('');
                    }

                    var stillActive = items.some(function (i) { return i.status === 'dispatched' || i.status === 'running'; });
                    if (!stillActive) {
                        clearInterval(interval);
                        setTimeout(function () { window.location.reload(); }, 1000);
                    }
                } catch (_e) { /* silent retry */ }
            }

            var interval = setInterval(refresh, 4000);
        })();
    </script>
{% endblock %}
