{% extends 'onboarding/base.html.twig' %}

{% block title %}Dashboard | eFact{% endblock %}
{% block card_class %}onboarding-card--dashboard{% endblock %}

{% block head %}
    <style>
        .provision-error-card {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 16px;
            background: var(--color-error-light);
            border: 1px solid var(--color-error-border);
            border-radius: var(--radius);
            margin-bottom: 8px;
        }
        .provision-error-card__content { flex: 1; }
        .provision-error-card__close {
            border: 0;
            background: transparent;
            color: var(--color-error);
            opacity: .75;
            cursor: pointer;
            font-size: 18px;
            line-height: 1;
            padding: 0;
        }
        .provision-error-card__close:hover { opacity: 1; }
    </style>
{% endblock %}

{% block header_action %}
    <form method="post" action="{{ path('onboarding_account_logout') }}" style="display:inline;">
        <input type="hidden" name="_token" value="{{ csrf_token('onboarding_account_logout') }}">
        <button type="submit" class="btn btn--ghost">Cerrar sesi&oacute;n</button>
    </form>
{% endblock %}

{% block steps %}{% endblock %}

{% block content %}
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px;">
        <div>
            <h1>Mis empresas</h1>
            <p class="subtitle" style="margin-bottom:0;">{{ account.email }}</p>
        </div>
        <a href="{{ path('onboarding_wizard') }}" class="btn btn--primary" style="width:auto;">
            + Nueva empresa
        </a>
    </div>

    {% set active_provisions = provisions|filter(p => p.status in ['dispatched', 'running']) %}
    {% set failed_provisions = provisions|filter(p => p.status == 'failed') %}

    {% if active_provisions is not empty %}
    <div id="provision-banner" class="dashboard-section">
        {% for item in active_provisions %}
            <div style="display:flex;align-items:center;gap:12px;padding:16px;background:var(--color-primary-light);border:1px solid var(--color-gray-200);border-radius:var(--radius);margin-bottom:8px;">
                <div class="status-spinner" style="width:24px;height:24px;border-width:3px;margin:0;flex-shrink:0;"></div>
                <div>
                    <span style="font-weight:600;">{{ item.tenant_name }}</span>
                    <span style="color:var(--color-gray-500);font-size:13px;">&mdash; Creando tu empresa, esto puede tomar unos minutos...</span>
                </div>
            </div>
        {% endfor %}
    </div>
    {% endif %}

    {% if failed_provisions is not empty %}
    <div class="dashboard-section" id="failed-provisions">
        {% for item in failed_provisions %}
            <div class="provision-error-card"
                 data-provision-id="{{ item.id }}"
                 data-dismiss-url="{{ path('onboarding_account_dashboard_provision_dismiss', { provisionId: item.id }) }}">
                <div style="flex-shrink:0;font-size:20px;">&#10007;</div>
                <div class="provision-error-card__content">
                    <span style="font-weight:600;color:var(--color-error);">{{ item.tenant_name }}</span>
                    <span style="color:var(--color-gray-600);font-size:13px;">&mdash; Hubo un problema creando tu empresa. Por favor contacta a soporte.</span>
                </div>
                <button type="button" class="provision-error-card__close" aria-label="Ocultar error">&times;</button>
            </div>
        {% endfor %}
    </div>
    {% endif %}

    <div class="dashboard-section">
        <h2>Empresas activas</h2>
        {% if tenants is empty %}
            <div class="empty-state">
                <p>A&uacute;n no tienes empresas creadas.</p>
                <p class="mt-4"><a href="{{ path('onboarding_wizard') }}" class="link">Crea tu primera empresa</a></p>
            </div>
        {% else %}
            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Empresa</th>
                            <th>Dominio</th>
                            <th>Plan</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tenant in tenants %}
                            <tr>
                                <td style="font-weight:600;">{{ tenant.name }}</td>
                                <td>
                                    {% if tenant.primary_domain %}
                                        <code style="font-size:13px;background:var(--color-gray-100);padding:2px 6px;border-radius:4px;">{{ tenant.primary_domain }}</code>
                                    {% else %}
                                        &mdash;
                                    {% endif %}
                                </td>
                                <td><span class="badge badge--{{ tenant.plan ?: 'free' }}">{{ tenant.plan ?: 'free' }}</span></td>
                                <td><span class="badge badge--{{ tenant.status }}">{{ tenant.status }}</span></td>
                                <td style="white-space:nowrap;">
                                    <a href="{{ path('onboarding_tenant_detail', {tenantId: tenant.id}) }}" class="btn btn--secondary" style="padding:4px 12px;font-size:13px;">
                                        Gestionar
                                    </a>
                                    {% if tenant.primary_domain %}
                                        <a href="https://{{ tenant.primary_domain }}" target="_blank" rel="noopener" class="btn btn--ghost" style="padding:4px 8px;font-size:13px;">
                                            Abrir
                                        </a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>

    <script>
        (function () {
            var banner = document.getElementById('provision-banner');
            var failedSection = document.getElementById('failed-provisions');
            var dismissToken = '{{ csrf_token('onboarding_dismiss_provision') }}';

            document.addEventListener('click', async function (event) {
                var closeBtn = event.target.closest('.provision-error-card__close');
                if (!closeBtn) {
                    return;
                }
                var card = closeBtn.closest('.provision-error-card');
                if (!card) {
                    return;
                }

                var dismissUrl = card.getAttribute('data-dismiss-url');
                if (!dismissUrl) {
                    card.remove();
                    return;
                }

                try {
                    var response = await fetch(dismissUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'Accept': 'application/json'
                        },
                        body: new URLSearchParams({ _token: dismissToken }).toString()
                    });

                    if (!response.ok) {
                        return;
                    }

                    card.remove();
                    if (failedSection && !failedSection.querySelector('.provision-error-card')) {
                        failedSection.remove();
                    }
                } catch (_e) {
                    /* silent fail */
                }
            });

            if (!banner) return;

            async function refresh() {
                try {
                    var response = await fetch('{{ path('onboarding_account_dashboard_provisions') }}', {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!response.ok) return;
                    var data = await response.json();
                    var items = Array.isArray(data.items) ? data.items : [];

                    var stillActive = items.some(function (i) { return i.status === 'dispatched' || i.status === 'running'; });
                    if (!stillActive) {
                        clearInterval(interval);
                        window.location.reload();
                    }
                } catch (_e) { /* silent retry */ }
            }

            var interval = setInterval(refresh, 4000);
        })();
    </script>
{% endblock %}
