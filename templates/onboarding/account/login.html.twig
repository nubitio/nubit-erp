{% extends 'onboarding/base.html.twig' %}

{% block title %}Iniciar sesi&oacute;n | eFact{% endblock %}

{% block header_action %}
    <a href="{{ path('onboarding_register') }}">Crear cuenta</a>
{% endblock %}

{% block head %}
    <style>
        .password-field {
            position: relative;
        }
        .password-field .form-input { padding-right: 42px; }
        .password-visibility-btn {
            position: absolute;
            top: 50%;
            right: 10px;
            transform: translateY(-50%);
            border: 0;
            background: transparent;
            color: var(--color-gray-500);
            cursor: pointer;
            padding: 2px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .password-visibility-btn:hover { color: var(--color-gray-700); }
    </style>
{% endblock %}

{% block content %}
    <h1>Iniciar sesi&oacute;n</h1>
    <p class="subtitle">Accede a tus empresas en eFact.</p>

    <form method="post" action="{{ path('onboarding_account_login_submit') }}" id="login-form">
        <input type="hidden" name="_token" value="{{ csrf_token('onboarding_account_login') }}">

        <div class="form-group">
            <label class="form-label" for="email">Correo electr&oacute;nico</label>
            <input type="email" name="email" id="email" class="form-input" value="{{ email|default('') }}"
                   placeholder="tu@empresa.com" required autocomplete="email" autofocus>
        </div>

        <div class="form-group">
            <label class="form-label" for="password">Contrase&ntilde;a</label>
            <div class="password-field">
                <input type="password" name="password" id="password" class="form-input"
                       required autocomplete="current-password">
                <button type="button" class="password-visibility-btn" id="toggle-password" aria-label="Mostrar contrase&ntilde;a">
                    <i class="bi bi-eye" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <button type="submit" class="btn btn--primary" id="submit-btn">
            <span class="spinner"></span>
            <span class="btn-text">Entrar</span>
        </button>
    </form>

    <p class="text-center mt-24">
        <a href="{{ path('onboarding_register') }}" class="link">&iquest;No tienes cuenta? Reg&iacute;strate</a>
    </p>

    <script nonce="{{ csp_nonce() }}">
        document.getElementById('toggle-password').addEventListener('click', function () {
            var input = document.getElementById('password');
            var isVisible = input.type === 'text';
            input.type = isVisible ? 'password' : 'text';
            var icon = this.querySelector('i');
            if (icon) {
                icon.className = isVisible ? 'bi bi-eye' : 'bi bi-eye-slash';
            }
            this.setAttribute('aria-label', isVisible ? 'Mostrar contrase&ntilde;a' : 'Ocultar contrase&ntilde;a');
        });

        document.getElementById('login-form').addEventListener('submit', function () {
            var btn = document.getElementById('submit-btn');
            btn.classList.add('btn--loading');
            btn.disabled = true;
        });
    </script>
{% endblock %}
