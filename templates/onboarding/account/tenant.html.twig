{% extends 'onboarding/base.html.twig' %}

{% block title %}{{ tenant.name }} | eFact{% endblock %}
{% block card_class %}onboarding-card--wide{% endblock %}

{% block header_action %}
    <a href="{{ path('onboarding_account_dashboard') }}">Mis empresas</a>
{% endblock %}

{% block head %}
    <style>
        .tenant-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 28px;
        }
        .section-card {
            border: 1px solid var(--color-gray-200);
            border-radius: var(--radius);
            padding: 20px;
            margin-bottom: 20px;
        }
        .section-card h2 {
            font-size: 16px;
            font-weight: 700;
            color: var(--color-gray-800);
            margin-bottom: 16px;
        }
        .info-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid var(--color-gray-100);
            font-size: 14px;
        }
        .info-row:last-child { border-bottom: none; }
        .info-label { color: var(--color-gray-500); font-weight: 500; }
        .info-value { color: var(--color-gray-800); font-weight: 600; }
        .plan-selector {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-bottom: 16px;
        }
        @media (max-width: 520px) {
            .plan-selector { grid-template-columns: 1fr; }
        }
        .plan-option {
            border: 2px solid var(--color-gray-200);
            border-radius: var(--radius);
            padding: 12px;
            cursor: pointer;
            transition: all .15s;
            text-align: center;
        }
        .plan-option:hover { border-color: var(--color-gray-300); }
        .plan-option--current { border-color: var(--color-success); background: var(--color-success-light); }
        .plan-option--selected { border-color: var(--color-primary); background: var(--color-primary-light); }
        .plan-option input[type="radio"] { display: none; }
        .plan-option-name { font-weight: 700; font-size: 15px; color: var(--color-gray-800); }
        .plan-option-price { font-size: 13px; color: var(--color-gray-500); margin-top: 2px; }
        .gateway-row {
            display: flex;
            gap: 10px;
            margin-bottom: 16px;
        }
        .gateway-option {
            flex: 1;
            border: 2px solid var(--color-gray-200);
            border-radius: var(--radius);
            padding: 10px;
            cursor: pointer;
            transition: all .15s;
            text-align: center;
        }
        .gateway-option:hover { border-color: var(--color-gray-300); }
        .gateway-option--selected { border-color: var(--color-primary); background: var(--color-primary-light); }
        .gateway-option input[type="radio"] { display: none; }
        .gateway-option-name { font-weight: 600; font-size: 14px; }
        .billing-toggle-sm {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            background: var(--color-gray-100);
            border: 1px solid var(--color-gray-200);
            border-radius: var(--radius);
            padding: 3px;
            margin-bottom: 12px;
        }
        .billing-toggle-sm-btn {
            flex: 1;
            padding: 6px 12px;
            border: none;
            border-radius: 5px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            background: transparent;
            color: var(--color-gray-500);
            transition: all .15s;
            text-align: center;
        }
        .billing-toggle-sm-btn--active {
            background: var(--color-surface-elevated);
            color: var(--color-gray-800);
            border: 1px solid var(--color-gray-300);
            box-shadow: 0 1px 2px rgba(0,0,0,.16);
        }
        .billing-savings {
            display: inline-block;
            background: var(--color-success-light);
            color: var(--color-success);
            font-size: 10px;
            font-weight: 700;
            padding: 1px 5px;
            border-radius: 3px;
            margin-left: 3px;
        }
        .cancel-section {
            border-top: 1px solid var(--color-gray-200);
            padding-top: 16px;
            margin-top: 16px;
        }
    </style>
{% endblock %}

{% block steps %}{% endblock %}

{% block content %}
    <div class="tenant-header">
        <div>
            <h1>{{ tenant.name }}</h1>
            <p class="subtitle" style="margin-bottom:0;">
                {% if tenant.primary_domain %}
                    <code style="font-size:13px;background:var(--color-gray-100);padding:2px 6px;border-radius:4px;">{{ tenant.primary_domain }}</code>
                {% endif %}
                <span class="badge badge--{{ tenant.status }}">{{ tenant.status }}</span>
                <span class="badge badge--{{ tenant.plan ?: 'free' }}">{{ tenant.plan ?: 'free' }}</span>
            </p>
        </div>
        {% if tenant.primary_domain %}
            <a href="https://{{ tenant.primary_domain }}" target="_blank" rel="noopener" class="btn btn--secondary" style="width:auto;">
                Abrir instancia
            </a>
        {% endif %}
    </div>

    {# ── Current subscription info ── #}
    <div class="section-card">
        <h2>Suscripci&oacute;n actual</h2>
        {% if subscription %}
            <div class="info-row">
                <span class="info-label">Plan</span>
                <span class="info-value"><span class="badge badge--{{ subscription.plan }}">{{ subscription.plan }}</span></span>
            </div>
            <div class="info-row">
                <span class="info-label">Ciclo</span>
                <span class="info-value">{{ subscription.billing_cycle == 'annual' ? 'Anual' : 'Mensual' }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Pasarela</span>
                <span class="info-value">{{ subscription.gateway == 'paypal' ? 'PayPal' : 'MercadoPago' }}</span>
            </div>
            <div class="info-row">
                <span class="info-label">Estado</span>
                <span class="info-value">
                    {% if subscription.status == 'active' %}
                        <span style="color:var(--color-success);">Activa</span>
                    {% elseif subscription.status == 'past_due' %}
                        <span style="color:var(--color-warning);">Pago pendiente</span>
                    {% elseif subscription.status == 'pending' %}
                        <span style="color:var(--color-gray-500);">Pendiente</span>
                    {% else %}
                        {{ subscription.status }}
                    {% endif %}
                </span>
            </div>
            {% if subscription.current_period_end %}
            <div class="info-row">
                <span class="info-label">Pr&oacute;ximo cobro</span>
                <span class="info-value">{{ subscription.current_period_end }}</span>
            </div>
            {% endif %}
        {% else %}
            <div style="text-align:center;padding:12px;color:var(--color-gray-400);font-size:14px;">
                Sin suscripci&oacute;n activa &mdash; plan Free.
            </div>
        {% endif %}
    </div>

    {# ── Change plan ── #}
    <div class="section-card">
        <h2>Cambiar plan</h2>
        <form method="post" action="{{ path('onboarding_change_plan', {tenantId: tenant.id}) }}" id="change-plan-form">
            <input type="hidden" name="_token" value="{{ csrf_token('subscription_manage') }}">
            <input type="hidden" name="billing_cycle" id="billing_cycle" value="{{ subscription ? subscription.billing_cycle : 'monthly' }}">

            <div class="billing-toggle-sm" id="billing-toggle">
                <button type="button" class="billing-toggle-sm-btn {{ (not subscription or subscription.billing_cycle != 'annual') ? 'billing-toggle-sm-btn--active' : '' }}" data-cycle="monthly">Mensual</button>
                <button type="button" class="billing-toggle-sm-btn {{ (subscription and subscription.billing_cycle == 'annual') ? 'billing-toggle-sm-btn--active' : '' }}" data-cycle="annual">Anual <span class="billing-savings">-17%</span></button>
            </div>

            {% set current_plan = tenant.plan ?: 'free' %}
            <div class="plan-selector" id="plan-selector">
                <label class="plan-option {{ current_plan == 'free' ? 'plan-option--current' : '' }}">
                    <input type="radio" name="plan" value="free" {{ current_plan == 'free' ? 'checked' : '' }}>
                    <div class="plan-option-name">Free</div>
                    <div class="plan-option-price">Gratis</div>
                </label>
                <label class="plan-option {{ current_plan == 'basic' ? 'plan-option--current' : '' }}">
                    <input type="radio" name="plan" value="basic" {{ current_plan == 'basic' ? 'checked' : '' }}>
                    <div class="plan-option-name">Basic</div>
                    <div class="plan-option-price plan-price-monthly">S/ 29.90/mes</div>
                    <div class="plan-option-price plan-price-annual" style="display:none;">S/ 299/a&ntilde;o</div>
                </label>
                <label class="plan-option {{ current_plan == 'pro' ? 'plan-option--current' : '' }}">
                    <input type="radio" name="plan" value="pro" {{ current_plan == 'pro' ? 'checked' : '' }}>
                    <div class="plan-option-name">Pro</div>
                    <div class="plan-option-price plan-price-monthly">S/ 79.90/mes</div>
                    <div class="plan-option-price plan-price-annual" style="display:none;">S/ 799/a&ntilde;o</div>
                </label>
            </div>

            <div id="gateway-section" style="display:{{ current_plan != 'free' ? 'block' : 'none' }};">
                <label class="form-label" style="font-size:13px;">Medio de pago</label>
                <div class="gateway-row">
                    <label class="gateway-option {{ (not subscription or subscription.gateway == 'paypal') ? 'gateway-option--selected' : '' }}">
                        <input type="radio" name="gateway" value="paypal" {{ (not subscription or subscription.gateway == 'paypal') ? 'checked' : '' }}>
                        <div class="gateway-option-name">PayPal</div>
                    </label>
                    <label class="gateway-option {{ (subscription and subscription.gateway == 'mercadopago') ? 'gateway-option--selected' : '' }}">
                        <input type="radio" name="gateway" value="mercadopago" {{ (subscription and subscription.gateway == 'mercadopago') ? 'checked' : '' }}>
                        <div class="gateway-option-name">MercadoPago</div>
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn--primary" id="change-plan-btn" disabled>
                <span class="spinner"></span>
                <span class="btn-text">Cambiar plan</span>
            </button>
        </form>
    </div>

    {# ── Cancel subscription ── #}
    {% if subscription and subscription.status in ['active', 'past_due', 'pending'] %}
    <div class="section-card">
        <h2 style="color:var(--color-error);">Cancelar suscripci&oacute;n</h2>
        <p style="font-size:14px;color:var(--color-gray-500);margin-bottom:12px;">
            Al cancelar, tu empresa pasar&aacute; al plan Free al final del periodo actual.
            No se realizar&aacute;n m&aacute;s cobros.
        </p>
        <form method="post" action="{{ path('onboarding_cancel_subscription', {tenantId: tenant.id}) }}" id="cancel-form">
            <input type="hidden" name="_token" value="{{ csrf_token('subscription_manage') }}">
            <button type="submit" class="btn btn--danger" style="width:auto;" onclick="return confirm('&iquest;Cancelar la suscripcion? Tu plan cambiara a Free.');">
                Cancelar suscripci&oacute;n
            </button>
        </form>
    </div>
    {% endif %}

    <p class="text-center mt-24">
        <a href="{{ path('onboarding_account_dashboard') }}" class="link">&larr; Volver al dashboard</a>
    </p>

    <script nonce="{{ csp_nonce() }}">
        (function () {
            var currentPlan = '{{ current_plan }}';
            var billingCycleInput = document.getElementById('billing_cycle');
            var changePlanBtn = document.getElementById('change-plan-btn');
            var gatewaySection = document.getElementById('gateway-section');
            var planSelector = document.getElementById('plan-selector');

            /* Billing toggle */
            document.getElementById('billing-toggle').querySelectorAll('.billing-toggle-sm-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    billingCycleInput.value = btn.getAttribute('data-cycle');
                    document.querySelectorAll('.billing-toggle-sm-btn').forEach(function (b) { b.classList.remove('billing-toggle-sm-btn--active'); });
                    btn.classList.add('billing-toggle-sm-btn--active');

                    var isAnnual = billingCycleInput.value === 'annual';
                    document.querySelectorAll('.plan-price-monthly').forEach(function (el) { el.style.display = isAnnual ? 'none' : 'block'; });
                    document.querySelectorAll('.plan-price-annual').forEach(function (el) { el.style.display = isAnnual ? 'block' : 'none'; });
                    updateSubmitState();
                });
            });

            /* Init prices based on current cycle */
            if (billingCycleInput.value === 'annual') {
                document.querySelectorAll('.plan-price-monthly').forEach(function (el) { el.style.display = 'none'; });
                document.querySelectorAll('.plan-price-annual').forEach(function (el) { el.style.display = 'block'; });
            }

            /* Plan selection */
            planSelector.querySelectorAll('.plan-option').forEach(function (opt) {
                opt.addEventListener('click', function () {
                    planSelector.querySelectorAll('.plan-option').forEach(function (o) {
                        o.classList.remove('plan-option--selected');
                        if (!o.classList.contains('plan-option--current')) {
                            o.style.borderColor = '';
                        }
                    });
                    opt.classList.add('plan-option--selected');
                    opt.querySelector('input').checked = true;

                    var selected = opt.querySelector('input').value;
                    gatewaySection.style.display = selected !== 'free' ? 'block' : 'none';
                    updateSubmitState();
                });
            });

            /* Gateway selection */
            document.querySelectorAll('.gateway-option').forEach(function (opt) {
                opt.addEventListener('click', function () {
                    document.querySelectorAll('.gateway-option').forEach(function (o) { o.classList.remove('gateway-option--selected'); });
                    opt.classList.add('gateway-option--selected');
                    opt.querySelector('input').checked = true;
                    updateSubmitState();
                });
            });

            function updateSubmitState() {
                var selectedPlan = planSelector.querySelector('input[name="plan"]:checked');
                var plan = selectedPlan ? selectedPlan.value : currentPlan;
                var changed = plan !== currentPlan;
                changePlanBtn.disabled = !changed;
                changePlanBtn.querySelector('.btn-text').textContent = plan === 'free' ? 'Cambiar a Free' : 'Continuar al pago';
            }

            /* Loading on submit */
            document.getElementById('change-plan-form').addEventListener('submit', function () {
                changePlanBtn.classList.add('btn--loading');
                changePlanBtn.disabled = true;
            });
        })();
    </script>
{% endblock %}
