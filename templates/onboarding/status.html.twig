{% extends 'onboarding/base.html.twig' %}

{% block title %}Creando tu empresa | eFact{% endblock %}

{% block head %}
    <style>
        .status-actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: nowrap;
        }

        .status-actions .btn {
            white-space: nowrap;
            width: auto;
        }
    </style>
{% endblock %}

{% block content %}
    <div class="status-container" id="status-container">
        <div id="status-spinner" class="status-spinner" {% if status.status == 'completed' or status.status == 'failed' %}style="display:none;"{% endif %}></div>

        <div id="status-icon-success" class="status-icon status-icon--success" {% if status.status != 'completed' %}style="display:none;"{% endif %}>&#10003;</div>
        <div id="status-icon-error" class="status-icon status-icon--error" {% if status.status != 'failed' %}style="display:none;"{% endif %}>&#10007;</div>

        <div class="status-label" id="status-label">
            {% if status.status == 'completed' %}
                &iexcl;Tu empresa est&aacute; lista!
            {% elseif status.status == 'failed' %}
                Hubo un problema
            {% else %}
                Preparando tu empresa...
            {% endif %}
        </div>

        <div class="status-detail" id="status-detail">
            {% if status.status == 'completed' and tenant_url %}
                <strong>{{ status.tenant_name }}</strong> est&aacute; lista en<br>
                <a href="{{ tenant_url }}" target="_blank" rel="noopener">{{ tenant_url }}</a>
            {% elseif status.status == 'failed' %}
                No se pudo crear <strong>{{ status.tenant_name }}</strong>.
            {% else %}
                Estamos creando <strong>{{ status.tenant_name }}</strong> en <strong>{{ status.domain }}</strong>.<br>
                Esto puede tomar unos segundos.
            {% endif %}
        </div>

        <div id="status-error" class="status-error-msg" {% if not status.error_message %}style="display:none;"{% endif %}>
            {{ status.error_message }}
        </div>
    </div>

    <div class="mt-24 status-actions">
        <a href="{{ path('onboarding_account_dashboard') }}" class="btn btn--secondary" id="btn-dashboard">Ir al dashboard</a>
        <a href="" class="btn btn--primary" id="btn-open" target="_blank" rel="noopener" {% if not tenant_url %}style="display:none;"{% endif %}>
            Abrir mi empresa
        </a>
    </div>

    <script>
        (function () {
            var spinner = document.getElementById('status-spinner');
            var iconSuccess = document.getElementById('status-icon-success');
            var iconError = document.getElementById('status-icon-error');
            var label = document.getElementById('status-label');
            var detail = document.getElementById('status-detail');
            var errorMsg = document.getElementById('status-error');
            var btnOpen = document.getElementById('btn-open');

            var doneStatuses = ['completed', 'failed'];
            var currentStatus = '{{ status.status }}';

            if (doneStatuses.indexOf(currentStatus) !== -1) return;

            async function poll() {
                try {
                    var response = await fetch('{{ path('onboarding_status_poll', { token: token }) }}', {
                        headers: { 'Accept': 'application/json' }
                    });
                    if (!response.ok) return;

                    var data = await response.json();

                    if (data.status === 'completed') {
                        spinner.style.display = 'none';
                        iconSuccess.style.display = 'flex';
                        label.innerHTML = '&iexcl;Tu empresa est&aacute; lista!';

                        var url = data.tenant_url || '';
                        if (url) {
                            detail.innerHTML = '<strong>{{ status.tenant_name|e('js') }}</strong> est&aacute; lista en<br><a href="' + url + '" target="_blank" rel="noopener">' + url + '</a>';
                            btnOpen.href = url;
                            btnOpen.style.display = 'inline-flex';
                        }

                        errorMsg.style.display = 'none';
                        clearInterval(interval);
                    } else if (data.status === 'failed') {
                        spinner.style.display = 'none';
                        iconError.style.display = 'flex';
                        label.textContent = 'Hubo un problema';
                        detail.innerHTML = 'No se pudo crear <strong>{{ status.tenant_name|e('js') }}</strong>.';

                        if (data.error) {
                            errorMsg.textContent = data.error;
                            errorMsg.style.display = 'block';
                        }

                        clearInterval(interval);
                    } else if (data.status === 'running') {
                        label.textContent = 'Creando base de datos...';
                    }
                } catch (_e) {
                    /* silent retry */
                }
            }

            var interval = setInterval(poll, 3000);
            setTimeout(poll, 500);
        })();
    </script>
{% endblock %}
