<!DOCTYPE html>
<html lang="es">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.2/css/bootstrap.min.css"
          integrity="sha384-Smlep5jCw/wG7hdkwQ/Z5nLIefveQRIY9nfy6xoR1uRYBtpZgI6339F5dgvm/e9B" crossorigin="anonymous">

    <title>{{ title }}</title>
</head>
<body>
<div class="offset-xl-2 col-xl-8 col-lg-12 col-md-12 col-sm-12 col-12 padding">
    <div class="p-4">
        <table class="table table-borderless">
            <tr>
                <td>
                    <img src="{{ logo() }}" alt="Logo" style="position: relative; max-height: 100px">
                </td>
                <td class="text-right">
                    <h4>{{ title }}</h4>
                    <p>Local: {{ cashbox.local.descripcion|default('') }}</p>
                    Cajero(a): <span class="text-uppercase">{{ cashbox.usuario.username|default('') }}</span>
                </td>
            </tr>
        </table>
        <hr>
        <table class="table table-borderless table-sm mb-4">
            <tr>
                <td>Apertura:</td>
                <td>
                    {{ cashbox.apertura|date("d/m/Y H:i") }}
                </td>
                <td>Total ingresos:</td>
                <td class="text-right">{{ cashbox.income }}</td>
            </tr>
            <tr>
                <td>Cierre:</td>
                <td>
                    {% if cashbox.cierre %}
                        {{ cashbox.cierre|date('d/m/Y H:i') }}
                    {% else %}
                        -
                    {% endif %}
                </td>
                <td>Total egresos:</td>
                <td class="text-right">{{ cashbox.expense }}</td>
            </tr>
        </table>
        <div class="mb-4">
            <table class="table table-sm">
                <tr class="text-center">
                    <td colspan="5">VENTAS POR TIPO DE DOCUMENTO</td>
                </tr>
                <tr>
                    <th>Documento</th>
                    <th>Serie</th>
                    <th>Desde</th>
                    <th>Hasta</th>
                    <th>Total</th>
                </tr>
                {% set total = 0 %}
                {% for item in receipt %}
                    <tr>
                        <td>{{ item['tipo'] }}</td>
                        <td>{{ item['serie'] }}</td>
                        <td>{{ item['desde'] }}</td>
                        <td>{{ item['hasta'] }}</td>
                        <td>{{ item['total'] }}</td>
                    </tr>
                    {% set total = total + item['total'] %}
                {% endfor %}
                <tr>
                    <td colspan="4"><b>TOTAL</b></td>
                    <td>{{ total|number_format(2,'.','') }}</td>
                </tr>
            </table>
        </div>
        <div class="table-responsive-sm">
            <table class="table table-striped table-sm">
                <thead>
                <tr class="text-center">
                    <td colspan="5">MOVIMIENTO DE CAJA</td>
                </tr>
                <tr>
                    <th class="text-center">#</th>
                    <th>Concepto</th>
                    <th class="text-right">Ingresos</th>
                    <th class="text-right">Egresos</th>
                    <th>Observación</th>
                </tr>
                </thead>
                <tbody>
                {% set arqueo = 0 %}
                {% for item in cashbox.details %}
                    <tr>
                        <td class="text-center">{{ item.uid }}</td>
                        <td>{{ item.descripcion }}</td>
                        <td class="text-right">{{ (item.tipo_id == 1) ? item.monto : '-' }}</td>
                        <td class="text-right">{{ (item.tipo_id == 2) ? item.monto : '-' }}</td>
                        <td>{{ item.referencia }}</td>
                    </tr>
                    {% if item.descripcion == 'FONDO DE CAJA' %}
                        {% set arqueo = item.monto %}
                    {% endif %}
                {% endfor %}
                <tr>
                    <td class="text-center"></td>
                    <td>ARQUEO DE CAJA</td>
                    <td class="text-right">-</td>
                    <td class="text-right">{{ arqueo }}</td>
                    <td></td>
                </tr>
                </tbody>
            </table>
        </div>
        <div class="row">
            <div class="col-lg-4 col-sm-5">
            </div>
            <div class="col-lg-4 col-sm-5 ml-auto">
                <table class="table table-clear">
                    <tbody>
                    <tr>
                        <td class="left">
                            <strong class="text-dark">Saldo final</strong></td>
                        <td class="right">
                            <strong class="text-dark">{{ (cashbox.balance - arqueo)|number_format(2,'.','') }}</strong>
                        </td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</body>
</html>
