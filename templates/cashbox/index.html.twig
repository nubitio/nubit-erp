{% extends 'layout/base.html.twig' %}
{% block title %}Cashbox{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const cashbox = new window.app.cashbox('wrapper');
            cashbox.render();
        });
    </script>
{% endblock %}