{% extends 'layout/base.html.twig' %}
{% block title %}Supplier{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const supplier = new window.app.supplier('wrapper');
            supplier.render();
        });
    </script>
{% endblock %}