{% extends 'layout/base.html.twig' %}
{% block title %}Password{% endblock %}
{% block body %}
    <div class="wrapper">
        <!-- Dialogo -->
        <div id="dlg">
            <form class="fm" id="fm" method="post" novalidate>
                <div class="fitem">
                    <input id="actualPassword" name="actual">
                </div>
                <div class="fitem">
                    <input id="newPassword" name="password">
                </div>
                <div class="fitem">
                    <input id="confirmPassword">
                </div>
            </form>
        </div>
    </div>
    <script src="{{ asset('assets/js/pages/change-password/index.js') }}"></script>
{% endblock %}
