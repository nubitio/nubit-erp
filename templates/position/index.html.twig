{% extends 'layout/base.html.twig' %}
{% block title %}Position{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const position = new window.app.position('wrapper');
            position.render();
        });
    </script>
{% endblock %}