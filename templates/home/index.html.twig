<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" href="{{ logo() }}"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#000000"/>
    <meta name="description" content="Efact"/>
    <link rel="apple-touch-icon" href="{{ logo() }}"/>
    {#
    <link rel="manifest" href="{{ asset('assets/manifest.json') }}"/>
    #}
    <title>Efact</title>
    {% block stylesheets %}
        {{ vite_entry_link_tags('app') }}
    {% endblock %}
</head>
<body class="dx-viewport">
<noscript>You need to enable JavaScript to run this app.</noscript>
<div id="root"></div>
<div id="main-content"></div>
{% block javascripts %}
    {{ vite_entry_script_tags('app', { dependency: "react" }) }}
{% endblock %}
<script>
    window.app_version = '{{ setting('version') }}';
    const worker = setInterval(hideUnwantedElements, 100);

    function hideUnwantedElements() {
        const element = document.querySelectorAll('dx-license');
        element.forEach(element => {
            const divs = element.querySelectorAll('div');
            if (divs.length > 1) {
                divs[1].click();
            }
            clearInterval(worker);
        });
    }
</script>
</body>
</html>

