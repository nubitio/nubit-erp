<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    {# A tenant without a logo has none to show: fall back to the app's own icon, or the browser asks for /favicon.ico (404). #}
    {% set app_icon = logo() ?: asset('assets/images/nubit-icon.png') %}
    <link rel="icon" href="{{ app_icon }}"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#000000"/>
    <meta name="description" content="Nubit ERP para vender, facturar y controlar tu negocio en Perú"/>
    <link rel="apple-touch-icon" href="{{ app_icon }}"/>
    {#
    <link rel="manifest" href="{{ asset('assets/manifest.json') }}"/>
    #}
    <title>Nubit ERP</title>
    {% block stylesheets %}
        {{ reprise_entry_link_tags('app') }}
    {% endblock %}
</head>
<body>
<noscript>You need to enable JavaScript to run this app.</noscript>
<div id="root"></div>
<div id="main-content"></div>
{% block javascripts %}
    {{ reprise_entry_script_tags('app') }}
{% endblock %}
<script nonce="{{ csp_nonce() }}">
    window.app_version = '{{ setting('version') }}';
    window.app_identity = {{ identity_enabled ? 'true' : 'false' }};
</script>
</body>
</html>
