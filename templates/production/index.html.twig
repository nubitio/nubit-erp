{% extends 'layout/base.html.twig' %}
{% block title %}Production{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const production = new window.app.production('wrapper');
            production.render();
        });
    </script>
{% endblock %}