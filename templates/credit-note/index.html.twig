{% extends 'layout/base.html.twig' %}
{% block title %}CreditNote{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const creditNote = new window.app.creditNote('wrapper');
            creditNote.render();
        });
    </script>
{% endblock %}