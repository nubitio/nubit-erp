{% extends 'layout/base.html.twig' %}
{% block title %}Local{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const kardex = new window.app.kardex('wrapper');
            kardex.render();
        });
    </script>
{% endblock %}