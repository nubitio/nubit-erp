{% extends 'layout/base.html.twig' %}
{% block title %}Outbound{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const outbound = new window.app.outbound('wrapper');
            outbound.render();
        });
    </script>
{% endblock %}