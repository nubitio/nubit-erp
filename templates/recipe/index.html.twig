{% extends 'layout/base.html.twig' %}
{% block title %}Recipe{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const recipe = new window.app.recipe('wrapper');
            recipe.render();
        });
    </script>
{% endblock %}