{% extends 'layout/base.html.twig' %}
{% block title %}Local{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const local = new window.app.local('wrapper');
            local.render();
        });
    </script>
{% endblock %}