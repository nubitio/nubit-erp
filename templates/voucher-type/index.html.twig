{% extends 'layout/base.html.twig' %}
{% block title %}VoucherType{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const voucherType = new window.app.voucherType('wrapper');
            voucherType.render();
        });
    </script>
{% endblock %}