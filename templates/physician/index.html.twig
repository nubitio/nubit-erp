{% extends 'layout/base.html.twig' %}
{% block title %}Physician{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const physician = new window.app.physician('wrapper');
            physician.render();
        });
    </script>
{% endblock %}