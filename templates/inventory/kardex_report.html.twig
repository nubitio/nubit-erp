<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Kardex de inventario</title>
    <style>
        @page { size: A4 landscape; margin: 10mm; }
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; margin: 0; color: #111; font-size: 9px; }
        h1 { font-size: 15px; margin: 0 0 4px; }
        .meta {
            color: #444;
            margin-bottom: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem 1rem;
            font-size: 9px;
        }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 4px 5px; vertical-align: top; }
        thead th {
            background: #f8fafc;
            border-bottom: 1px solid #cbd5e1;
            font-size: 8px;
            font-weight: 700;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }
        tbody td { border-bottom: 1px solid #e5e7eb; }
        .group-row th {
            border-top: 1px solid #cbd5e1;
            text-align: center;
        }
        .right { text-align: right; white-space: nowrap; }
        .text { white-space: nowrap; }
        .divider-right { border-right: 2px solid #94a3b8; }
        col.c-fecha { width: 8%; }
        col.c-tipo { width: 12%; }
        col.c-ref { width: 14%; }
        col.c-qty { width: 7%; }
        col.c-money { width: 8%; }
        col.c-stock { width: 8%; }
    </style>
</head>
<body>
    <h1>Kardex de inventario</h1>
    <div class="meta">
        <span>{{ summary.product.code ? summary.product.code ~ ' - ' : '' }}{{ summary.product.name }}</span>
        <span>{{ summary.periodLabel }}</span>
        <span>Stock: {{ summary.currentStock }}</span>
        <span>Valor: {{ summary.stockValue }}</span>
        <span>Método: {{ summary.valuationMethod == 'fifo' ? 'FIFO' : 'Costo prom.' }}</span>
    </div>

    <table>
        <colgroup>
            <col class="c-fecha"><col class="c-tipo"><col class="c-ref">
            <col class="c-qty"><col class="c-money"><col class="c-money">
            <col class="c-qty"><col class="c-money"><col class="c-money">
            <col class="c-stock"><col class="c-money">
        </colgroup>
        <thead>
            <tr class="group-row">
                <th colspan="3">Documento</th>
                <th colspan="3" class="divider-right">Entradas</th>
                <th colspan="3" class="divider-right">Salidas</th>
                <th colspan="2">Saldo</th>
            </tr>
            <tr>
                <th>Fecha</th>
                <th>Tipo</th>
                <th class="divider-right">Referencia</th>
                <th class="right">Cant.</th>
                <th class="right">Costo unit.</th>
                <th class="right divider-right">Total</th>
                <th class="right">Cant.</th>
                <th class="right">Costo unit.</th>
                <th class="right divider-right">Total</th>
                <th class="right">Stock</th>
                <th class="right">Valor</th>
            </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            <tr>
                <td class="text">{{ row.occurredAt }}</td>
                <td class="text">{{ row.movementType }}</td>
                <td class="text divider-right">{{ row.reference }}</td>
                <td class="right">{{ row.qtyIn }}</td>
                <td class="right">{{ row.unitCostIn }}</td>
                <td class="right divider-right">{{ row.lineValueIn }}</td>
                <td class="right">{{ row.qtyOut }}</td>
                <td class="right">{{ row.unitCostOut }}</td>
                <td class="right divider-right">{{ row.lineValueOut }}</td>
                <td class="right">{{ row.runningBalance }}</td>
                <td class="right">{{ row.runningValue }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</body>
</html>