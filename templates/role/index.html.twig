{% extends 'layout/base.html.twig' %}
{% block title %}Role{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const role = new window.app.role('wrapper');
            role.render();
        });
    </script>
{% endblock %}