{% extends 'layout/base.html.twig' %}
{% block title %}PaymentMethod{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const paymentMethod = new window.app.paymentMethod('wrapper');
            paymentMethod.render();
        });
    </script>
{% endblock %}