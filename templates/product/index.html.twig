{% extends 'layout/base.html.twig' %}
{% block title %}Product{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const product = new window.app.product('wrapper');
            product.render();
        });
    </script>
{% endblock %}