{% extends 'layout/base.html.twig' %}
{% block title %}PriceList{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const priceList = new window.app.priceList('wrapper');
            priceList.render();
        });
    </script>
{% endblock %}