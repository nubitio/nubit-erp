{% extends 'receipt/base.html.twig' %}

{% block title %}Consulta de comprobantes · {{ company_name }}{% endblock %}

{% block meta %}
    <meta name="description" content="Consulte y valide comprobantes electrónicos emitidos por {{ company_name }}.">
{% endblock %}

{% block body_class %}receipt-public--search{% if result %} receipt-public--has-result{% endif %}{% endblock %}

{% block body %}
<div class="receipt-shell">
    <aside class="receipt-brand" aria-hidden="true">
        <div class="receipt-brand__content">
            <img src="{{ logo() }}" alt="" class="receipt-brand__logo">
            <div>
                <h1 class="receipt-brand__title">Consulta de comprobantes</h1>
                <p class="receipt-brand__text">
                    Valide facturas, boletas y notas electrónicas emitidas por {{ company_name }}.
                </p>
            </div>
            <ul class="receipt-brand__features">
                <li>
                    <i class="ph ph-shield-check" aria-hidden="true"></i>
                    Verificación con datos oficiales del comprobante
                </li>
                <li>
                    <i class="ph ph-file-pdf" aria-hidden="true"></i>
                    Acceso a representación impresa y archivos XML/CDR
                </li>
                <li>
                    <i class="ph ph-buildings" aria-hidden="true"></i>
                    RUC {{ company_ruc }}
                </li>
            </ul>
        </div>
    </aside>

    <main class="receipt-main">
        <div class="receipt-main__inner">
            <div class="receipt-mobile-brand">
                <img src="{{ logo() }}" alt="Logo de {{ company_name }}">
            </div>

            <section class="receipt-card">
                <div class="receipt-card__header">
                    <h2>Buscar comprobante</h2>
                    <p>Ingrese los datos impresos en el comprobante para localizarlo.</p>
                </div>
                <div class="receipt-card__body">
                    <form method="post" action="{{ path('voucher_search') }}" class="receipt-form">
                        <div class="receipt-field">
                            <label for="ruc">RUC del emisor</label>
                            <input
                                type="text"
                                class="receipt-input"
                                id="ruc"
                                name="ruc"
                                value="{{ form_data.ruc }}"
                                maxlength="11"
                                pattern="\d{11}"
                                required
                                placeholder="Ej: 20123456789"
                                inputmode="numeric"
                                autocomplete="off"
                            >
                        </div>

                        <div class="receipt-field">
                            <label for="voucher_type">Tipo de comprobante</label>
                            <select class="receipt-select" id="voucher_type" name="voucher_type" required>
                                {% for code, label in voucher_types %}
                                    <option value="{{ code }}" {{ form_data.voucher_type == code ? 'selected' : '' }}>
                                        {{ label }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="receipt-form__row">
                            <div class="receipt-field">
                                <label for="series">Serie</label>
                                <input
                                    type="text"
                                    class="receipt-input text-uppercase"
                                    id="series"
                                    name="series"
                                    value="{{ form_data.series }}"
                                    maxlength="4"
                                    pattern="[A-Za-z0-9]{4}"
                                    required
                                    placeholder="F001"
                                    autocomplete="off"
                                >
                            </div>
                            <div class="receipt-field">
                                <label for="number">Número</label>
                                <input
                                    type="text"
                                    class="receipt-input"
                                    id="number"
                                    name="number"
                                    value="{{ form_data.number }}"
                                    maxlength="8"
                                    pattern="\d{1,8}"
                                    required
                                    placeholder="12345"
                                    inputmode="numeric"
                                    autocomplete="off"
                                >
                            </div>
                        </div>

                        <div class="receipt-field">
                            <label for="date">Fecha de emisión</label>
                            <input
                                type="date"
                                class="receipt-input"
                                id="date"
                                name="date"
                                value="{{ form_data.date }}"
                                required
                            >
                        </div>

                        <div class="receipt-field">
                            <label for="total">Monto total</label>
                            <div class="receipt-input-group">
                                <span class="receipt-input-group__prefix">{{ result ? result.currency_symbol : 'S/' }}</span>
                                <input
                                    type="text"
                                    class="receipt-input"
                                    id="total"
                                    name="total"
                                    value="{{ form_data.total }}"
                                    pattern="[0-9]+(\.[0-9]{1,2})?"
                                    required
                                    placeholder="150.00"
                                    inputmode="decimal"
                                    autocomplete="off"
                                >
                            </div>
                        </div>

                        <button type="submit" class="receipt-btn receipt-btn--primary">
                            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
                            Buscar comprobante
                        </button>
                    </form>
                </div>
            </section>

            {% if error %}
                <div class="receipt-alert receipt-alert--warning" role="alert">
                    {{ error }}
                </div>
            {% endif %}

            <p class="receipt-footnote">
                <strong>Consulta pública de comprobantes electrónicos.</strong>
                Los datos deben coincidir exactamente con los impresos en el documento emitido por {{ company_name }}.
            </p>
        </div>
    </main>
</div>
{% endblock %}

{% block overlays %}
{% if result %}
    <div
        class="receipt-search-overlay"
        id="receipt-search-result"
        role="presentation"
        style="position:fixed;inset:0;z-index:2000;display:flex;align-items:center;justify-content:center;padding:24px;"
    >
        <a href="{{ search_clear_url }}" class="receipt-search-overlay__scrim" aria-label="Cerrar resultado"></a>
        <div
            class="receipt-search-overlay__dialog receipt-card"
            role="dialog"
            aria-modal="true"
            aria-labelledby="receipt-result-title"
        >
            <div class="receipt-search-overlay__header">
                <div class="receipt-search-overlay__heading">
                    <span class="receipt-badge {{ result.status == 'ACEPTADO' ? 'receipt-badge--success' : 'receipt-badge--danger' }}">
                        {{ result.status }}
                    </span>
                    <h2 id="receipt-result-title">
                        {{ result.type }} {{ result.series }}-{{ result.number }}
                    </h2>
                    <p>Comprobante encontrado en los registros de {{ company_name }}.</p>
                </div>
                <a href="{{ search_clear_url }}" class="receipt-search-overlay__close" aria-label="Cerrar">
                    <i class="ph ph-x" aria-hidden="true"></i>
                </a>
            </div>
            <div class="receipt-card__body">
                <dl class="receipt-meta">
                    <div class="receipt-meta__row">
                        <dt>Fecha de emisión</dt>
                        <dd>{{ result.date }}</dd>
                    </div>
                    <div class="receipt-meta__row">
                        <dt>Monto total</dt>
                        <dd>{{ result.currency_symbol }} {{ result.total|number_format(2, '.', ',') }}</dd>
                    </div>
                    {% if result.hash %}
                        <div class="receipt-meta__row">
                            <dt>Hash</dt>
                            <dd class="receipt-meta__hash">{{ result.hash }}</dd>
                        </div>
                    {% endif %}
                </dl>
                <div class="receipt-search-overlay__actions">
                    <a href="{{ result.pdf_url }}" class="receipt-btn receipt-btn--primary">
                        <i class="ph ph-eye" aria-hidden="true"></i>
                        Ver comprobante
                    </a>
                    <a href="{{ search_clear_url }}" class="receipt-btn receipt-btn--secondary">
                        Cerrar
                    </a>
                </div>
            </div>
        </div>
    </div>
    <script src="{{ asset('js/receipt-search-overlay.js') }}" defer></script>
{% endif %}
{% endblock %}