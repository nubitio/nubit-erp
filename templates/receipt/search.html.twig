<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Buscar Comprobante Electrónico</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        html, body {
            height: 100%;
            background-color: #f5f5f5;
        }
        .search-container {
            max-width: 500px;
        }
    </style>
</head>
<body>
<nav class="navbar bg-primary" data-bs-theme="dark">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center" href="{{ path('voucher_search') }}">
            <img src="{{ logo() }}" alt="Logo" width="30" class="d-inline-block align-text-top me-2">
            <span>Consulta de Comprobantes</span>
        </a>
    </div>
</nav>

<div class="container py-5">
    <div class="search-container mx-auto">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Buscar Comprobante Electrónico</h5>
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('voucher_search') }}">
                    <div class="mb-3">
                        <label for="ruc" class="form-label">RUC del Emisor</label>
                        <input type="text" class="form-control" id="ruc" name="ruc"
                               value="{{ form_data.ruc }}"
                               maxlength="11" pattern="\d{11}" required
                               placeholder="Ej: 20123456789">
                    </div>

                    <div class="mb-3">
                        <label for="voucher_type" class="form-label">Tipo de Comprobante</label>
                        <select class="form-select" id="voucher_type" name="voucher_type" required>
                            {% for code, label in voucher_types %}
                                <option value="{{ code }}" {{ form_data.voucher_type == code ? 'selected' : '' }}>
                                    {{ label }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="row">
                        <div class="col-5 mb-3">
                            <label for="series" class="form-label">Serie</label>
                            <input type="text" class="form-control text-uppercase" id="series" name="series"
                                   value="{{ form_data.series }}"
                                   maxlength="4" pattern="[A-Za-z0-9]{4}" required
                                   placeholder="Ej: F001">
                        </div>
                        <div class="col-7 mb-3">
                            <label for="number" class="form-label">Número</label>
                            <input type="text" class="form-control" id="number" name="number"
                                   value="{{ form_data.number }}"
                                   maxlength="8" pattern="\d{1,8}" required
                                   placeholder="Ej: 12345">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="date" class="form-label">Fecha de Emisión</label>
                        <input type="date" class="form-control" id="date" name="date"
                               value="{{ form_data.date }}" required>
                    </div>

                    <div class="mb-3">
                        <label for="total" class="form-label">Monto Total</label>
                        <div class="input-group">
                            <span class="input-group-text">S/</span>
                            <input type="text" class="form-control" id="total" name="total"
                                   value="{{ form_data.total }}"
                                   pattern="[0-9]+(\.[0-9]{1,2})?" required
                                   placeholder="Ej: 150.00">
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Buscar</button>
                    </div>
                </form>
            </div>
        </div>

        {% if error %}
            <div class="alert alert-warning mt-4" role="alert">
                {{ error }}
            </div>
        {% endif %}

        {% if result %}
            <div class="card mt-4 shadow-sm">
                <div class="card-header bg-success text-white">
                    Comprobante Encontrado
                </div>
                <div class="card-body">
                    <h5 class="card-title">{{ result.type }} {{ result.series }}-{{ result.number }}</h5>
                    <table class="table table-sm mb-3">
                        <tr>
                            <th>Fecha de emisión:</th>
                            <td>{{ result.date }}</td>
                        </tr>
                        <tr>
                            <th>Monto total:</th>
                            <td>S/ {{ result.total|number_format(2, '.', ',') }}</td>
                        </tr>
                        <tr>
                            <th>Estado:</th>
                            <td>
                                {% if result.status == 'VIGENTE' %}
                                    <span class="badge bg-success">{{ result.status }}</span>
                                {% else %}
                                    <span class="badge bg-danger">{{ result.status }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% if result.hash %}
                            <tr>
                                <th>Hash:</th>
                                <td><small class="text-muted">{{ result.hash }}</small></td>
                            </tr>
                        {% endif %}
                    </table>
                    <a href="{{ result.pdf_url }}" class="btn btn-outline-primary btn-sm" target="_blank">
                        Ver Comprobante
                    </a>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
        crossorigin="anonymous"></script>
</body>
</html>
