<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ type }} ELECTRONÍCA {{ series }}-{{ number }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <style>
        html, body {
            height: 100%;
        }
    </style>
</head>
<body class="d-flex flex-column h-100">
<nav class="navbar bg-light">
    <div class="container-fluid">
        <a class="navbar-brand d-flex align-items-center" href="#">
            <img src="{{ logo() }}" alt="Logo" width="30"
                 class="d-inline-block align-text-top">
            <span style="margin-left: 1rem;">{{ company_name }}</span>
        </a>
    </div>
</nav>
<div class="d-flex align-items-center justify-content-center" style="height: calc(100vh - 50px);">
    <div class="card text-center">
        <div class="card-body">
            <h3 class="card-title">{{ type }} ELECTRONÍCA {{ series }}-{{ number }}</h3>
            <h6 class="card-subtitle mt-4 text-muted">Fecha de emisión: {{ date }}</h6>
            <p class="card-text mt-4">{{ currency_symbol }} {{ total|number_format(2, '.', '') }}</p>
            <a href="{{ pdf }}" class="card-link" target="_blank">PDF</a>
            <a href="{{ xml }}" class="card-link" target="_blank">XML</a>
            <a href="{{ cdr }}" class="card-link" target="_blank">CDR</a>
        </div>
    </div>
</div>
</body>
</html>
