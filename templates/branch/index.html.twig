{% extends 'layout/base.html.twig' %}
{% block title %}Branch{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const branch = new window.app.branch('wrapper');
            branch.render();
        });
    </script>
{% endblock %}