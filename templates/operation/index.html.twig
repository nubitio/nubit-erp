{% extends 'layout/base.html.twig' %}
{% block title %}Operation{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const operation = new window.app.operation('wrapper');
            operation.render();
        });
    </script>
{% endblock %}