{% extends 'layout/base.html.twig' %}
{% block title %}Patient{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const patient = new window.app.patient('wrapper');
            patient.render();
        });
    </script>
{% endblock %}