{% extends 'layout/base.html.twig' %}
{% block title %}Company{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const company = new window.app.company('wrapper');
            company.render();
        });
    </script>
{% endblock %}