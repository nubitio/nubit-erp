{% extends 'layout/base.html.twig' %}
{% block title %}Transfer{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const transfer = new window.app.transfer('wrapper');
            transfer.render();
        });
    </script>
{% endblock %}