{% extends 'layout/base.html.twig' %}
{% block title %}UnitOfMeasure{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const unitOfMeasure = new window.app.unitOfMeasure('wrapper');
            unitOfMeasure.render();
        });
    </script>
{% endblock %}