{% extends 'layout/base.html.twig' %}
{% block title %}Consultation{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const consultation = new window.app.consultation('wrapper');
            consultation.render();
        });
    </script>
{% endblock %}