{% extends 'layout/base.html.twig' %}
{% block title %}Performance{% endblock %}
{% block body %}
    <div id="wrapper" class="wrapper"></div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        window.addEventListener('load', function () {
            const performance = new window.app.performance('wrapper');
            performance.render();
        });
    </script>
{% endblock %}