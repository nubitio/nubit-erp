###> symfony/framework-bundle ###
APP_ENV=test
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Separate test database — seeds land in demo_test, never in demo (production/dev)
DATABASE_URL="mysql://root:${MYSQL_ROOT_PASSWORD:-changeme}@database:3306/demo_test?serverVersion=10.7.1-MariaDB&charset=utf8mb4"
CONTROL_PLANE_DATABASE_URL="mysql://efact:${MYSQL_PASSWORD:-changeme}@database:3306/efact?serverVersion=10.7.1-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> redis ###
REDIS_URL=redis://redis
###< redis ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
###< symfony/messenger ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> e2e seed ###
E2E_SEED_ENABLED=1
###< e2e seed ###

###> cookie security ###
APP_COOKIE_SECURE=false
###< cookie security ###

###> telemetry (disabled for test) ###
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_SDK_DISABLED=true
###< telemetry ###
