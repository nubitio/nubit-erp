<?xml version="1.0" encoding="UTF-8"?>

<ruleset>
    <!--<rule ref="rulesets/cleancode.xml"/>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/controversial.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/naming.xml"/>-->
    <rule ref="rulesets/unusedcode.xml">
        <!-- UnusedFormalParameter generates false positives for required callback
             signatures (e.g. Process::run, event listeners, interface implementations).
             PHPStan already catches genuinely unused parameters at a stricter level. -->
        <exclude name="UnusedFormalParameter"/>
    </rule>
</ruleset>
