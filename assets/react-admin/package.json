{
  "name": "@nubit/react-admin",
  "version": "0.1.0",
  "type": "module",
  "description": "Batteries-included admin stack: core runtime, CRUD, Hydra adapter, and AdminShell.",
  "license": "MIT",
  "keywords": ["react", "admin", "crud", "hydra", "api-platform", "openapi"],
  "repository": {
    "type": "git",
    "url": "https://github.com/efact-project/efact.git"
  },
  "bugs": {
    "url": "https://github.com/efact-project/efact/issues"
  },
  "homepage": "https://github.com/efact-project/efact#readme",
  "source": "./public.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nubit/admin": "^0.1.0",
    "@nubit/hydra": "^0.1.0",
    "@nubit/core": "^0.1.0",
    "@nubit/crud": "^0.1.0",
    "@nubit/ui": "^0.1.0"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "i18next": "^23.0.0",
    "luxon": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.0.0"
  }
}
