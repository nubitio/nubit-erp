{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "strict": true,
    "jsx": "react-jsx",
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      // Nubit package facades — prefer these over direct @core/* / @app/shell imports.
      "@nubit/react-admin": ["assets/react-admin/public.ts"],
      "@nubit/crud": ["assets/crud/public.ts"],
      "@nubit/core": ["assets/core/public.ts"],
      "@nubit/ui": ["assets/ui/public.ts"],
      "@nubit/admin": ["assets/admin/public.ts"],
      "@nubit/api-platform": ["assets/api-platform/public.ts"],

      // Canonical frontend layer aliases (ADR-015)
      "@app/*": ["assets/app/*"],
      "@core/*": ["assets/core/*"],
      "@shared/*": ["assets/shared/*"],
      "@features/*": ["assets/features/*"],

      // Supporting aliases outside the canonical layer set
      "@pages/*": ["assets/pages/*"],
      "@utils/*": ["assets/utils/*"],
      "@theme/*": ["assets/theme/*"],
      "@assets/*": ["assets/*"],
      "@offline/*": ["assets/offline/*"]
    }
  },
}
