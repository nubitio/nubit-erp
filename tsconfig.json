{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "esnext",
    "strict": true,
    "jsx": "react-jsx",
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["assets/app/*"],
      "@shared/*": ["assets/shared/*"],
      "@platform/*": ["assets/core/*"],
      "@features/*": ["assets/features/*"],
      "@pages/*": ["assets/pages/*"],
      "@widgets": ["assets/components"],
      "@widgets/*": ["assets/components/*"],
      "@layouts/*": ["assets/layouts/*"],
      "@contexts/*": ["assets/contexts/*"],
      "@utils/*": ["assets/utils/*"],
      "@theme/*": ["assets/theme/*"],
      "@dto/*": ["assets/dto/*"],
      "@types/*": ["assets/types/*"],
      "@assets/*": ["assets/*"],
      "@offline/*": ["assets/offline/*"]
    }
  }
}
