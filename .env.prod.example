# Production Environment Configuration Example
# Copy this file to .env.prod and fill in your actual values

# Docker Image
DOCKER_REGISTRY=ghcr.io
DOCKER_USERNAME=your-github-username

# Application
APP_SECRET=your-app-secret-here-change-this
APP_ENV=prod
TENANTS_SOURCE=db

AUTH_TOKEN_TTL=3600
REFRESH_TOKEN_TTL=604800

# Server
SERVER_NAME=your-domain.com
HTTP_PORT=80
HTTPS_PORT=443

# Database
DATABASE_URL=mysql://user:password@host:3306/database?serverVersion=8.0
CONTROL_PLANE_DATABASE_URL=mysql://user:password@host:3306/control_plane?serverVersion=8.0

# Redis
REDIS_URL=redis://redis:6379

# Mailer
MAILER_DSN=smtp://user:pass@smtp.example.com:587

# Messenger
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages

# AWS S3 (if used)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_BUCKET=

# Billing API
BILL_API_BASE_URL=https://api.efact.app/api/v1/
BILL_API_TOKEN=your-billing-api-token

# Sentry (optional)
SENTRY_DSN=

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=efact-prod
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_PROTOCOL=http/protobuf
OTEL_ENDPOINT=http://your-otel-collector:4318
OTEL_PROPAGATORS=baggage,tracecontext
OTEL_SAMPLER=parentbased_traceidratio
OTEL_SAMPLER_ARG=0.1
