{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "spex-state": {
      "command": [
        "spex",
        "mcp",
        "serve"
      ],
      "enabled": true,
      "type": "local"
    },
    "signoz": {
      "command": "/Users/johan/bin/signoz-mcp-wrapper.sh",
      "args": [],
      "enabled": true,
      "type": "local",
      "env": {
        "SIGNOZ_URL": "https://signoz.nubit.io",
        "SIGNOZ_API_KEY": "${SIGNOZ_API_KEY}",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:1",
        "OTEL_EXPORTER_OTLP_TIMEOUT": "1"
      }
    }
  },
  "mcpServers": {
    "spex-state": {
      "args": [
        "mcp",
        "serve"
      ],
      "command": "spex"
    },
    "signoz": {
      "command": "/Users/johan/bin/signoz-mcp-wrapper.sh",
      "args": [],
      "env": {
        "SIGNOZ_URL": "https://signoz.nubit.io",
        "SIGNOZ_API_KEY": "${SIGNOZ_API_KEY}",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:1",
        "OTEL_EXPORTER_OTLP_TIMEOUT": "1"
      }
    }
  }
}
