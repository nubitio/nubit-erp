###> s3 ###
# Local dev talks to the `object-storage` docker-compose service (SeaweedFS)
# by default — no real S3 credentials or network access needed. Override in
# .env.local to point at a real S3-compatible provider (e.g. Wasabi) for
# staging/prod-like testing.
S3_ENDPOINT=http://object-storage:9000
# Optional CDN / custom-domain base URL for public asset delivery.
# When set, asset URLs are built as: {S3_PUBLIC_URL}/{path}   (bucket NOT in URL)
# When empty, asset URLs are built as: {S3_ENDPOINT}/{S3_BUCKET_NAME}/{path}
# Example: S3_PUBLIC_URL=https://assets.efact.app
# Keep this EMPTY here: .env ships in the prod image, and services that don't get S3_PUBLIC_URL from
# the environment would inherit it. The local-dev value lives in docker-compose.yml.
S3_PUBLIC_URL=
S3_BUCKET_NAME=efact-dev
S3_BUCKET_REGION=us-east-1
S3_ACCESS_KEY=devaccess
S3_ACCESS_SECRET=devaccess
# Local object storage requires path-style URLs; set to false for virtual-hosted-style providers.
S3_USE_PATH_STYLE_ENDPOINT=true
###< s3 ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> symfony/mailer ###
MAILER_DSN=smtp://noreply@example.com:SecurePassword@mail.example.com:587
MAILER_FROM=noreply@example.com
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
###< symfony/messenger ###

###> weasyprint ###
WEASYPRINT_BINARY=/usr/local/bin/weasyprint
###< weasyprint ###

###> billing api ###
BILL_API_BASE_URL=https://api.efact.app/api/v1/
BILL_API_TOKEN=
###< billing api ###

###> monitoring ###
MONITORING_EMAIL_FROM=noreply@example.com
MONITORING_EMAIL_TO=example@email.com
###< monitoring ###

###> telemetry ###
# Nubit observability provides the application instrumentation. Keep the
# contrib autoloader disabled to avoid duplicate Symfony/Doctrine scopes.
OTEL_PHP_AUTOLOAD_ENABLED=false
OTEL_PHP_DISABLED_INSTRUMENTATIONS=symfony,doctrine
OTEL_SDK_DISABLED=true
# Service name (change to your application name)
OTEL_SERVICE_NAME=efact
# Exporter configuration
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# SigNoz endpoint (adjust to your SigNoz instance)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Propagators
OTEL_PROPAGATORS=baggage,tracecontext
###< telemetry ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> app/ai ###
# Default provider is xAI (OpenAI-compatible). Leave XAI_API_KEY empty and
# set OPENAI_API_KEY + AI_MODEL_CHAT=gpt-4o-mini to fall back to OpenAI.
XAI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_CHAT=grok-4.3
###< app/ai ###

###> tenant rate limiting ###
# Requests per window per tenant (0 = disabled)
TENANT_RATE_LIMIT=300
# Window size in seconds
TENANT_RATE_WINDOW=60
###< tenant rate limiting ###

###> cookie security ###
# Set to false when running behind HTTP (e.g. local Docker dev without TLS)
APP_COOKIE_SECURE=true
###< cookie security ###

###> i18n locale override ###
# API doc locale for SmartCRUD field labels.
# Values: auto (detect from Accept-Language header), or a fixed locale e.g. es, en
APP_API_LOCALE=auto
###< i18n locale override ###


###> symfony/mercure-bundle ###
# Internal URL used by Symfony to publish to the Mercure hub (container name)
MERCURE_URL=http://mercure/.well-known/mercure
# Public URL accessible from the browser — must match the app's origin host
MERCURE_PUBLIC_URL=http://demo.localhost:8080/.well-known/mercure
# Shared JWT secret for publisher authentication (min 256 bits — change in production!)
MERCURE_JWT_SECRET="!ChangeThisMercureHubJWTSecretKey!"
###< symfony/mercure-bundle ###

###> document lookup ###
# Token for apis.net.pe DNI lookup. Get one free at https://apis.net.pe
DECOLECTA_TOKEN=
###< document lookup ###

###> nubit/admin-bundle identity module ###
# Second factor (TOTP), invitations and password recovery. OFF by default.
# Enable only AFTER `app:tenants:migrate` has created the nubit_* tables in every tenant database
# (see config/packages/nubit_admin_identity.php). Needs a cache rebuild to take effect.
IDENTITY_MODULE_ENABLED=0
###< nubit/admin-bundle identity module ###
