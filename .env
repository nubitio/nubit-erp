###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://efact:Admin.3000@database:3306/efact?serverVersion=10.7.1-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> redis ###
REDIS_URL=redis://redis
###< redis ###

EFACT_DIR=efact/
EFACT_URL="https://fe.efact.com/"

PRINTER_LINE_WIDTH=48
PRINTER_PRINT_QR=true

BIRD_ACCESS_KEY="y9OmNk9IPCXz3MPGlqRjKTErH"
BIRD_PHONE_NUMBER="+51912345678"
BIRD_WORKSPACE_ID=
BIRD_CHANNEL_ID=
BIRD_PROJECT_ID=
BIRD_VERSION_ID=

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> s3 ###
S3_ENDPOINT=https://s3.us-central-1.wasabisys.com
S3_BUCKET_NAME=dev.efact.uploads
S3_BUCKET_REGION=us-central-1
S3_ACCESS_KEY=
S3_ACCESS_SECRET=
###< s3 ###

###> sentry/sentry-symfony ###
SENTRY_DSN=
###< sentry/sentry-symfony ###

###> symfony/mailer ###
MAILER_DSN=smtp://noreply@example.com:SecurePassword@mail.example.com:587
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
###< symfony/messenger ###

###> weasyprint ###
WEASYPRINT_BINARY=/usr/local/bin/weasyprint
###< weasyprint ###

###> monitoring ###
MONITORING_EMAIL_FROM=noreply@example.com
MONITORING_EMAIL_TO=example@email.com
###< monitoring ###

###> telemetry ###
# Enable OpenTelemetry auto-instrumentation
OTEL_PHP_AUTOLOAD_ENABLED=true
# Service name (change to your application name)
OTEL_SERVICE_NAME=efact
# Exporter configuration
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# SigNoz endpoint (adjust to your SigNoz instance)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Propagators
OTEL_PROPAGATORS=baggage,tracecontext
###< telemetry ###
