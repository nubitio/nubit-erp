includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: 6   # upgraded from 5 per SLICE-SEC-001. Target: level 8 by end of Roadmap Phase 2.
    paths:
        - src/
        - tests/
    excludePaths:
        - config/reference.php
        - migrations/
        - migrations_control_plane/
    ignoreErrors:
        # ApiPlatform ProcessorInterface requires generic types T1,T2 — safe to suppress at this level
        - { message: '#ProcessorInterface but does not specify its types#', path: src/Inventory/State/StockEntryProcessor.php }
        # PHPDoc-driven instanceof check — mixed $data is narrowed to StockEntry by ApiPlatform routing
        - { message: '#Instanceof between.*StockEntry.*will always evaluate to true#', path: src/Inventory/State/StockEntryProcessor.php }
        # Same pattern for Purchase void processor
        - { message: '#Instanceof between.*Purchase.*will always evaluate to true#', path: src/Purchasing/State/PurchaseVoidProcessor.php }
