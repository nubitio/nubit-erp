includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: 6   # upgraded from 5 per SLICE-SEC-001. Target: level 8 by end of Roadmap Phase 2.
    paths:
        - src/
        - tests/
    excludePaths:
        - config/reference.php
        - migrations/
        - migrations_control_plane/
    ignoreErrors:
        # PHPMD @SuppressWarnings annotations are valid PHPMD syntax but PHPStan
        # cannot parse the dot-separated rule name inside the parentheses.
        - message: '#PHPDoc tag @SuppressWarnings has invalid value#'
          path: src/AI/State/*
