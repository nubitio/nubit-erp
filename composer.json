{
  "name": "johangm90/efact",
  "type": "project",
  "description": "Efact App",
  "license": "proprietary",
  "authors": [
    {
      "name": "Johan Guerreros",
      "email": "johangm90@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-gd": "*",
    "ext-iconv": "*",
    "ext-imagick": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-soap": "*",
    "ext-zip": "*",
    "api-platform/core": "^4.1",
    "api-platform/mcp": "*",
    "aws/aws-sdk-php": "^3.279",
    "brick/math": "^0.12",
    "chillerlan/php-qrcode": "^5.0",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.5",
    "dragonmantank/cron-expression": "^3.3",
    "firebase/php-jwt": "^7.0",
    "greenter/consulta-cpe": "^1.1",
    "greenter/core": "^v5.2.0",
    "league/flysystem-aws-s3-v3": "^3.15",
    "mike42/escpos-php": "^4.0",
    "nelmio/cors-bundle": "^2.3",
    "nubitio/admin-bundle": "^0.13",
    "nubitio/api-platform": "^0.13",
    "nubitio/platform": "^0.13",
    "oneup/flysystem-bundle": "^4.9",
    "open-telemetry/exporter-otlp": "^1.3",
    "open-telemetry/opentelemetry-auto-doctrine": "^0.3.1",
    "open-telemetry/opentelemetry-auto-symfony": "^1.1",
    "open-telemetry/opentelemetry-logger-monolog": "^1.1",
    "open-telemetry/sdk": "^1.9",
    "pentatrion/vite-bundle": "^8.2",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpoffice/phpspreadsheet": "^5.7",
    "pontedilana/php-weasyprint": "^2.2",
    "runtime/frankenphp-symfony": "^0.2.0",
    "symfony/ai-agent": "^0.6",
    "symfony/ai-bundle": "^0.6",
    "symfony/ai-open-ai-platform": "^0.6",
    "symfony/asset": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/doctrine-messenger": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/error-handler": "7.4.*",
    "symfony/expression-language": "7.4.*",
    "symfony/flex": "^2.3",
    "symfony/framework-bundle": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/lock": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/mcp-bundle": "^0.6",
    "symfony/mercure-bundle": "^0.4.2",
    "symfony/messenger": "7.4.*",
    "symfony/mime": "7.4.*",
    "symfony/monolog-bundle": "^4.0",
    "symfony/notifier": "7.4.*",
    "symfony/object-mapper": "7.4.*",
    "symfony/property-access": "7.4.*",
    "symfony/property-info": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/redis-messenger": "7.4.*",
    "symfony/runtime": "7.4.*",
    "symfony/scheduler": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/serializer": "7.4.*",
    "symfony/translation": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/uid": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/yaml": "7.4.*"
  },
  "require-dev": {
    "dama/doctrine-test-bundle": "^8.6",
    "pestphp/pest": "^4.7",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpunit/phpunit": "^12.0",
    "rector/rector": "^2.2",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*",
    "symfony/debug-bundle": "7.4.*",
    "symfony/maker-bundle": "^1.65",
    "symfony/phpunit-bridge": "^7.0",
    "symfony/stopwatch": "7.4.*",
    "symfony/var-dumper": "7.4.*",
    "symfony/web-profiler-bundle": "7.4.*"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "phpro/grumphp": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "tbachert/spi": true,
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "check:platform-boundary": "php scripts/architecture/check-platform-boundary.php",
    "test:platform-boundary-guard": "php scripts/architecture/check-platform-boundary.php --self-test",
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "7.4.*"
    }
  }
}
