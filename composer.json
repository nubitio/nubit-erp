{
  "name": "johangm90/efact",
  "description": "",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Johan Guerreros",
      "email": "johangm90@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-soap": "*",
    "ext-zip": "*",
    "api-platform/core": "^3.0",
    "aws/aws-sdk-php": "^3.258",
    "chillerlan/php-qrcode": "^4.3",
    "crunzphp/crunz": "^3.4",
    "doctrine/annotations": "^2.0.1",
    "doctrine/doctrine-bundle": "^2.7",
    "doctrine/doctrine-migrations-bundle": "^3.2",
    "doctrine/orm": "^2.15.1",
    "firebase/php-jwt": "^6.4",
    "greenter/consulta-cpe": "^1.1",
    "greenter/core": "^5.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "messagebird/php-rest-api": "^3.0",
    "mike42/escpos-php": "^4.0",
    "mikehaertl/phpwkhtmltopdf": "^2.5",
    "monolog/monolog": "^3.2",
    "nelmio/cors-bundle": "^2.2",
    "oneup/flysystem-bundle": "^4.6",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpoffice/phpspreadsheet": "^1.16",
    "phpstan/phpdoc-parser": "^1.15",
    "predis/predis": "^2.1",
    "sentry/sentry-symfony": "^4.9",
    "symfony/asset": "7.0.*",
    "symfony/cache": "7.0.*",
    "symfony/config": "7.0.*",
    "symfony/console": "7.0.*",
    "symfony/debug-bundle": "7.0.*",
    "symfony/dependency-injection": "7.0.*",
    "symfony/dotenv": "7.0.*",
    "symfony/error-handler": "7.0.*",
    "symfony/event-dispatcher": "7.0.*",
    "symfony/expression-language": "7.0.*",
    "symfony/flex": "^2.2",
    "symfony/framework-bundle": "7.0.*",
    "symfony/http-foundation": "7.0.*",
    "symfony/http-kernel": "7.0.*",
    "symfony/mailer": "7.0.*",
    "symfony/monolog-bundle": "^3.8",
    "symfony/property-access": "7.0.*",
    "symfony/property-info": "7.0.*",
    "symfony/routing": "7.0.*",
    "symfony/runtime": "7.0.*",
    "symfony/security-bundle": "7.0.*",
    "symfony/serializer": "7.0.*",
    "symfony/stopwatch": "7.0.*",
    "symfony/string": "7.0.*",
    "symfony/twig-bridge": "7.0.*",
    "symfony/twig-bundle": "7.0.*",
    "symfony/uid": "7.0.*",
    "symfony/validator": "7.0.*",
    "symfony/web-profiler-bundle": "7.0.*",
    "symfony/webpack-encore-bundle": "^2.1",
    "twig/extra-bundle": "^3.4",
    "twig/intl-extra": "^3.4",
    "twig/twig": "^3.3"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^3.6",
    "friendsofphp/php-cs-fixer": "^3.14",
    "phpstan/phpstan": "^1.9",
    "phpunit/phpunit": "^9.5",
    "rector/rector": "^0.15.1",
    "symfony/browser-kit": "7.0.*",
    "symfony/css-selector": "7.0.*",
    "symfony/maker-bundle": "^1.48",
    "symfony/phpunit-bridge": "7.0.*",
    "symfony/var-dumper": "7.0.*"
  },
  "config": {
    "allow-plugins": {
      "composer/package-versions-deprecated": true,
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "hook-installer": [
      "php -r \"file_exists('.git') && copy('pre-commit.sh', '.git/hooks/pre-commit');\"",
      "chmod +x .git/hooks/pre-commit"
    ],
    "post-install-cmd": [
      "@auto-scripts",
      "@hook-installer"
    ],
    "post-update-cmd": [
      "@auto-scripts",
      "@hook-installer"
    ],
    "inspect": [
      "vendor/bin/phpstan analyse --memory-limit=2G --no-progress"
    ],
    "format": [
      "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.0.*"
    }
  }
}
