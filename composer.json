{
  "name": "johangm90/efact",
  "authors": [
    {
      "name": "Johan Guerreros",
      "email": "johangm90@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-soap": "*",
    "ext-zip": "*",
    "api-platform/core": "^3.1",
    "aws/aws-sdk-php": "^3.279",
    "chillerlan/php-qrcode": "^5.0",
    "doctrine/annotations": "^2.0",
    "doctrine/doctrine-bundle": "^2.11",
    "doctrine/doctrine-migrations-bundle": "^3.2",
    "doctrine/orm": "^2.15",
    "dragonmantank/cron-expression": "^3.3",
    "firebase/php-jwt": "^6.8",
    "greenter/consulta-cpe": "^1.1",
    "greenter/core": "^5.0",
    "league/flysystem-aws-s3-v3": "^3.15",
    "messagebird/php-rest-api": "^3.1",
    "mike42/escpos-php": "^4.0",
    "nelmio/cors-bundle": "^2.3",
    "oneup/flysystem-bundle": "^4.9",
    "phpdocumentor/reflection-docblock": "^5.3",
    "phpoffice/phpspreadsheet": "^1.18",
    "phpoffice/phpword": "^1.1",
    "pontedilana/php-weasyprint": "^1.4",
    "sentry/sentry-symfony": "^5.0",
    "symfony/asset": "7.2.*",
    "symfony/console": "7.2.*",
    "symfony/dotenv": "7.2.*",
    "symfony/error-handler": "7.2.*",
    "symfony/expression-language": "7.2.*",
    "symfony/flex": "^2.3",
    "symfony/framework-bundle": "7.2.*",
    "symfony/http-client": "7.2.*",
    "symfony/lock": "7.2.*",
    "symfony/mailer": "7.2.*",
    "symfony/messenger": "7.2.*",
    "symfony/mime": "7.2.*",
    "symfony/monolog-bundle": "^3.10",
    "symfony/notifier": "7.2.*",
    "symfony/property-access": "7.2.*",
    "symfony/property-info": "7.2.*",
    "symfony/runtime": "7.2.*",
    "symfony/scheduler": "7.2.*",
    "symfony/security-bundle": "7.2.*",
    "symfony/serializer": "7.2.*",
    "symfony/twig-bundle": "7.2.*",
    "symfony/uid": "7.2.*",
    "symfony/validator": "7.2.*",
    "symfony/webpack-encore-bundle": "^2.0",
    "symfony/yaml": "7.2.*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.57",
    "phpmd/phpmd": "^2.15",
    "phpro/grumphp": "^2.10",
    "phpstan/phpstan": "^1.11",
    "phpunit/phpunit": "^9",
    "squizlabs/php_codesniffer": "^3.10",
    "symfony/browser-kit": "7.2.*",
    "symfony/css-selector": "7.2.*",
    "symfony/debug-bundle": "7.2.*",
    "symfony/maker-bundle": "^1.59",
    "symfony/phpunit-bridge": "^7.0",
    "symfony/stopwatch": "7.2.*",
    "symfony/var-dumper": "7.2.*",
    "symfony/web-profiler-bundle": "7.2.*"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "symfony/flex": true,
      "symfony/runtime": true,
      "phpro/grumphp": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    },
    "install-pre-commit-hook": [
      "php -r \"file_exists('.git') && copy('pre-commit.sh', '.git/hooks/pre-commit');\"",
      "chmod +x .git/hooks/pre-commit"
    ],
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ]
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": true,
      "require": "7.2.*"
    }
  }
}
