{
  "type": "module",
  "name": "efact",
  "version": "1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@rollup/rollup-linux-arm64-gnu": "4.61.1",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.0",
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-usb": "^1.0.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-symfony": "^8.2.3",
    "vitest": "^4.1.7"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn build:themes && vite build",
    "build:themes": "node scripts/copy-themes.mjs",
    "generate:api-types": "openapi-typescript http://localhost/api/docs.json -o assets/api/types.generated.ts",
    "postinstall": "yarn build:themes",
    "test": "vitest run --coverage --coverage.reportsDirectory=var/coverage/frontend",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:control-plane": "playwright test e2e/control-plane-visual.spec.ts",
    "test:e2e:control-plane:update": "playwright test e2e/control-plane-visual.spec.ts --update-snapshots",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@nubitio/admin": "link:../../nubit-react/packages/admin",
    "@nubitio/core": "link:../../nubit-react/packages/core",
    "@nubitio/crud": "link:../../nubit-react/packages/crud",
    "@nubitio/hydra": "link:../../nubit-react/packages/hydra",
    "@nubitio/react-admin": "link:../../nubit-react/packages/react-admin",
    "@nubitio/ui": "link:../../nubit-react/packages/ui",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query": "^5.0.0",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-react": "^4.5.2",
    "dexie": "^4.3.0",
    "dompurify": "^3.0.0",
    "html-react-parser": "^5.2.17",
    "i18next": "^23.0.0",
    "luxon": "^3",
    "marked": "^17.0.4",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.1"
  },
  "packageManager": "yarn@4.9.1",
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
