    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-usb": "^1.0.14",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "ts-loader": "^9.5.4",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-symfony": "^8.2.3",
    "vitest": "^4.1.7"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn build:themes && vite build",
    "build:packages": "tsdown",
    "build:themes": "sass assets/theme/styles/theme-dark.scss public/themes/app-theme-dark.css --no-source-map && sass assets/theme/styles/theme-light.scss public/themes/app-theme-light.css --no-source-map",
    "generate:api-types": "openapi-typescript http://localhost/api/docs.json -o assets/api/types.generated.ts",
    "postinstall": "yarn build:themes",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/syne": "^5.2.7",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@tanstack/react-query": "^5.0.0",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-react": "^4.5.2",
    "dexie": "^4.3.0",
    "dompurify": "^3.0.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html-react-parser": "^5.2.17",
    "i18next": "^23.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "luxon": "^3",
    "marked": "^17.0.4",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.1",
    "unified": "^11.0.5"
  },
  "packageManager": "yarn@4.9.1",
  "overrides": {
    "serialize-javascript": ">=7.0.3"
  }
}
