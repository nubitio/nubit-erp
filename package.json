{
  "type": "module",
  "name": "efact",
  "version": "1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/file-saver": "^2.0.7",
    "@types/jsdom": "^28",
    "@types/luxon": "^3.7.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.7",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-symfony": "^8.2.3",
    "vitest": "^4.0.18"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn build:themes && vite build",
    "build:themes": "sass --load-path=node_modules assets/theme/styles/theme-dark.scss public/themes/app-theme-dark.css --no-source-map && sass --load-path=node_modules assets/theme/styles/theme-light.scss public/themes/app-theme-light.css --no-source-map",
    "postinstall": "yarn build:themes",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/ubuntu": "^5.2.8",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^13.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-react": "^4.5.2",
    "axios": "^1.8.2",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.19",
    "devextreme": "25.1.3",
    "devextreme-dist": "25.1.3",
    "devextreme-react": "25.1.3",
    "dexie": "^4.3.0",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "html-react-parser": "^5.2.17",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "marked": "^17.0.4",
    "openai": "^6.27.0",
    "postcss": "^8.5.8",
    "postcss-loader": "^8.2.1",
    "qz-tray": "^2.2.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "rehype-minify-whitespace": "^6.0.2",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.2.1",
    "unified": "^11.0.5",
    "web-vitals": "^5.1.0"
  },
  "packageManager": "yarn@4.9.1"
}
