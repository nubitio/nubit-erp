{
  "type": "module",
  "name": "efact",
  "version": "1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@rollup/rollup-linux-arm64-gnu": "4.61.1",
    "@symfony/reprise": "^1.3.0",
    "@tanstack/react-query-devtools": "^5.108.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/luxon": "^3.7.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-usb": "^1.0.14",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "jsqr": "1.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn build:themes && vite build",
    "build:themes": "node scripts/copy-themes.mjs",
    "generate:api-types": "openapi-typescript docs/api/public-v1.yaml -o assets/api/public-v1.types.generated.ts",
    "check:api-contract": "php scripts/api/check-public-contract.php",
    "postinstall": "yarn build:themes && sh scripts/setup-git-hooks.sh",
    "test": "vitest run --coverage --coverage.reportsDirectory=var/coverage/frontend",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:control-plane": "playwright test e2e/control-plane-visual.spec.ts",
    "test:e2e:control-plane:update": "playwright test e2e/control-plane-visual.spec.ts --update-snapshots",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prepare": "sh scripts/setup-git-hooks.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@nubitio/admin": "2.6.2",
    "@nubitio/core": "2.6.2",
    "@nubitio/crud": "2.6.2",
    "@nubitio/hydra": "2.6.2",
    "@nubitio/react-admin": "2.6.2",
    "@nubitio/ui": "2.6.2",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.108.0",
    "@tiptap/extension-link": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-react": "^6.3.0",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.18",
    "html-react-parser": "^6.1.10",
    "i18next": "^27.2.2",
    "luxon": "^3.7.2",
    "marked": "^18.2.1",
    "postcss": "^8.5.33",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "recharts": "^3.11.0",
    "tailwindcss": "^4.3.5"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "resolutions": {
    "serialize-javascript": ">=7.0.3",
    "postcss": "^8.5.26",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "tar": "^7.5.22",
    "undici": "^6.28.0",
    "brace-expansion@^1.1.7": "^1.1.18",
    "brace-expansion@^2.0.1": "^2.1.4",
    "brace-expansion@^5.0.5": "^5.0.9",
    "minimatch@^10.1.1": "^11.0.1",
    "glob@^11.0.1": "^14.0.6"
  }
}
