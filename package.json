    "vite": "^6.0",
    "vite-plugin-symfony": "^8.2"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn build:themes && vite build",
    "build:themes": "sass --load-path=node_modules assets/theme/styles/theme-dark.scss public/themes/app-theme-dark.css --no-source-map && sass --load-path=node_modules assets/theme/styles/theme-light.scss public/themes/app-theme-light.css --no-source-map",
    "postinstall": "yarn build:themes",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\""
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.1",
    "@tailwindcss/postcss": "^4.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.1",
    "@types/node": "^16.11.36",
    "@types/react-router-dom": "^5.1.5",
    "@vitejs/plugin-react": "^4.5.2",
    "axios": "^1.8.2",
    "classnames": "^2.3.1",
    "dayjs": "^1.11.7",
    "devextreme": "25.1.3",
    "devextreme-dist": "25.1.3",
    "devextreme-react": "25.1.3",
    "exceljs": "^4.3.0",
    "file-saver": "^2.0.5",
    "html-react-parser": "^5.2.6",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^3.5.25",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.474.0",
    "luxon": "^3.3.0",
    "marked": "^16.1.2",
    "openai": "^5.12.0",
    "postcss": "^8.5.1",
    "postcss-loader": "^8.1.1",
    "qz-tray": "^2.2.2",
    "react": "^18.2.0",
