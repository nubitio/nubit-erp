{
  "type": "module",
  "name": "efact",
  "version": "1.0.0",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@rollup/rollup-linux-arm64-gnu": "4.61.1",
    "@symfony/reprise": "^1.3.0",
    "@tanstack/react-query-devtools": "^5.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/w3c-web-usb": "^1.0.14",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fflate": "^0.8.2",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.9.5",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.1.10"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "yarn build:themes && vite build",
    "build:themes": "node scripts/copy-themes.mjs",
    "generate:api-types": "openapi-typescript docs/api/public-v1.yaml -o assets/api/public-v1.types.generated.ts",
    "check:api-contract": "php scripts/api/check-public-contract.php",
    "postinstall": "yarn build:themes && sh scripts/setup-git-hooks.sh",
    "test": "vitest run --coverage --coverage.reportsDirectory=var/coverage/frontend",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:control-plane": "playwright test e2e/control-plane-visual.spec.ts",
    "test:e2e:control-plane:update": "playwright test e2e/control-plane-visual.spec.ts --update-snapshots",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prepare": "sh scripts/setup-git-hooks.sh"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lexend": "^5",
    "@fontsource/syne": "^5.2.7",
    "@nubitio/admin": "1.3.1",
    "@nubitio/core": "1.3.1",
    "@nubitio/crud": "1.3.1",
    "@nubitio/hydra": "1.3.1",
    "@nubitio/react-admin": "1.3.1",
    "@nubitio/ui": "1.3.1",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.0.0",
    "@tiptap/extension-link": "^3.27.3",
    "@tiptap/react": "^3.27.3",
    "@tiptap/starter-kit": "^3.27.3",
    "@types/node": "^22.19.15",
    "@vitejs/plugin-react": "^5.0.0",
    "dexie": "^4.3.0",
    "dompurify": "^3.4.13",
    "html-react-parser": "^5.2.17",
    "i18next": "^23.0.0",
    "luxon": "^3",
    "marked": "^17.0.4",
    "postcss": "^8.5.26",
    "react": "^19.2.4",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.2"
  },
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "resolutions": {
    "serialize-javascript": ">=7.0.3",
    "postcss": "^8.5.26",
    "fast-uri": "^3.1.5",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "tar": "^7.5.22",
    "undici": "^6.28.0",
    "brace-expansion@^1.1.7": "^1.1.18",
    "brace-expansion@^2.0.1": "^2.1.4",
    "brace-expansion@^5.0.5": "^5.0.9"
  }
}
